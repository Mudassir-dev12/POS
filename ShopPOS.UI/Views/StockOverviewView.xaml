<UserControl x:Class="ShopPOS.UI.Views.StockOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.Inventory"
             xmlns:enums="clr-namespace:ShopPOS.Core.Enums;assembly=ShopPOS.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:StockOverviewViewModel}"
             Background="#F1F5F9"
             FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
             Loaded="UserControl_Loaded">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding LoadDataCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header & KPI Cards -->
            <RowDefinition Height="Auto" />
            <!-- Filters -->
            <RowDefinition Height="Auto" />
            <!-- DataGrid -->
            <RowDefinition Height="*" />
            <!-- Footer Paging -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header & KPI Cards -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title & Top Actions -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Inventory Stock Overview" FontSize="22" FontWeight="Bold" Foreground="#0F172A" />
                    <TextBlock Text="Real-time physical stock levels, thresholds, and catalog valuations calculated from the ledger." FontSize="13" Foreground="#64748B" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Export CSV" Command="{Binding ExportCsvCommand}"
                            Background="#0F172A" Foreground="White" FontWeight="SemiBold" Padding="12,8" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand" />
                    <Button Content="Export PDF" Command="{Binding ExportPdfCommand}"
                            Background="#0F172A" Foreground="White" FontWeight="SemiBold" Padding="12,8" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand" />
                    <Button Content="Refresh (F5)" Command="{Binding LoadDataCommand}"
                            Background="#E2E8F0" Foreground="#0F172A" FontWeight="SemiBold" Padding="12,8" BorderThickness="0" Cursor="Hand" />
                </StackPanel>
            </Grid>

            <!-- KPI Cards -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Total Units -->
                <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Total Units" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" />
                        <TextBlock Text="{Binding Summary.TotalUnits, StringFormat='{}{0:N2}'}" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Low Stock -->
                <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Low Stock Items" FontSize="11" FontWeight="SemiBold" Foreground="#D97706" />
                        <TextBlock Text="{Binding Summary.LowStockCount}" FontSize="18" FontWeight="Bold" Foreground="#D97706" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Out of Stock -->
                <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Out of Stock" FontSize="11" FontWeight="SemiBold" Foreground="#DC2626" />
                        <TextBlock Text="{Binding Summary.OutOfStockCount}" FontSize="18" FontWeight="Bold" Foreground="#DC2626" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Value at Cost (hidden for Cashier) -->
                <Border Grid.Column="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0"
                        Visibility="{Binding IsCashier, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Value at Cost" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB" />
                        <TextBlock Text="{Binding Summary.TotalValueAtCost, StringFormat='${0:N2}'}" FontSize="18" FontWeight="Bold" Foreground="#2563EB" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Value at Retail -->
                <Border Grid.Column="4" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Value at Retail" FontSize="11" FontWeight="SemiBold" Foreground="#16A34A" />
                        <TextBlock Text="{Binding Summary.TotalValueAtSale, StringFormat='${0:N2}'}" FontSize="18" FontWeight="Bold" Foreground="#16A34A" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Filters -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,8">
                    <TextBlock Text="Search (Name / SKU / Barcode)" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                    <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" Padding="6,4">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>

                <!-- Category -->
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,8">
                    <TextBlock Text="Category" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Categories}"
                              SelectedValue="{Binding SelectedCategoryId}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Name"
                              Padding="6,4" />
                </StackPanel>

                <!-- Brand -->
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,10,8">
                    <TextBlock Text="Brand" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Brands}"
                              SelectedValue="{Binding SelectedBrandId}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Name"
                              Padding="6,4" />
                </StackPanel>

                <!-- Status -->
                <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,10,8">
                    <TextBlock Text="Stock Status" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                    <ComboBox SelectedItem="{Binding SelectedStatus}" Padding="6,4">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource StockStatusDisplayConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        <x:Null />
                        <enums:StockStatus>OK</enums:StockStatus>
                        <enums:StockStatus>Low</enums:StockStatus>
                        <enums:StockStatus>OutOfStock</enums:StockStatus>
                        <enums:StockStatus>Negative</enums:StockStatus>
                        <enums:StockStatus>NotTracked</enums:StockStatus>
                    </ComboBox>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                    <Button Content="Filter" Command="{Binding SearchCommand}"
                            Background="#0F172A" Foreground="White" FontWeight="SemiBold" Padding="14,6" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand" />
                    <Button Content="Clear" Command="{Binding ClearFilterCommand}"
                            Background="#E2E8F0" Foreground="#475569" FontWeight="SemiBold" Padding="12,6" BorderThickness="0" Cursor="Hand" />
                </StackPanel>

                <!-- Quick Checkbox Toggles -->
                <StackPanel Grid.Row="1" Grid.ColumnSpan="5" Orientation="Horizontal" Margin="0,4,0,0">
                    <CheckBox Content="Show Low or Out of Stock Only" IsChecked="{Binding LowOrOutOnly}" Margin="0,0,20,0" FontWeight="SemiBold" />
                    <CheckBox Content="Include Non-Tracked Products" IsChecked="{Binding IncludeNonTracked}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="1">
            <DataGrid ItemsSource="{Binding Items}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F1F5F9"
                      RowHeight="36"
                      BorderThickness="0"
                      Background="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="90" FontWeight="SemiBold" IsReadOnly="True" />
                    <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*" FontWeight="Bold" IsReadOnly="True" />
                    <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="120" IsReadOnly="True" />
                    <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="130" IsReadOnly="True" />
                    <DataGridTextColumn Header="Unit" Binding="{Binding UnitName}" Width="70" IsReadOnly="True" />

                    <!-- Current Stock -->
                    <DataGridTextColumn Header="Current Stock" Binding="{Binding CurrentStock, StringFormat='{}{0:N2}'}" Width="110" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Padding" Value="0,0,10,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Alert Level -->
                    <DataGridTextColumn Header="Alert Level" Binding="{Binding ReorderLevel, StringFormat='{}{0:N0}'}" Width="90" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Padding" Value="0,0,10,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Status -->
                    <DataGridTemplateColumn Header="Status" Width="105">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="3" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:StockStatus.OK}">
                                                    <Setter Property="Background" Value="#DCFCE7" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:StockStatus.Low}">
                                                    <Setter Property="Background" Value="#FEF3C7" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:StockStatus.OutOfStock}">
                                                    <Setter Property="Background" Value="#FEE2E2" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:StockStatus.Negative}">
                                                    <Setter Property="Background" Value="#F3E8FF" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:StockStatus.NotTracked}">
                                                    <Setter Property="Background" Value="#F1F5F9" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontWeight="Bold" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:StockStatus.OK}">
                                                        <Setter Property="Foreground" Value="#15803D" />
                                                        <Setter Property="Text" Value="OK" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:StockStatus.Low}">
                                                        <Setter Property="Foreground" Value="#B45309" />
                                                        <Setter Property="Text" Value="Low stock" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:StockStatus.OutOfStock}">
                                                        <Setter Property="Foreground" Value="#B91C1C" />
                                                        <Setter Property="Text" Value="Out of stock" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:StockStatus.Negative}">
                                                        <Setter Property="Foreground" Value="#7E22CE" />
                                                        <Setter Property="Text" Value="Negative" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:StockStatus.NotTracked}">
                                                        <Setter Property="Foreground" Value="#64748B" />
                                                        <Setter Property="Text" Value="Not tracked" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Cost Price (hidden for Cashier) -->
                    <DataGridTextColumn x:Name="CostPriceColumn" Header="Cost Price" Binding="{Binding CostPrice, StringFormat='${0:N2}'}" Width="95" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Padding" Value="0,0,10,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Sale Price -->
                    <DataGridTextColumn Header="Sale Price" Binding="{Binding SalePrice, StringFormat='${0:N2}'}" Width="95" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Padding" Value="0,0,10,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Total Value at Cost -->
                    <DataGridTextColumn x:Name="ValueAtCostColumn" Header="Value at Cost" Binding="{Binding StockValueAtCost, StringFormat='${0:N2}'}" Width="105" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Padding" Value="0,0,10,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Total Value at Retail -->
                    <DataGridTextColumn Header="Value at Retail" Binding="{Binding StockValueAtSale, StringFormat='${0:N2}'}" Width="110" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Padding" Value="0,0,10,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer Paging -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding RowCountText}" Foreground="#64748B" FontWeight="SemiBold" VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="&lt; Prev" Command="{Binding PreviousPageCommand}"
                        Background="#E2E8F0" Foreground="#0F172A" FontWeight="SemiBold" Padding="12,6" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand" />
                <TextBlock VerticalAlignment="Center" Margin="0,0,8,0">
                    <Run Text="Page " Foreground="#64748B" />
                    <Run Text="{Binding CurrentPage}" FontWeight="Bold" Foreground="#0F172A" />
                    <Run Text=" of " Foreground="#64748B" />
                    <Run Text="{Binding TotalPages}" FontWeight="Bold" Foreground="#0F172A" />
                </TextBlock>
                <Button Content="Next &gt;" Command="{Binding NextPageCommand}"
                        Background="#E2E8F0" Foreground="#0F172A" FontWeight="SemiBold" Padding="12,6" BorderThickness="0" Cursor="Hand" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

