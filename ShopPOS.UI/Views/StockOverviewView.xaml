<UserControl x:Class="ShopPOS.UI.Views.StockOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.Inventory"
             xmlns:enums="clr-namespace:ShopPOS.Core.Enums;assembly=ShopPOS.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:StockOverviewViewModel}"
             Background="{DynamicResource PageBackgroundBrush}"
             FontFamily="{StaticResource AppFontFamily}"
             Loaded="UserControl_Loaded">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding LoadDataCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header & KPI Cards -->
            <RowDefinition Height="Auto" />
            <!-- Filters -->
            <RowDefinition Height="Auto" />
            <!-- DataGrid -->
            <RowDefinition Height="*" />
            <!-- Footer Paging -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header & KPI Cards -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title & Top Actions -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Inventory Stock Overview" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Real-time physical stock levels, thresholds, and catalog valuations calculated from the ledger." Style="{StaticResource SubTitleStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Export CSV" Command="{Binding ExportCsvCommand}"
                            Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,8,0" />
                    <Button Content="Export PDF" Command="{Binding ExportPdfCommand}"
                            Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,8,0" />
                    <Button Content="Refresh (F5)" Command="{Binding LoadDataCommand}"
                            Style="{StaticResource ToolbarButtonStyle}" />
                </StackPanel>
            </Grid>

            <!-- KPI Cards -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Total Units -->
                <Border Grid.Column="0" Style="{StaticResource SurfaceCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Total Units" Style="{StaticResource KpiLabelStyle}" />
                        <TextBlock Text="{Binding Summary.TotalUnits, StringFormat='{}{0:N2}'}" Style="{StaticResource KpiValueStyle}" />
                    </StackPanel>
                </Border>

                <!-- Low Stock -->
                <Border Grid.Column="1" Style="{StaticResource SurfaceCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Low Stock Items" Style="{StaticResource KpiLabelStyle}" Foreground="{DynamicResource WarningTextBrush}" />
                        <TextBlock Text="{Binding Summary.LowStockCount}" Style="{StaticResource KpiValueStyle}" Foreground="{DynamicResource WarningTextBrush}" />
                    </StackPanel>
                </Border>

                <!-- Out of Stock -->
                <Border Grid.Column="2" Style="{StaticResource SurfaceCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Out of Stock" Style="{StaticResource KpiLabelStyle}" Foreground="{DynamicResource DangerBrush}" />
                        <TextBlock Text="{Binding Summary.OutOfStockCount}" Style="{StaticResource KpiValueStyle}" Foreground="{DynamicResource DangerBrush}" />
                    </StackPanel>
                </Border>

                <!-- Value at Cost (hidden for Cashier) -->
                <Border Grid.Column="3" Style="{StaticResource SurfaceCardStyle}" Margin="0,0,8,0"
                        Visibility="{Binding IsCashier, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Value at Cost" Style="{StaticResource KpiLabelStyle}" />
                        <TextBlock Text="{Binding Summary.TotalValueAtCost, Converter={StaticResource MoneyConverter}}" Style="{StaticResource KpiValueStyle}" />
                    </StackPanel>
                </Border>

                <!-- Value at Retail -->
                <Border Grid.Column="4" Style="{StaticResource SurfaceCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Value at Retail" Style="{StaticResource KpiLabelStyle}" Foreground="{DynamicResource SuccessTextBrush}" />
                        <TextBlock Text="{Binding Summary.TotalValueAtSale, Converter={StaticResource MoneyConverter}}" Style="{StaticResource KpiValueStyle}" Foreground="{DynamicResource SuccessTextBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Filters -->
        <Border Grid.Row="1" Style="{StaticResource FilterBarStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,8">
                    <TextBlock Text="Search (Name / SKU / Barcode)" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>

                <!-- Category -->
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,8">
                    <TextBlock Text="Category" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Categories}"
                              SelectedValue="{Binding SelectedCategoryId}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Name"
                              Style="{StaticResource InputComboBoxStyle}" />
                </StackPanel>

                <!-- Brand -->
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,10,8">
                    <TextBlock Text="Brand" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Brands}"
                              SelectedValue="{Binding SelectedBrandId}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Name"
                              Style="{StaticResource InputComboBoxStyle}" />
                </StackPanel>

                <!-- Status -->
                <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,10,8">
                    <TextBlock Text="Stock Status" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                    <ComboBox SelectedItem="{Binding SelectedStatus}" Style="{StaticResource InputComboBoxStyle}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource StockStatusDisplayConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        <x:Null />
                        <enums:StockStatus>OK</enums:StockStatus>
                        <enums:StockStatus>Low</enums:StockStatus>
                        <enums:StockStatus>OutOfStock</enums:StockStatus>
                        <enums:StockStatus>Negative</enums:StockStatus>
                        <enums:StockStatus>NotTracked</enums:StockStatus>
                    </ComboBox>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                    <Button Content="Filter" Command="{Binding SearchCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,0" />
                    <Button Content="Clear" Command="{Binding ClearFilterCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>

                <!-- Quick Checkbox Toggles -->
                <StackPanel Grid.Row="1" Grid.ColumnSpan="5" Orientation="Horizontal" Margin="0,4,0,0">
                    <CheckBox Content="Show Low or Out of Stock Only" IsChecked="{Binding LowOrOutOnly}" Margin="0,0,20,0" FontWeight="SemiBold" />
                    <CheckBox Content="Include Non-Tracked Products" IsChecked="{Binding IncludeNonTracked}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource TableContainerBorderStyle}">
            <DataGrid ItemsSource="{Binding Items}"
                      Style="{StaticResource AppDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="100"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*" FontWeight="SemiBold" IsReadOnly="True" />
                    <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="120"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="130" IsReadOnly="True" />
                    <DataGridTextColumn Header="Unit" Binding="{Binding UnitName}" Width="70" IsReadOnly="True" />

                    <!-- Current Stock -->
                    <DataGridTextColumn Header="Current Stock" Binding="{Binding CurrentStock, StringFormat='{}{0:N2}'}" Width="110"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" IsReadOnly="True" />

                    <!-- Alert Level -->
                    <DataGridTextColumn Header="Alert Level" Binding="{Binding ReorderLevel, StringFormat='{}{0:N0}'}" Width="90"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" IsReadOnly="True" />

                    <!-- Status -->
                    <DataGridTemplateColumn Header="Status" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="3" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:StockStatus.OK}">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:StockStatus.Low}">
                                                    <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:StockStatus.OutOfStock}">
                                                    <Setter Property="Background" Value="{DynamicResource DangerBackgroundBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:StockStatus.Negative}">
                                                    <Setter Property="Background" Value="{DynamicResource DangerBackgroundBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:StockStatus.NotTracked}">
                                                    <Setter Property="Background" Value="{DynamicResource DisabledBackgroundBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontWeight="Bold" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:StockStatus.OK}">
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
                                                        <Setter Property="Text" Value="OK" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:StockStatus.Low}">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
                                                        <Setter Property="Text" Value="Low stock" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:StockStatus.OutOfStock}">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        <Setter Property="Text" Value="Out of stock" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:StockStatus.Negative}">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        <Setter Property="Text" Value="Negative" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:StockStatus.NotTracked}">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                        <Setter Property="Text" Value="Not tracked" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Cost Price (hidden for Cashier) -->
                    <DataGridTextColumn x:Name="CostPriceColumn" Header="Cost Price" Binding="{Binding CostPrice, Converter={StaticResource MoneyConverter}}" Width="110"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" IsReadOnly="True" />

                    <!-- Sale Price -->
                    <DataGridTextColumn Header="Sale Price" Binding="{Binding SalePrice, Converter={StaticResource MoneyConverter}}" Width="110"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" IsReadOnly="True" />

                    <!-- Total Value at Cost -->
                    <DataGridTextColumn x:Name="ValueAtCostColumn" Header="Value at Cost" Binding="{Binding StockValueAtCost, Converter={StaticResource MoneyConverter}}" Width="120"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" IsReadOnly="True" />

                    <!-- Total Value at Retail -->
                    <DataGridTextColumn Header="Value at Retail" Binding="{Binding StockValueAtSale, Converter={StaticResource MoneyConverter}}" Width="120"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer Paging -->
        <Border Grid.Row="3" Style="{StaticResource PaginationBarStyle}">
            <Grid>
                <TextBlock Grid.Column="0" Text="{Binding RowCountText}" Style="{StaticResource MutedLabelStyle}" VerticalAlignment="Center" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="&lt; Prev" Command="{Binding PreviousPageCommand}" Style="{StaticResource PaginationButtonStyle}" />
                    <TextBlock VerticalAlignment="Center" Margin="8,0">
                        <Run Text="Page " Foreground="{DynamicResource TextMutedBrush}" />
                        <Run Text="{Binding CurrentPage}" FontWeight="Bold" />
                        <Run Text=" of " Foreground="{DynamicResource TextMutedBrush}" />
                        <Run Text="{Binding TotalPages}" FontWeight="Bold" />
                    </TextBlock>
                    <Button Content="Next &gt;" Command="{Binding NextPageCommand}" Style="{StaticResource PaginationButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
