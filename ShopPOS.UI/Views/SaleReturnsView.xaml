<UserControl x:Class="ShopPOS.UI.Views.SaleReturnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.Sales"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SaleReturnsViewModel}"
             Background="{DynamicResource PageBackgroundBrush}"
             FontFamily="{StaticResource AppFontFamily}">

    <UserControl.InputBindings>
        <KeyBinding Gesture="Ctrl+A" Command="{Binding SelectAllOnPageCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto" />
            <!-- Filter Bar -->
            <RowDefinition Height="Auto" />
            <!-- Workspace Tabs -->
            <RowDefinition Height="Auto" />
            <!-- Content Area (Sales or Returns) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TITLE & ACTION BUTTONS -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Customer Returns" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Process customer refunds, restock undamaged items, track return reasons." Style="{StaticResource SubTitleStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="+ New Return" Command="{Binding NewReturnCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" />
                <Button Content="Cancel Selected Return" Command="{Binding CancelReturnCommand}" Style="{StaticResource DangerButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- FILTER BAR -->
        <Border Grid.Row="1" Style="{StaticResource FilterBarStyle}" Margin="0,0,0,12">
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="Search:" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="200" Height="36"
                             Style="{StaticResource InputTextBoxStyle}"
                             Tag="Search Sale #, Customer...">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding RefreshAllCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>

                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="From Date:" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                    <DatePicker SelectedDate="{Binding DateFrom, Mode=TwoWay}" Width="145" Height="36" Style="{StaticResource InputDatePickerStyle}" />
                </StackPanel>

                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="To Date:" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                    <DatePicker SelectedDate="{Binding DateTo, Mode=TwoWay}" Width="145" Height="36" Style="{StaticResource InputDatePickerStyle}" />
                </StackPanel>

                <Button Content="Filter / Refresh (F5)" Command="{Binding RefreshAllCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="36" Padding="16,0"
                        Margin="0,17,0,0" VerticalAlignment="Bottom" />
            </WrapPanel>
        </Border>

        <!-- WORKSPACE TABS -->
        <Border Grid.Row="2" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="{Binding RecentSales.Count, StringFormat='Recent Customer Purchases ({0})'}"
                             IsChecked="{Binding ActiveTab, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=0}"
                             FontWeight="Bold" FontSize="13" Margin="0,0,16,0" />
                <RadioButton Content="{Binding Items.Count, StringFormat='Processed Returns History ({0})'}"
                             IsChecked="{Binding ActiveTab, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=1}"
                             FontWeight="Bold" FontSize="13" />
            </StackPanel>
        </Border>

        <!-- TAB 0: RECENT CUSTOMER PURCHASES (FOR DIRECT RETURN) -->
        <Border Grid.Row="3">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource TableContainerBorderStyle}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActiveTab}" Value="1">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DataGrid ItemsSource="{Binding RecentSales}" SelectedItem="{Binding SelectedSale, Mode=TwoWay}"
                      Style="{StaticResource AppDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Sale #" Binding="{Binding SaleNumber}" Width="140"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" />
                    <DataGridTextColumn Header="Date &amp; Time" Binding="{Binding SaleDate, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="150" />
                    <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName, TargetNullValue='Walk-in'}" Width="*" />
                    <DataGridTextColumn Header="Contact No" Binding="{Binding CustomerPhone, TargetNullValue='-'}" Width="140" />
                    <DataGridTextColumn Header="Items" Binding="{Binding ItemCount}" Width="75"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" />
                    <DataGridTextColumn Header="Total" Binding="{Binding GrandTotal, Converter={StaticResource MoneyConverter}}" Width="130"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" />
                    <DataGridTextColumn Header="Paid" Binding="{Binding PaidAmount, Converter={StaticResource MoneyConverter}}" Width="130"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" />
                    <DataGridTemplateColumn Width="140" Header="Action">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="+ Return Items"
                                        Command="{Binding DataContext.ReturnSaleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Height="26" Padding="8,2" FontSize="12" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- TAB 1: PROCESSED RETURNS HISTORY -->
        <Grid Grid.Row="3">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActiveTab}" Value="1">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Bulk Selection Banner & Toolbar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceCardSubtleBrush}"
                    BorderBrush="{DynamicResource TableSelectedBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,8"
                    Margin="0,0,0,10"
                    Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectionStatusText}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <Button Content="Clear selection" Command="{Binding ClearSelectionCommand}"
                                Style="{StaticResource GhostButtonStyle}" Margin="8,0,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Delete Selected" Command="{Binding DeleteSelectedCommand}"
                                Visibility="{Binding CanShowDeleteSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource DangerButtonStyle}" Margin="0,0,8,0" />
                        <Button Content="Cancel Selected" Command="{Binding CancelSelectedCommand}"
                                Visibility="{Binding CanShowCancelSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Select All Filtered Results Banner -->
            <Border Grid.Row="1"
                    Background="{DynamicResource WarningBackgroundBrush}"
                    BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,8"
                    Margin="0,0,0,10"
                    Visibility="{Binding ShowSelectAllResultsBanner, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding SelectAllResultsBannerText}" Foreground="{DynamicResource WarningTextBrush}" FontWeight="Medium" VerticalAlignment="Center" />
                    <Button Content="Click here to select all matching results" Command="{Binding SelectAllFilteredResultsCommand}"
                            Style="{StaticResource GhostButtonStyle}" Foreground="{DynamicResource WarningTextBrush}" FontWeight="Bold" Margin="8,0,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource TableContainerBorderStyle}">
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          Style="{StaticResource AppDataGridStyle}">
                    <DataGrid.Columns>
                        <!-- Selection Checkbox Column -->
                        <DataGridTemplateColumn Width="40" CanUserResize="False">
                            <DataGridTemplateColumn.Header>
                                <CheckBox IsChecked="{Binding DataContext.IsAllOnPageSelected, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                          Command="{Binding DataContext.ToggleSelectAllOnPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                              Command="{Binding DataContext.ItemSelectionChangedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Return #" Binding="{Binding ReturnNumber}" Width="150"
                                            ElementStyle="{StaticResource MonospaceNumericCell}" />
                        <DataGridTextColumn Header="Date" Binding="{Binding ReturnDate, Converter={StaticResource DateDisplayConverter}}" Width="140" />
                        <DataGridTextColumn Header="Orig Sale #" Binding="{Binding SaleNumber}" Width="140"
                                            ElementStyle="{StaticResource MonospaceNumericCell}" />
                        <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName, TargetNullValue='Walk-in'}" Width="*" />
                        <DataGridTextColumn Header="Refund Total" Binding="{Binding TotalRefundAmount, Converter={StaticResource MoneyConverter}}" Width="130"
                                            ElementStyle="{StaticResource MonospaceNumericCell}" Foreground="{DynamicResource DangerBrush}" />
                        <DataGridTextColumn Header="Refund Method" Binding="{Binding RefundMethod}" Width="130" />
                        <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="180" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
