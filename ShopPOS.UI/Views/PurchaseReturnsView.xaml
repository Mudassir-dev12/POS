<UserControl x:Class="ShopPOS.UI.Views.PurchaseReturnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.PurchaseReturns"
             xmlns:dto="clr-namespace:ShopPOS.Core.DTOs;assembly=ShopPOS.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PurchaseReturnsViewModel}"
             Background="{DynamicResource PageBackgroundBrush}"
             FontFamily="{StaticResource AppFontFamily}"
             Loaded="UserControl_Loaded">

    <UserControl.InputBindings>
        <KeyBinding Gesture="Ctrl+A" Command="{Binding SelectAllOnPageCommand}" />
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewReturnCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto" />
            <!-- Search & Filter Controls -->
            <RowDefinition Height="Auto" />
            <!-- Data Grid -->
            <RowDefinition Height="*" />
            <!-- Footer Paging -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= 1. HEADER ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Purchase Returns (Debit Notes)" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Manage outbound product returns, debit notes, and inventory write-backs." Style="{StaticResource SubTitleStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="+ New Return (Ctrl+N)"
                        Command="{Binding NewReturnCommand}"
                        IsEnabled="{Binding CanAdd}"
                        Style="{StaticResource PrimaryButtonStyle}" />

                <Button Content="Cancel Return"
                        Command="{Binding CancelSelectedReturnCommand}"
                        Style="{StaticResource DangerButtonStyle}"
                        Margin="8,0,0,0" />

                <Button Content="Refresh (F5)"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- ================= 2. FILTERS ================= -->
        <Border Grid.Row="1" Style="{StaticResource FilterBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <TextBox Grid.Column="0"
                         Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputTextBoxStyle}">
                    <TextBox.Resources>
                        <VisualBrush x:Key="CueBannerBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                            <VisualBrush.Visual>
                                <TextBlock Text="Search return #, notes..." Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="6,0,0,0" />
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </TextBox.Resources>
                </TextBox>

                <!-- Supplier Filter -->
                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding Suppliers}"
                          SelectedValue="{Binding SelectedSupplierId, Mode=TwoWay}"
                          SelectedValuePath="Id"
                          DisplayMemberPath="Name"
                          Style="{StaticResource InputComboBoxStyle}" />

                <!-- Error Message -->
                <TextBlock Grid.Column="3"
                           Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource DangerBrush}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ================= 3. DATA GRID ================= -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Bulk Selection Banner & Toolbar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceCardSubtleBrush}"
                    BorderBrush="{DynamicResource TableSelectedBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,8"
                    Margin="0,0,0,10"
                    Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectionStatusText}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <Button Content="Clear selection" Command="{Binding ClearSelectionCommand}"
                                Style="{StaticResource GhostButtonStyle}" Margin="8,0,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Delete Selected" Command="{Binding DeleteSelectedCommand}"
                                Visibility="{Binding CanShowDeleteSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource DangerButtonStyle}" Margin="0,0,8,0" />
                        <Button Content="Cancel Selected" Command="{Binding CancelSelectedCommand}"
                                Visibility="{Binding CanShowCancelSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Select All Filtered Results Banner -->
            <Border Grid.Row="1"
                    Background="{DynamicResource WarningBackgroundBrush}"
                    BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,8"
                    Margin="0,0,0,10"
                    Visibility="{Binding ShowSelectAllResultsBanner, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding SelectAllResultsBannerText}" Foreground="{DynamicResource WarningTextBrush}" FontWeight="Medium" VerticalAlignment="Center" />
                    <Button Content="Click here to select all matching results" Command="{Binding SelectAllFilteredResultsCommand}"
                            Style="{StaticResource GhostButtonStyle}" Foreground="{DynamicResource WarningTextBrush}" FontWeight="Bold" Margin="8,0,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource TableContainerBorderStyle}">
                <DataGrid ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          Style="{StaticResource AppDataGridStyle}">
                    <DataGrid.Columns>
                        <!-- Selection Checkbox Column -->
                        <DataGridTemplateColumn Width="40" CanUserResize="False">
                            <DataGridTemplateColumn.Header>
                                <CheckBox IsChecked="{Binding DataContext.IsAllOnPageSelected, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                          Command="{Binding DataContext.ToggleSelectAllOnPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                              Command="{Binding DataContext.ItemSelectionChangedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Return #" Binding="{Binding ReturnNumber}" Width="130"
                                            ElementStyle="{StaticResource MonospaceNumericCell}" />
                        <DataGridTextColumn Header="Date" Binding="{Binding ReturnDate, Converter={StaticResource DateDisplayConverter}}" Width="140" />
                        <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="1.5*" FontWeight="Medium" />
                        <DataGridTextColumn Header="Invoice Ref" Binding="{Binding PurchaseNumber, TargetNullValue='Manual'}" Width="120" />
                        <DataGridTextColumn Header="Total Amount" Binding="{Binding TotalAmount, Converter={StaticResource MoneyConverter}}" Width="120"
                                            ElementStyle="{StaticResource MonospaceNumericCell}" />

                        <!-- Status Column -->
                        <DataGridTemplateColumn Header="Status" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type dto:PurchaseReturnDto}">
                                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                        <Setter Property="Background" Value="{DynamicResource DangerBackgroundBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Posted" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                            <Setter Property="Text" Value="Cancelled" />
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Reason / Notes" Binding="{Binding Notes, TargetNullValue='—'}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- ================= 4. FOOTER PAGING ================= -->
        <Border Grid.Row="3" Style="{StaticResource PaginationBarStyle}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RowCountText}" Style="{StaticResource MutedLabelStyle}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="&lt; Prev" Command="{Binding PreviousPageCommand}" Style="{StaticResource PaginationButtonStyle}" />
                    <TextBlock Text="{Binding CurrentPage, StringFormat='Page {0}'}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0" />
                    <TextBlock Text="{Binding TotalPages, StringFormat='of {0}'}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Content="Next >" Command="{Binding NextPageCommand}" Style="{StaticResource PaginationButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
