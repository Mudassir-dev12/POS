<UserControl x:Class="ShopPOS.UI.Views.SupplierPaymentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.SupplierPayments"
             xmlns:dto="clr-namespace:ShopPOS.Core.DTOs;assembly=ShopPOS.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SupplierPaymentsViewModel}"
             Loaded="UserControl_Loaded">

    <UserControl.InputBindings>
        <KeyBinding Gesture="Ctrl+A" Command="{Binding SelectAllOnPageCommand}" />
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding RecordPaymentCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto" />
            <!-- Search & Filter Controls -->
            <RowDefinition Height="Auto" />
            <!-- Data Grid & Bulk Actions -->
            <RowDefinition Height="*" />
            <!-- Footer Paging -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Vendor payments" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Track outgoing disbursements and supplier payment history."
                           Style="{StaticResource SubTitleStyle}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Record payment Ctrl N"
                        Command="{Binding RecordPaymentCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,8,0" />

                <Button Content="Cancel payment"
                        Command="{Binding CancelSelectedPaymentCommand}"
                        Style="{StaticResource DangerButtonStyle}"
                        Margin="0,0,8,0" />

                <Button Content="Refresh F5"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource ToolbarButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- 2. Search & Filters Bar -->
        <Border Grid.Row="1" Style="{StaticResource FilterBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search payment reference or notes" />

                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding Suppliers}"
                          SelectedValuePath="Id"
                          DisplayMemberPath="Name"
                          SelectedValue="{Binding SelectedSupplierId}"
                          ToolTip="Filter by Supplier" />

                <ComboBox Grid.Column="4"
                          ItemsSource="{Binding PaymentMethods}"
                          SelectedItem="{Binding SelectedPaymentMethod}"
                          ToolTip="Filter by Payment Method" />
            </Grid>
        </Border>

        <!-- 3. Table Area & Bulk Actions -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Bulk Selection Status Banner -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SecondaryBackgroundBrush}"
                    BorderBrush="{DynamicResource SecondaryBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,8"
                    Margin="0,0,0,10"
                    Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectionStatusText}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <Button Content="Clear selection"
                                Command="{Binding ClearSelectionCommand}"
                                Style="{StaticResource GhostButtonStyle}"
                                Padding="8,2"
                                Margin="8,0,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel selected"
                                Command="{Binding CancelSelectedCommand}"
                                Style="{StaticResource DangerButtonStyle}"
                                Visibility="{Binding CanShowCancelSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Select All Filtered Results Cross-Page Banner -->
            <Border Grid.Row="1"
                    Background="{DynamicResource WarningBackgroundBrush}"
                    BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,8"
                    Margin="0,0,0,10"
                    Visibility="{Binding ShowSelectAllResultsBanner, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding SelectAllResultsBannerText}"
                               Foreground="{DynamicResource WarningTextBrush}"
                               FontWeight="Medium"
                               VerticalAlignment="Center" />
                    <Button Content="Select all matching results across all pages"
                            Command="{Binding SelectAllFilteredResultsCommand}"
                            Style="{StaticResource GhostButtonStyle}"
                            FontWeight="Bold"
                            Foreground="{DynamicResource WarningTextBrush}"
                            Margin="8,0,0,0" />
                </StackPanel>
            </Border>

            <!-- Main DataGrid Container -->
            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <!-- Loading Indicator Overlay -->
                    <Border Background="{DynamicResource OverlayBackgroundBrush}"
                            Panel.ZIndex="10"
                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Loading payments..."
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <!-- Empty State Message -->
                    <Border HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Panel.ZIndex="5"
                            Visibility="{Binding Items.Count, Converter={StaticResource InverseBooleanConverter}}">
                        <TextBlock Text="No payments to show"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center" />
                    </Border>

                    <!-- DataGrid -->
                    <DataGrid ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <!-- Selection Checkbox Column -->
                            <DataGridTemplateColumn Width="38" CanUserResize="False">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox IsChecked="{Binding DataContext.IsAllOnPageSelected, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                              Command="{Binding DataContext.ToggleSelectAllOnPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  Command="{Binding DataContext.ItemSelectionChangedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="PAYMENT #" Binding="{Binding PaymentNumber}" Width="120" ElementStyle="{StaticResource MonospaceTextStyle}" />
                            <DataGridTextColumn Header="DATE" Binding="{Binding PaymentDate, Converter={StaticResource DateDisplayConverter}}" Width="110" ElementStyle="{StaticResource MonospaceTextStyle}" />
                            <DataGridTextColumn Header="SUPPLIER" Binding="{Binding SupplierName}" Width="2*" FontWeight="Medium" />
                            <DataGridTextColumn Header="METHOD" Binding="{Binding PaymentMethod}" Width="120" />
                            <DataGridTextColumn Header="REFERENCE" Binding="{Binding ReferenceNumber}" Width="*" />

                            <!-- Amount (Right-aligned, Monospace) -->
                            <DataGridTextColumn Header="AMOUNT"
                                                Binding="{Binding Amount, Converter={StaticResource MoneyConverter}}"
                                                Width="110"
                                                ElementStyle="{StaticResource MonospaceNumericCell}" />

                            <!-- Status Column -->
                            <DataGridTemplateColumn Header="STATUS" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type dto:SupplierPaymentDto}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Style="{StaticResource StatusDotActive}"
                                                     Visibility="{Binding IsCancelled, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                            <Ellipse Style="{StaticResource StatusDotInactive}"
                                                     Visibility="{Binding IsCancelled, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock Text="{Binding Status}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. Paging Footer -->
        <Border Grid.Row="3" Style="{StaticResource PaginationBarStyle}">
            <Grid>
                <TextBlock Text="{Binding RowCountText}"
                           FontFamily="{StaticResource AppMonospaceFontFamily}"
                           FontSize="11"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="&lt; Prev"
                            Command="{Binding PreviousPageCommand}"
                            Style="{StaticResource PaginationButtonStyle}"
                            MinWidth="54" />

                    <TextBlock Text="{Binding CurrentPage, StringFormat='Page {0}'}"
                               FontFamily="{StaticResource AppMonospaceFontFamily}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               Margin="8,0" />

                    <TextBlock Text="{Binding TotalPages, StringFormat='of {0}'}"
                               FontFamily="{StaticResource AppMonospaceFontFamily}"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />

                    <Button Content="Next &gt;"
                            Command="{Binding NextPageCommand}"
                            Style="{StaticResource PaginationButtonStyle}"
                            MinWidth="54" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
