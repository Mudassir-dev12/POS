<UserControl x:Class="ShopPOS.UI.Views.SupplierLedgerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.SupplierLedger"
             xmlns:dto="clr-namespace:ShopPOS.Core.DTOs;assembly=ShopPOS.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SupplierLedgerViewModel}"
             Background="#F1F5F9"
             FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
             Loaded="UserControl_Loaded">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding LoadLedgerCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto" />
            <!-- Filter Controls -->
            <RowDefinition Height="Auto" />
            <!-- Summary Balance Cards -->
            <RowDefinition Height="Auto" />
            <!-- Data Grid -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= 1. HEADER ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Supplier Ledger Statement" FontSize="22" FontWeight="Bold" Foreground="#0F172A" />
                <TextBlock Text="Audit chronological debits, credits, running balance, and export accounting statements." FontSize="13" Foreground="#64748B" Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="📄 Export PDF"
                        Command="{Binding ExportPdfCommand}"
                        Background="#2563EB"
                        Foreground="White"
                        FontWeight="Bold"
                        Padding="14,8"
                        BorderThickness="0"
                        Cursor="Hand" />

                <Button Content="📊 Export CSV"
                        Command="{Binding ExportCsvCommand}"
                        Background="#334155"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Padding="14,8"
                        Margin="8,0,0,0"
                        BorderThickness="0"
                        Cursor="Hand" />

                <Button Content="🔄 Refresh (F5)"
                        Command="{Binding LoadLedgerCommand}"
                        Background="#E2E8F0"
                        Foreground="#334155"
                        FontWeight="SemiBold"
                        Padding="12,8"
                        Margin="8,0,0,0"
                        BorderThickness="0"
                        Cursor="Hand" />
            </StackPanel>
        </Grid>

        <!-- ================= 2. FILTERS ================= -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,0,14" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Supplier Filter -->
                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding Suppliers}"
                          SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          Padding="8,6"
                          FontSize="13" />

                <!-- Date Range -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="From:" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" Width="120" Padding="4,2" />
                    <TextBlock Text="To:" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" Margin="10,0,6,0" />
                    <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" Width="120" Padding="4,2" />
                </StackPanel>

                <Button Grid.Column="4"
                        Content="Generate Statement"
                        Command="{Binding LoadLedgerCommand}"
                        Background="#0F172A"
                        Foreground="White"
                        FontWeight="Bold"
                        Padding="14,6"
                        BorderThickness="0"
                        Cursor="Hand" />

                <!-- Error Message -->
                <TextBlock Grid.Column="5"
                           Text="{Binding ErrorMessage}"
                           Foreground="#DC2626"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ================= 3. SUMMARY CARDS ================= -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Opening Balance -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="OPENING BALANCE" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                    <TextBlock Text="{Binding OpeningBalance, StringFormat='{}{0:C}'}" FontSize="18" FontWeight="Bold" Foreground="#334155" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Card 2: Total Debits (Purchases) -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="TOTAL PURCHASES (DEBITS +)" FontSize="10" FontWeight="Bold" Foreground="#1E40AF" />
                    <TextBlock Text="{Binding TotalDebits, StringFormat='{}{0:C}'}" FontSize="18" FontWeight="Bold" Foreground="#2563EB" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Card 3: Total Credits (Payments & Returns) -->
            <Border Grid.Column="4" Background="White" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="PAYMENTS &amp; RETURNS (CREDITS -)" FontSize="10" FontWeight="Bold" Foreground="#166534" />
                    <TextBlock Text="{Binding TotalCredits, StringFormat='{}{0:C}'}" FontSize="18" FontWeight="Bold" Foreground="#16A34A" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Card 4: Closing Balance -->
            <Border Grid.Column="6" Background="#EFF6FF" CornerRadius="8" BorderBrush="#93C5FD" BorderThickness="1" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="CLOSING BALANCE DUE" FontSize="10" FontWeight="Bold" Foreground="#1E3A8A" />
                    <TextBlock Text="{Binding ClosingBalance, StringFormat='{}{0:C}'}" FontSize="20" FontWeight="Bold" Foreground="#1D4ED8" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= 4. DATA GRID ================= -->
        <Border Grid.Row="3" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Entries}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      Background="White"
                      BorderThickness="0"
                      RowHeight="36">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='{}{0:dd MMM yyyy HH:mm}'}" Width="135" />
                    <DataGridTextColumn Header="Type" Binding="{Binding EntryType}" Width="110" FontWeight="Bold" />
                    <DataGridTextColumn Header="Doc / Ref #" Binding="{Binding ReferenceNumber, TargetNullValue='—'}" Width="120" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="Description / Details" Binding="{Binding Description}" Width="2*" />
                    <DataGridTextColumn Header="Debit (+)" Binding="{Binding Debit, StringFormat='{}{0:0.00}'}" Width="110" Foreground="#2563EB" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="Credit (-)" Binding="{Binding Credit, StringFormat='{}{0:0.00}'}" Width="110" Foreground="#16A34A" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="Running Balance" Binding="{Binding RunningBalance, StringFormat='{}{0:0.00}'}" Width="130" FontWeight="Bold" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>

