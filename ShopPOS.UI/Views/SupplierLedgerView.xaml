<UserControl x:Class="ShopPOS.UI.Views.SupplierLedgerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.SupplierLedger"
             xmlns:dto="clr-namespace:ShopPOS.Core.DTOs;assembly=ShopPOS.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SupplierLedgerViewModel}"
             Background="{DynamicResource PageBackgroundBrush}"
             FontFamily="{StaticResource AppFontFamily}"
             Loaded="UserControl_Loaded">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding LoadLedgerCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto" />
            <!-- Filter Controls -->
            <RowDefinition Height="Auto" />
            <!-- Summary Balance Cards -->
            <RowDefinition Height="Auto" />
            <!-- Data Grid -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= 1. HEADER ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Supplier Ledger Statement" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Audit chronological debits, credits, running balance, and export accounting statements." Style="{StaticResource SubTitleStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Export PDF"
                        Command="{Binding ExportPdfCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" />

                <Button Content="Export CSV"
                        Command="{Binding ExportCsvCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Margin="8,0,0,0" />

                <Button Content="Refresh (F5)"
                        Command="{Binding LoadLedgerCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- ================= 2. FILTERS ================= -->
        <Border Grid.Row="1" Style="{StaticResource FilterBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Supplier Filter -->
                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding Suppliers}"
                          SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          Style="{StaticResource InputComboBoxStyle}" />

                <!-- Date Range -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="From:" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" Width="120" Padding="4,2" />
                    <TextBlock Text="To:" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="10,0,6,0" />
                    <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" Width="120" Padding="4,2" />
                </StackPanel>

                <Button Grid.Column="4"
                        Content="Generate Statement"
                        Command="{Binding LoadLedgerCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" />

                <!-- Error Message -->
                <TextBlock Grid.Column="5"
                           Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource DangerBrush}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ================= 3. SUMMARY CARDS ================= -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Opening Balance -->
            <Border Grid.Column="0" Style="{StaticResource SurfaceCardStyle}">
                <StackPanel>
                    <TextBlock Text="OPENING BALANCE" Style="{StaticResource KpiLabelStyle}" />
                    <TextBlock Text="{Binding OpeningBalance, Converter={StaticResource MoneyConverter}}" Style="{StaticResource KpiValueStyle}" />
                </StackPanel>
            </Border>

            <!-- Card 2: Total Debits (Purchases) -->
            <Border Grid.Column="2" Style="{StaticResource SurfaceCardStyle}">
                <StackPanel>
                    <TextBlock Text="TOTAL PURCHASES (DEBITS +)" Style="{StaticResource KpiLabelStyle}" />
                    <TextBlock Text="{Binding TotalDebits, Converter={StaticResource MoneyConverter}}" Style="{StaticResource KpiValueStyle}" />
                </StackPanel>
            </Border>

            <!-- Card 3: Total Credits (Payments & Returns) -->
            <Border Grid.Column="4" Style="{StaticResource SurfaceCardStyle}">
                <StackPanel>
                    <TextBlock Text="PAYMENTS &amp; RETURNS (CREDITS -)" Style="{StaticResource KpiLabelStyle}" />
                    <TextBlock Text="{Binding TotalCredits, Converter={StaticResource MoneyConverter}}" Style="{StaticResource KpiValueStyle}" />
                </StackPanel>
            </Border>

            <!-- Card 4: Closing Balance -->
            <Border Grid.Column="6" Style="{StaticResource SurfaceCardStyle}">
                <StackPanel>
                    <TextBlock Text="CLOSING BALANCE DUE" Style="{StaticResource KpiLabelStyle}" />
                    <TextBlock Text="{Binding ClosingBalance, Converter={StaticResource MoneyConverter}}" Style="{StaticResource KpiValueStyle}" Foreground="{DynamicResource PrimaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= 4. DATA GRID ================= -->
        <Border Grid.Row="3" Style="{StaticResource TableContainerBorderStyle}">
            <DataGrid ItemsSource="{Binding Entries}"
                      Style="{StaticResource AppDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding Date, Converter={StaticResource DateDisplayConverter}}" Width="140" />
                    <DataGridTextColumn Header="Type" Binding="{Binding EntryType}" Width="120" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="Doc / Ref #" Binding="{Binding ReferenceNumber, TargetNullValue='—'}" Width="130"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" />
                    <DataGridTextColumn Header="Description / Details" Binding="{Binding Description}" Width="2*" />
                    <DataGridTextColumn Header="Debit (+)" Binding="{Binding Debit, Converter={StaticResource MoneyConverter}}" Width="120"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" />
                    <DataGridTextColumn Header="Credit (-)" Binding="{Binding Credit, Converter={StaticResource MoneyConverter}}" Width="120"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" />
                    <DataGridTextColumn Header="Running Balance" Binding="{Binding RunningBalance, Converter={StaticResource MoneyConverter}}" Width="140"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
