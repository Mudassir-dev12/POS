<UserControl x:Class="ShopPOS.UI.Views.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.Suppliers"
             xmlns:dto="clr-namespace:ShopPOS.Core.DTOs;assembly=ShopPOS.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SuppliersViewModel}"
             Background="#F1F5F9"
             FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
             Loaded="UserControl_Loaded">

    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding AddCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteOrDeactivateCommand}" />
        <KeyBinding Key="Enter" Command="{Binding EditCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Vendors &amp; Suppliers" FontSize="22" FontWeight="Bold" Foreground="#0F172A" />
                <TextBlock Text="Manage supplier directory, vendor terms, and initial payable balances." FontSize="13" Foreground="#64748B" Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="+ New Supplier (Ctrl+N)"
                        Command="{Binding AddCommand}"
                        IsEnabled="{Binding CanAdd}"
                        Background="#2563EB"
                        Foreground="White"
                        FontWeight="Bold"
                        Padding="14,8"
                        BorderThickness="0"
                        Cursor="Hand" />

                <Button Content="🔄 Refresh (F5)"
                        Command="{Binding RefreshCommand}"
                        Background="#E2E8F0"
                        Foreground="#334155"
                        FontWeight="SemiBold"
                        Padding="12,8"
                        BorderThickness="0"
                        Cursor="Hand" />
            </StackPanel>
        </Grid>

        <!-- Search Bar -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16,10" Margin="0,0,0,14" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,6"
                         FontSize="13">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Resources>
                                <VisualBrush x:Key="CueBannerBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                    <VisualBrush.Visual>
                                        <TextBlock Text="🔍 Search supplier name, phone, email..." Foreground="#94A3B8" FontSize="12" Margin="6,0,0,0" />
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Style.Resources>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background" Value="{StaticResource CueBannerBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <CheckBox Grid.Column="2" Content="Show Inactive" IsChecked="{Binding ShowInactive}" FontWeight="Medium" Foreground="#64748B" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding ErrorMessage}" Foreground="#DC2626" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Main Body: DataGrid (left) + Read-Only Detail Panel (right) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <!-- DataGrid Table -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                <DataGrid ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          Background="White"
                          BorderThickness="0"
                          RowHeight="38"
                          MouseDoubleClick="DataGrid_MouseDoubleClick">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Opacity" Value="{Binding IsActive, Converter={StaticResource InactiveOpacityConverter}}" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Supplier Name" Binding="{Binding Name}" Width="1.5*" FontWeight="Bold" />
                        <DataGridTextColumn Header="Contact Person" Binding="{Binding ContactPerson}" Width="*" />
                        <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="110" />
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*" />
                        <DataGridTextColumn Header="Opening Bal." Binding="{Binding OpeningBalance, StringFormat='{}{0:0.00}'}" Width="100" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="Live Balance" Binding="{Binding CurrentBalance, StringFormat='{}{0:0.00}'}" Width="105" FontWeight="Bold" />
                        <DataGridTemplateColumn Header="Status" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type dto:SupplierDto}">
                                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#DCFCE7" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Background" Value="#F1F5F9" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}" FontSize="11" FontWeight="Bold" Foreground="#16A34A" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Read-Only Detail Panel -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Supplier Details" FontSize="16" FontWeight="Bold" Foreground="#0F172A" />

                        <Border Background="#F8FAFC" CornerRadius="6" Padding="12" Margin="0,4,0,0">
                            <StackPanel>
                                <StackPanel>
                                    <TextBlock Text="NAME" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock Text="{Binding SelectedItem.Name, FallbackValue='(Select a supplier)'}" FontSize="14" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="CONTACT PERSON" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock Text="{Binding SelectedItem.ContactPerson, FallbackValue='—'}" FontSize="12" Foreground="#334155" />
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="PHONE" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock Text="{Binding SelectedItem.Phone, FallbackValue='—'}" FontSize="12" Foreground="#334155" />
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="EMAIL" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock Text="{Binding SelectedItem.Email, FallbackValue='—'}" FontSize="12" Foreground="#334155" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="TAX / VAT NUMBER" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock Text="{Binding SelectedItem.TaxNumber, FallbackValue='—'}" FontSize="12" Foreground="#334155" />
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="ADDRESS" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock Text="{Binding SelectedItem.Address, FallbackValue='—'}" FontSize="12" Foreground="#334155" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="NOTES / TERMS" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock Text="{Binding SelectedItem.Notes, FallbackValue='—'}" FontSize="12" Foreground="#334155" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Opening Balance Highlight Card -->
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel>
                                <TextBlock Text="OPENING BALANCE" FontSize="10" FontWeight="Bold" Foreground="#1E40AF" />
                                <TextBlock Text="{Binding SelectedItem.OpeningBalance, StringFormat='We owe them: {0:C}', FallbackValue='We owe them: $0.00'}"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#1E3A8A"
                                           Margin="0,4,0,2" />
                                <TextBlock Text="(Positive = Store payable to vendor)" FontSize="10" Foreground="#3B82F6" />
                            </StackPanel>
                        </Border>

                        <!-- Live Current Balance Card & View Ledger -->
                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="CURRENT PAYABLE BALANCE" FontSize="10" FontWeight="Bold" Foreground="#166534" />
                                <TextBlock Text="{Binding SelectedItem.CurrentBalance, StringFormat='Outstanding: {0:C}', FallbackValue='Outstanding: $0.00'}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#15803D"
                                           Margin="0,4,0,2" />
                                <TextBlock Text="(Calculated live from purchases and payments ledger)" FontSize="10" Foreground="#16A34A" Margin="0,0,0,10" />

                                <Button Content="📖 View Ledger"
                                        Command="{Binding ViewLedgerCommand}"
                                        CommandParameter="{Binding SelectedItem}"
                                        Background="#16A34A"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        Padding="10,6"
                                        BorderThickness="0"
                                        Cursor="Hand" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3" Margin="0,14,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RowCountText}" FontWeight="SemiBold" Foreground="#334155" FontSize="13" />
                    <TextBlock Text="  •  Double-click or Enter to edit  •  Del to delete/deactivate" FontSize="12" Foreground="#94A3B8" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="◀ Prev" Command="{Binding PreviousPageCommand}" Padding="12,6" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" />
                    <TextBlock Text="{Binding CurrentPage, StringFormat='Page {0}'}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TotalPages, StringFormat='of {0}'}" Foreground="#64748B" VerticalAlignment="Center" />
                    <Button Content="Next ▶" Command="{Binding NextPageCommand}" Padding="12,6" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
