<Window x:Class="ShopPOS.UI.Views.Dialogs.Sales.SaleReturnDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Process Sale Return"
        Height="620"
        Width="840"
        Style="{DynamicResource DialogWindowStyle}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Invoice Search Bar -->
        <Border Grid.Row="0" Style="{DynamicResource CardBorderStyle}" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Find Sale Invoice:" Style="{DynamicResource FormLabelStyle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBox Grid.Column="1" Text="{Binding SearchInvoiceNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14" Height="36" VerticalContentAlignment="Center" Margin="0,0,10,0"
                         Style="{DynamicResource InputTextBoxStyle}"
                         Tag="Enter Sale # (e.g. INV-000001)...">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SearchSaleCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="2" Content="Find Sale" Command="{Binding SearchSaleCommand}"
                        Style="{DynamicResource PrimaryButtonStyle}" MinWidth="110" Height="36" />
            </Grid>
        </Border>

        <!-- Loaded Sale Header Info (if any) -->
        <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}" Padding="14,10" Margin="0,0,0,12"
                Visibility="{Binding LoadedSaleNumber, Converter={StaticResource NullToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Sale: " FontSize="13" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="{Binding LoadedSaleNumber}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,16,0" />
                    <TextBlock Text="Date: " FontSize="13" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="{Binding LoadedSaleDate, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,16,0" />
                    <TextBlock Text="Customer: " FontSize="13" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="{Binding LoadedCustomerName}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Returnable Items Grid -->
        <Border Grid.Row="2" Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,12">
            <DataGrid ItemsSource="{Binding ReturnLines}" AutoGenerateColumns="False" CanUserAddRows="False"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Select" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="55" />
                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="90" IsReadOnly="True" />
                    <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*" IsReadOnly="True" />
                    <DataGridTextColumn Header="Sold" Binding="{Binding SoldQuantity, StringFormat='{}{0:G29}'}" Width="60" IsReadOnly="True" />
                    <DataGridTextColumn Header="Returned" Binding="{Binding AlreadyReturnedQuantity, StringFormat='{}{0:G29}'}" Width="70" IsReadOnly="True" />
                    <DataGridTextColumn Header="Available" Binding="{Binding AvailableReturnQuantity, StringFormat='{}{0:G29}'}" Width="70" IsReadOnly="True" />
                    <DataGridTemplateColumn Header="Return Qty" Width="85">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding ReturnQuantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="4,2" HorizontalContentAlignment="Right" IsEnabled="{Binding IsSelected}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridCheckBoxColumn Header="Restock?" Binding="{Binding ReturnToStock, UpdateSourceTrigger=PropertyChanged}" Width="75" />
                    <DataGridTextColumn Header="Refund Est." Binding="{Binding EstimatedLineRefund, Converter={StaticResource MoneyConverter}}" Width="90" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer Controls & Total -->
        <Border Grid.Row="3" Style="{DynamicResource CardBorderStyle}" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Refund Method:" Style="{DynamicResource FormLabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding Source={StaticResource PaymentMethods}}" SelectedItem="{Binding RefundMethod, Mode=TwoWay}"
                                  Width="130" Height="36" Margin="0,0,16,0" VerticalContentAlignment="Center"
                                  Style="{DynamicResource InputComboBoxStyle}" />
                        <TextBlock Text="Return Reason:" Style="{DynamicResource FormLabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding GlobalReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Width="200" Height="36" VerticalContentAlignment="Center"
                                 Style="{DynamicResource InputTextBoxStyle}"
                                 Tag="Optional reason for return..." />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Total Refund:" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding TotalRefundAmount, Converter={StaticResource MoneyConverter}}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource DangerTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerTextBrush}" FontSize="12" VerticalAlignment="Center"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{DynamicResource SecondaryButtonStyle}" MinWidth="100" Margin="0,0,10,0" />
                        <Button Content="Post Return" Command="{Binding PostReturnCommand}" Style="{DynamicResource DangerButtonStyle}" MinWidth="120" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
