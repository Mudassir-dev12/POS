<Window x:Class="ShopPOS.UI.Views.Dialogs.Sales.ReceiptPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.Sales"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:ReceiptPreviewDialogViewModel}"
        Title="{Binding Title}"
        Height="740" Width="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        Background="#0F172A">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Control Bar -->
        <Border Grid.Row="0" Background="#1E293B" Padding="16,12" BorderBrush="#334155" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DocumentTitle}" FontSize="16" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="#94A3B8" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Save PDF" Command="{Binding SavePdfCommand}"
                            Padding="14,8" FontWeight="SemiBold" Background="#334155" Foreground="White" Margin="0,0,8,0" />
                    <Button Content="Print Document" Command="{Binding PrintCommand}"
                            Padding="16,8" FontWeight="Bold" Background="#2563EB" Foreground="White" Margin="0,0,8,0" />
                    <Button Content="Close" Command="{Binding CloseCommand}"
                            Padding="14,8" Background="#475569" Foreground="White" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Paper Preview Surface -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#334155" Padding="20">
            <ItemsControl ItemsSource="{Binding PageImages}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="2" Margin="0,0,0,20">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.4" />
                            </Border.Effect>
                            <Image Source="{Binding}" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Status Bottom Bar -->
        <Border Grid.Row="2" Background="#1E293B" Padding="14,8" BorderBrush="#334155" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusMessage, FallbackValue='Preview Ready. Click Print or Save PDF.'}"
                       FontSize="12" Foreground="#E2E8F0" />
        </Border>
    </Grid>
</Window>
