<Window x:Class="ShopPOS.UI.Views.Dialogs.Sales.ReceiptPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.Sales"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:ReceiptPreviewDialogViewModel}"
        Title="{Binding Title}"
        Height="740" Width="680"
        Style="{DynamicResource DialogWindowStyle}"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding PrintCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SavePdfCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Control Bar -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" Padding="16,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DocumentTitle}" Style="{DynamicResource SectionHeaderStyle}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{DynamicResource SubtitleStyle}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Save PDF (Ctrl+S)" Command="{Binding SavePdfCommand}"
                            Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                    <Button Content="Print Document (Enter)" Command="{Binding PrintCommand}"
                            Style="{DynamicResource PrimaryButtonStyle}" IsDefault="True" Margin="0,0,8,0" />
                    <Button Content="Close (Esc)" Command="{Binding CloseCommand}"
                            Style="{DynamicResource SecondaryButtonStyle}" IsCancel="True" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Paper Preview Surface -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource MutedBrush}" Padding="20">
            <ItemsControl ItemsSource="{Binding PageImages}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="2" Margin="0,0,0,20">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.3" />
                            </Border.Effect>
                            <Image Source="{Binding}" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Status Bottom Bar -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" Padding="14,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusMessage, FallbackValue='Slip Preview Ready. Press Enter or click Print Document to print.'}"
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
        </Border>
    </Grid>
</Window>
