<Window x:Class="ShopPOS.UI.Views.Dialogs.Sales.PosHelpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.Sales"
        mc:Ignorable="d"
        Title="POS Keyboard Shortcuts Help (F1)"
        Height="540"
        Width="640"
        Style="{DynamicResource DialogWindowStyle}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="POS Keyboard Shortcuts Reference" Style="{DynamicResource SectionHeaderStyle}" />
            <TextBlock Text="Speed up checkout operations by navigating entirely with your keyboard." Style="{DynamicResource SubtitleStyle}" Margin="0,3,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}">
            <DataGrid ItemsSource="{Binding Shortcuts}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" Background="Transparent" RowHeight="36">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Key / Shortcut" Binding="{Binding Key}" Width="150" FontWeight="Bold" />
                    <DataGridTextColumn Header="Function" Binding="{Binding Description}" Width="*" />
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="110" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Button Grid.Row="2" Content="Close (Escape)" Command="{Binding CloseCommand}" IsCancel="True" HorizontalAlignment="Right" Style="{DynamicResource PrimaryButtonStyle}" Margin="0,16,0,0" />
    </Grid>
</Window>
