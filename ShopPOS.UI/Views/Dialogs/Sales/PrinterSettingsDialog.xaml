<Window x:Class="ShopPOS.UI.Views.Dialogs.Sales.PrinterSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.Settings"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:PrinterSettingsDialogViewModel}"
        Title="Printer &amp; Hardware Settings"
        Height="620" Width="560"
        Style="{DynamicResource DialogWindowStyle}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Receipt Printer &amp; Cash Drawer" Style="{DynamicResource SectionHeaderStyle}" />
            <TextBlock Text="Configure hardware thermal printing, driver queue, and pulse signals." Style="{DynamicResource SubtitleStyle}" Margin="0,3,0,0" />
        </StackPanel>

        <!-- Form Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Printing Mode -->
                <TextBlock Text="PRINTING MODE" Style="{DynamicResource FormLabelStyle}" />
                <ComboBox ItemsSource="{Binding AvailablePrinterModes}"
                          SelectedItem="{Binding PrinterMode, Mode=TwoWay}"
                          Margin="0,0,0,14" />

                <!-- Printer Queue -->
                <TextBlock Text="INSTALLED WINDOWS PRINTER" Style="{DynamicResource FormLabelStyle}" />
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding InstalledPrinters}"
                              SelectedItem="{Binding SelectedPrinter, Mode=TwoWay}"
                              IsEditable="True" />
                    <Button Grid.Column="2"
                            Content="Refresh"
                            Command="{Binding RefreshPrintersCommand}"
                            Style="{DynamicResource SecondaryButtonStyle}" />
                </Grid>

                <!-- Paper Width & Copies -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="PAPER ROLL WIDTH" Style="{DynamicResource FormLabelStyle}" />
                        <ComboBox SelectedValuePath="Tag"
                                  SelectedValue="{Binding ReceiptWidthMm, Mode=TwoWay}">
                            <ComboBoxItem Content="80 mm (Standard Thermal)" Tag="80" />
                            <ComboBoxItem Content="58 mm (Compact Thermal)" Tag="58" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="COPIES PER SALE" Style="{DynamicResource FormLabelStyle}" />
                        <TextBox Text="{Binding ReceiptCopies, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <!-- Checkboxes -->
                <CheckBox Content="Automatically print receipt when sale completes"
                          IsChecked="{Binding AutoPrintReceipt, Mode=TwoWay}"
                          FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />

                <CheckBox Content="Send cash drawer kick pulse on cash sales"
                          IsChecked="{Binding OpenCashDrawerOnCashSale, Mode=TwoWay}"
                          FontWeight="SemiBold" FontSize="13" Margin="0,0,0,14" />

                <!-- Receipt Footer -->
                <TextBlock Text="RECEIPT FOOTER MESSAGE" Style="{DynamicResource FormLabelStyle}" />
                <TextBox Text="{Binding ReceiptFooter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,16" />

                <!-- Hardware Test Actions -->
                <Border Style="{DynamicResource CardBorderStyle}" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="HARDWARE DIAGNOSTICS" Style="{DynamicResource FormLabelStyle}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Test Print Receipt"
                                    Command="{Binding TestPrintCommand}"
                                    Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,10,0" />
                            <Button Content="Open Cash Drawer"
                                    Command="{Binding OpenCashDrawerCommand}"
                                    Style="{DynamicResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Status / Error Banner -->
        <StackPanel Grid.Row="2" Margin="0,4,0,10">
            <Border Background="{DynamicResource SuccessBackgroundBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6"
                    Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SuccessTextBrush}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
            </Border>
            <Border Background="{DynamicResource DangerBackgroundBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerTextBrush}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!-- Action Footer -->
        <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Command="{Binding CancelCommand}"
                        Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,10,0" />
                <Button Content="Save Settings" Command="{Binding SaveCommand}"
                        Style="{DynamicResource PrimaryButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
