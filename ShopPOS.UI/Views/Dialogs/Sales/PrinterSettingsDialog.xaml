<Window x:Class="ShopPOS.UI.Views.Dialogs.Sales.PrinterSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.Settings"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:PrinterSettingsDialogViewModel}"
        Title="Printer &amp; Hardware Settings"
        Height="620" Width="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        Background="#F8FAFC">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Receipt Printer &amp; Cash Drawer" FontSize="18" FontWeight="Bold" Foreground="White" />
                <TextBlock Text="Configure hardware thermal printing, driver queue, and pulse signals" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- Form Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Printing Mode -->
                <TextBlock Text="PRINTING MODE" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding AvailablePrinterModes}"
                          SelectedItem="{Binding PrinterMode, Mode=TwoWay}"
                          Padding="8,6" FontSize="13" Margin="0,0,0,14" />

                <!-- Printer Queue -->
                <TextBlock Text="INSTALLED WINDOWS PRINTER" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4" />
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding InstalledPrinters}"
                              SelectedItem="{Binding SelectedPrinter, Mode=TwoWay}"
                              IsEditable="True"
                              Padding="8,6" FontSize="13" />
                    <Button Grid.Column="2"
                            Content="Refresh"
                            Command="{Binding RefreshPrintersCommand}"
                            Padding="12,6" FontSize="12" Background="#F1F5F9" />
                </Grid>

                <!-- Paper Width & Copies -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="PAPER ROLL WIDTH" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4" />
                        <ComboBox SelectedValuePath="Tag"
                                  SelectedValue="{Binding ReceiptWidthMm, Mode=TwoWay}"
                                  Padding="8,6" FontSize="13">
                            <ComboBoxItem Content="80 mm (Standard Thermal)" Tag="80" />
                            <ComboBoxItem Content="58 mm (Compact Thermal)" Tag="58" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="COPIES PER SALE" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ReceiptCopies, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6" FontSize="13" />
                    </StackPanel>
                </Grid>

                <!-- Checkboxes -->
                <CheckBox Content="Automatically print receipt when sale completes"
                          IsChecked="{Binding AutoPrintReceipt, Mode=TwoWay}"
                          FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />

                <CheckBox Content="Send cash drawer kick pulse on cash sales"
                          IsChecked="{Binding OpenCashDrawerOnCashSale, Mode=TwoWay}"
                          FontWeight="SemiBold" FontSize="13" Margin="0,0,0,14" />

                <!-- Receipt Footer -->
                <TextBlock Text="RECEIPT FOOTER MESSAGE" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4" />
                <TextBox Text="{Binding ReceiptFooter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,6" FontSize="13" Margin="0,0,0,16" />

                <!-- Hardware Test Actions -->
                <Border Background="#F1F5F9" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="HARDWARE DIAGNOSTICS" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Test Print Receipt"
                                    Command="{Binding TestPrintCommand}"
                                    Padding="14,8" FontWeight="SemiBold" Background="#E2E8F0" Margin="0,0,10,0" />
                            <Button Content="Open Cash Drawer"
                                    Command="{Binding OpenCashDrawerCommand}"
                                    Padding="14,8" FontWeight="SemiBold" Background="#E2E8F0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Status / Error Banner -->
        <StackPanel Grid.Row="2" Margin="0,4,0,10">
            <Border Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="4" Padding="10,6"
                    Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#15803D" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
            </Border>
            <Border Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="4" Padding="10,6"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!-- Action Footer -->
        <Border Grid.Row="3" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Command="{Binding CancelCommand}"
                        Padding="16,8" FontSize="13" Margin="0,0,10,0" Background="#F1F5F9" />
                <Button Content="Save Settings" Command="{Binding SaveCommand}"
                        Padding="18,8" FontSize="13" FontWeight="Bold" Background="#2563EB" Foreground="White" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
