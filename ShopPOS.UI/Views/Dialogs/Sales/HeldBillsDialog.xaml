<Window x:Class="ShopPOS.UI.Views.Dialogs.Sales.HeldBillsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.HeldBills"
        mc:Ignorable="d"
        Title="Held Bills (Parked Carts)"
        Height="480"
        Width="780"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Parked Sales / Held Bills (F5)" FontSize="18" FontWeight="Bold" Foreground="#0F172A" />
                <TextBlock Text="Resume a parked transaction into the active cart or delete it." FontSize="13" Foreground="#64748B" Margin="0,3,0,0" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Bills}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" BorderThickness="0" Background="Transparent" RowHeight="38">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Hold #" Binding="{Binding HoldNumber}" Width="120" FontWeight="Bold" />
                    <DataGridTextColumn Header="Time" Binding="{Binding Date, StringFormat='{}{0:HH:mm}'}" Width="70" />
                    <DataGridTextColumn Header="Age" Binding="{Binding AgeText}" Width="85" Foreground="#64748B" />
                    <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="1.5*" />
                    <DataGridTextColumn Header="Items" Binding="{Binding ItemCount}" Width="65" />
                    <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat='${0:F2}'}" Width="95" FontWeight="Bold" />
                    <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*" Foreground="#64748B" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Delete Held Bill" Command="{Binding DeleteCommand}" HorizontalAlignment="Left" Background="#FEE2E2" Foreground="#DC2626" FontWeight="SemiBold" Padding="14,8" BorderThickness="0" Cursor="Hand" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Resume Into Cart (Enter)" Command="{Binding ResumeCommand}" IsDefault="True" Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="16,8" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand" />
                <Button Content="Close (Esc)" Command="{Binding CloseCommand}" IsCancel="True" Background="#E2E8F0" Foreground="#0F172A" FontWeight="SemiBold" Padding="14,8" BorderThickness="0" Cursor="Hand" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

