<Window x:Class="ShopPOS.UI.Views.Dialogs.Sales.SaleDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.Sales"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:SaleDetailDialogViewModel}"
        Title="Sale Details &amp; Invoice"
        Height="660"
        Width="820"
        Style="{DynamicResource DialogWindowStyle}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Card -->
        <Border Grid.Row="0" Style="{DynamicResource CardBorderStyle}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="{Binding Sale.SaleNumber, FallbackValue='SALE-000000'}" Style="{DynamicResource SectionHeaderStyle}" />
                        <Border Background="{Binding Sale.Status, Converter={StaticResource SaleStatusBadgeBackgroundConverter}}"
                                CornerRadius="4" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Sale.Status}"
                                       Foreground="{Binding Sale.Status, Converter={StaticResource SaleStatusBadgeColorConverter}}"
                                       FontSize="11" FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Sale.SaleDate, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="{Binding Sale.CustomerName, StringFormat='Customer: {0}', TargetNullValue='Customer: Walk-in'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="TOTAL" Style="{DynamicResource FormLabelStyle}" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding Sale.GrandTotal, Converter={StaticResource MoneyConverter}}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding Sale.PaidAmount, Converter={StaticResource MoneyConverter}, StringFormat='Paid: {0}'}" FontSize="12" Foreground="{DynamicResource SuccessTextBrush}" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabbed Sections: Items & Payments -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="Items Sold" FontWeight="SemiBold">
                <Border Style="{DynamicResource CardBorderStyle}" Margin="0,8,0,0">
                    <DataGrid ItemsSource="{Binding Sale.Items}" AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="100" />
                            <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*" />
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, StringFormat='{}{0:G29}'}" Width="70" />
                            <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, Converter={StaticResource MoneyConverter}}" Width="90" />
                            <DataGridTextColumn Header="Discount" Binding="{Binding DiscountAmount, Converter={StaticResource MoneyConverter}}" Width="80" />
                            <DataGridTextColumn Header="Tax %" Binding="{Binding TaxPercent, StringFormat='{}{0:0.#}%'}" Width="70" />
                            <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, Converter={StaticResource MoneyConverter}}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
            <TabItem Header="Payments" FontWeight="SemiBold">
                <Border Style="{DynamicResource CardBorderStyle}" Margin="0,8,0,0">
                    <DataGrid ItemsSource="{Binding Sale.Payments}" AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="140" />
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, Converter={StaticResource MoneyConverter}}" Width="120" />
                            <DataGridTextColumn Header="Tendered" Binding="{Binding TenderedAmount, Converter={StaticResource MoneyConverter}}" Width="120" />
                            <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="*" />
                            <DataGridTextColumn Header="Date" Binding="{Binding PaidAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Status Message Banner -->
        <Border Grid.Row="2" Background="{DynamicResource InfoBackgroundBrush}" BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,8,0,0"
                Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource InfoTextBrush}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
        </Border>

        <!-- Footer Actions -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Print Actions -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Reprint Receipt (Duplicate)" Command="{Binding ReprintReceiptCommand}"
                        Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,10,0" />
                <Button Content="A4 Full Invoice" Command="{Binding PrintA4InvoiceCommand}"
                        Style="{DynamicResource SecondaryButtonStyle}" />
            </StackPanel>

            <!-- Right: Close Button -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />
                <Button Content="Close (Esc)" Command="{Binding CloseCommand}"
                        Style="{DynamicResource PrimaryButtonStyle}" MinWidth="100" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
