<Window x:Class="ShopPOS.UI.Views.Dialogs.Sales.SalePaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:enums="clr-namespace:ShopPOS.Core.Enums;assembly=ShopPOS.Core"
        mc:Ignorable="d"
        Title="Tender &amp; Payment"
        Height="600"
        Width="660"
        Style="{DynamicResource DialogWindowStyle}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: Bill Total & Walk-in Sale -->
        <Border Grid.Row="0" Style="{DynamicResource CardBorderStyle}" Padding="16,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="TOTAL PAYABLE" Style="{DynamicResource FormLabelStyle}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding CurrencySymbol}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding GrandTotal, StringFormat='{}{0:N2}'}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Counter Sale" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                    <TextBlock Text="Paid in full" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Customer Information -->
        <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}" Padding="12,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Customer Name (optional)" Style="{DynamicResource FormLabelStyle}" Margin="0,0,0,2" />
                    <TextBox Text="{Binding CustomerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource InputTextBoxStyle}" Height="30" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Contact No / Phone" Style="{DynamicResource FormLabelStyle}" Margin="0,0,0,2" />
                    <TextBox Text="{Binding CustomerPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource InputTextBoxStyle}" Height="30" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Quick Cash Buttons -->
        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="Quick Cash (Exact / Common Notes):" Style="{DynamicResource FormLabelStyle}" />
            <ItemsControl ItemsSource="{Binding QuickCashNotes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Converter={StaticResource MoneyConverter}}"
                                Command="{Binding DataContext.SetCashAmountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Height="34" MinWidth="75" Margin="0,0,8,0" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Split Tenders / Payment Lines List -->
        <Border Grid.Row="3" Style="{DynamicResource CardBorderStyle}" Padding="14,12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Payment Lines / Multi-Tender:" Style="{DynamicResource SectionHeaderStyle}" FontSize="13" Margin="0,0,0,10" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="135" Margin="0,0,0,6">
                    <ItemsControl ItemsSource="{Binding Payments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="135" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Method Dropdown -->
                                    <ComboBox Grid.Column="0" SelectedItem="{Binding Method, Mode=TwoWay}"
                                              Height="36" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                              Style="{StaticResource InputComboBoxStyle}">
                                        <enums:PaymentMethod>Cash</enums:PaymentMethod>
                                        <enums:PaymentMethod>Card</enums:PaymentMethod>
                                        <enums:PaymentMethod>Bank</enums:PaymentMethod>
                                        <enums:PaymentMethod>MobileWallet</enums:PaymentMethod>
                                        <enums:PaymentMethod>Other</enums:PaymentMethod>
                                    </ComboBox>

                                    <!-- Amount -->
                                    <TextBox Grid.Column="1" Text="{Binding Amount, StringFormat='{}{0:N2}', UpdateSourceTrigger=PropertyChanged}"
                                             Height="36" Margin="0,0,8,0" FontWeight="Bold" FontSize="14"
                                             HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                                             Style="{StaticResource InputTextBoxStyle}" />

                                    <!-- Reference for non-cash -->
                                    <TextBox Grid.Column="2" Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}"
                                             Height="36" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                             IsEnabled="{Binding IsNonCash}"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             Tag="Ref / Transaction ID"
                                             ToolTip="Optional reference or transaction ID for Card/Bank/Mobile" />

                                    <!-- Remove -->
                                    <Button Grid.Column="3" Content="X"
                                            Command="{Binding DataContext.RemovePaymentLineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Style="{DynamicResource DangerButtonStyle}"
                                            Height="36" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Button Grid.Row="2" Content="+ Add Split Tender Method" Command="{Binding AddPaymentLineCommand}"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        HorizontalAlignment="Left" Height="32" Padding="14,4" Margin="0,4,0,0" />
            </Grid>
        </Border>

        <!-- Summary & Validation Row -->
        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Error message or validation warning -->
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerTextBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />

            <!-- Change summary -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Background="{DynamicResource SuccessBackgroundBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6"
                        Visibility="{Binding ChangeAmount, Converter={StaticResource DecimalGreaterThanZeroToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Change Due: " FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SuccessTextBrush}" />
                        <TextBlock Text="{Binding ChangeAmount, Converter={StaticResource MoneyConverter}}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource SuccessTextBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel (Esc)" Command="{Binding CancelCommand}"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    MinWidth="110" Height="38" Margin="0,0,10,0" />
            <Button Content="Complete Sale (Enter)" Command="{Binding CompleteCommand}" IsEnabled="{Binding IsValid}"
                    Style="{DynamicResource SuccessButtonStyle}"
                    MinWidth="170" Height="38" FontSize="14" />
        </StackPanel>
    </Grid>
</Window>
