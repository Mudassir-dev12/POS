<Window x:Class="ShopPOS.UI.Views.Dialogs.BulkConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm Bulk Action"
        Width="480"
        SizeToContent="Height"
        Style="{DynamicResource DialogWindowStyle}"
        ResizeMode="NoResize">

    <Border Padding="24" Style="{DynamicResource SurfaceCardStyle}" Margin="12">
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Confirm Action" Style="{DynamicResource SectionHeaderStyle}" />
            <TextBlock x:Name="MessageText" Text="Are you sure you want to perform this action?" TextWrapping="Wrap" Style="{DynamicResource SubTitleStyle}" Margin="0,10,0,0" LineHeight="20" />

            <!-- Typed Confirmation Section (when > 50 items or all results selected) -->
            <StackPanel x:Name="TypedConfirmationSection" Visibility="Collapsed" Margin="0,16,0,0">
                <Border Background="{DynamicResource DangerBackgroundBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <TextBlock x:Name="WarningText" Text="This affects a large number of items. Type DELETE to confirm."
                               FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" FontSize="12" TextWrapping="Wrap" />
                </Border>
                <TextBlock Text="TYPE CONFIRMATION WORD BELOW:" Style="{DynamicResource MutedLabelStyle}" Margin="0,0,0,4" />
                <TextBox x:Name="ConfirmationInput" Style="{DynamicResource InputTextBoxStyle}" FontSize="14" FontWeight="Bold" TextChanged="ConfirmationInput_TextChanged" />
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="Cancel" Click="Cancel_Click" Style="{DynamicResource SecondaryButtonStyle}" Width="90" Height="34" Margin="0,0,10,0" />
                <Button x:Name="ConfirmBtn" Content="Confirm" Click="Confirm_Click" Style="{DynamicResource DangerButtonStyle}" Width="130" Height="34" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
