<Window x:Class="ShopPOS.UI.Views.Dialogs.PurchaseEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:enums="clr-namespace:ShopPOS.Core.Enums;assembly=ShopPOS.Core"
        xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.Purchases"
        xmlns:dto="clr-namespace:ShopPOS.Core.DTOs;assembly=ShopPOS.Core"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="860"
        Width="1280"
        MinHeight="680"
        MinWidth="1024"
        Style="{StaticResource DialogWindowStyle}"
        Loaded="Window_Loaded">

    <Window.Resources>
        <ObjectDataProvider x:Key="PaymentMethods" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:PaymentMethod" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveDraftCommand}" />
        <KeyBinding Key="Return" Modifiers="Ctrl" Command="{Binding PostPurchaseCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
        <KeyBinding Key="F2" Command="{Binding OpenProductSearchCommand}" />
    </Window.InputBindings>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Top Header & Meta -->
            <RowDefinition Height="Auto" />
            <!-- Status & Warning Banners -->
            <RowDefinition Height="Auto" />
            <!-- Invoice Header Inputs -->
            <RowDefinition Height="Auto" />
            <!-- Barcode Scanner & Line Items Grid + Stats -->
            <RowDefinition Height="*" />
            <!-- Footer: Totals, Immediate Payment & Buttons -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= TOP HEADER ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Purchase Invoice: " Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{Binding PurchaseNumber}" Style="{StaticResource PageTitleStyle}" Foreground="{DynamicResource PrimaryBrush}" Margin="4,0,12,0" />

                <!-- Status Badge -->
                <Border CornerRadius="4" Padding="8,3" VerticalAlignment="Center"
                        Background="{Binding Status, Converter={StaticResource PurchaseStatusBadgeBackgroundConverter}}">
                    <TextBlock Text="{Binding Status}"
                               FontWeight="Bold"
                               FontSize="12"
                               Foreground="{Binding Status, Converter={StaticResource PurchaseStatusBadgeColorConverter}}" />
                </Border>

                <!-- Payment Status Badge -->
                <Border CornerRadius="4" Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center"
                        Background="{Binding PaymentStatus, Converter={StaticResource PaymentStatusBadgeBackgroundConverter}}">
                    <TextBlock Text="{Binding PaymentStatus}"
                               FontWeight="Bold"
                               FontSize="12"
                               Foreground="{Binding PaymentStatus, Converter={StaticResource PaymentStatusBadgeColorConverter}}" />
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Shortcuts: Ctrl+S = Save Draft  •  Ctrl+Enter = Post  •  F2 = Search Product  •  Esc = Close"
                           Style="{StaticResource MutedLabelStyle}" VerticalAlignment="Center" Margin="0,0,16,0" />
            </StackPanel>
        </Grid>

        <!-- ================= BANNERS ================= -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <!-- Read-Only Posted Banner -->
            <Border Background="{DynamicResource SuccessBackgroundBrush}" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,6"
                    Visibility="{Binding IsReadOnly, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text=" LOCKED DOCUMENT: " FontWeight="Bold" Foreground="{DynamicResource SuccessTextBrush}" />
                    <TextBlock Text="This purchase has been posted/cancelled and is immutable. Inventory movements and balances are locked."
                               Foreground="{DynamicResource SuccessTextBrush}" />
                    <TextBlock Text="{Binding PostedAt, Converter={StaticResource DateDisplayConverter}, StringFormat=' (Posted: {0})'}" Foreground="{DynamicResource SuccessTextBrush}" FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <!-- Warning Banner (Cost difference warnings) -->
            <ItemsControl ItemsSource="{Binding Warnings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource WarningBackgroundBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text=" Warning: " FontWeight="Bold" Foreground="{DynamicResource WarningTextBrush}" />
                                <TextBlock Text="{Binding}" Foreground="{DynamicResource WarningTextBrush}" FontWeight="Medium" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Error Banner -->
            <Border Background="{DynamicResource DangerBackgroundBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,6"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" />
            </Border>
        </StackPanel>

        <!-- ================= INVOICE HEADER INPUTS ================= -->
        <Border Grid.Row="2" Style="{StaticResource FilterBarStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.5*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1.5*" />
                </Grid.ColumnDefinitions>

                <!-- Supplier Picker -->
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="VENDOR / SUPPLIER *" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Suppliers}"
                              SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBooleanConverter}}"
                              Style="{StaticResource InputComboBoxStyle}" />
                </StackPanel>

                <!-- Purchase Date -->
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="PURCHASE DATE *" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                    <DatePicker SelectedDate="{Binding PurchaseDate, Mode=TwoWay}"
                                IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBooleanConverter}}"
                                Padding="6,4"
                                FontSize="13" />
                </StackPanel>

                <!-- Due Date -->
                <StackPanel Grid.Row="0" Grid.Column="4">
                    <TextBlock Text="PAYMENT DUE DATE" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                    <DatePicker SelectedDate="{Binding DueDate, Mode=TwoWay}"
                                IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBooleanConverter}}"
                                Padding="6,4"
                                FontSize="13" />
                </StackPanel>

                <!-- Supplier Invoice No -->
                <StackPanel Grid.Row="0" Grid.Column="6">
                    <TextBlock Text="SUPPLIER INVOICE #" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding SupplierInvoiceNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding IsReadOnly}"
                             Style="{StaticResource InputTextBoxStyle}" />
                </StackPanel>

                <!-- Notes / Remarks (Row 1 spanning full width) -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="7" Margin="0,10,0,0">
                    <TextBlock Text="NOTES / RECEIVING MEMO" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding IsReadOnly}"
                             Style="{StaticResource InputTextBoxStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= LINE ITEMS GRID & STATS ================= -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1*" MinWidth="260" MaxWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- Line Items Area -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <!-- Top Barcode Scan & Search Box -->
                    <RowDefinition Height="Auto" />
                    <!-- DataGrid -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Scan Bar -->
                <Border Grid.Row="0" Style="{StaticResource SurfaceCardStyle}" Padding="10,6" Margin="0,0,0,8"
                        Visibility="{Binding IsReadOnly, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="BarcodeScannerBox"
                                 Grid.Column="0"
                                 Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 KeyDown="BarcodeScannerBox_KeyDown">
                            <TextBox.Resources>
                                <VisualBrush x:Key="CueBannerBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                    <VisualBrush.Visual>
                                        <TextBlock Text=" Scan barcode with USB scanner, or type SKU / Name and press Enter..." Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="6,0,0,0" />
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </TextBox.Resources>
                        </TextBox>

                        <Button Grid.Column="1"
                                Content="Add Item (Enter)"
                                Command="{Binding AddScannedProductCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="8,0,0,0" />

                        <Button Grid.Column="2"
                                Content="Search Catalog (F2)"
                                Command="{Binding OpenProductSearchCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,0,0,0" />
                    </Grid>
                </Border>

                <!-- Table -->
                <Border Grid.Row="1" Style="{StaticResource TableContainerBorderStyle}">
                    <DataGrid x:Name="LinesGrid"
                              ItemsSource="{Binding LineItems}"
                              SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="{Binding IsReadOnly}"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              Style="{StaticResource AppDataGridStyle}"
                              RowHeight="36"
                              PreviewKeyDown="LinesGrid_PreviewKeyDown">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" IsReadOnly="True" Width="100"
                                                ElementStyle="{StaticResource MonospaceNumericCell}" />
                            <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" IsReadOnly="True" Width="2*" FontWeight="SemiBold" />

                            <!-- Editable Quantity -->
                            <DataGridTextColumn Header="Qty"
                                                Binding="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.###}'}"
                                                Width="85" ElementStyle="{StaticResource MonospaceNumericCell}" />

                            <!-- Editable Unit Cost -->
                            <DataGridTextColumn Header="Unit Cost"
                                                Binding="{Binding UnitCost, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.00}'}"
                                                Width="105" ElementStyle="{StaticResource MonospaceNumericCell}" />

                            <!-- Editable Discount % -->
                            <DataGridTextColumn Header="Disc %"
                                                Binding="{Binding DiscountPercent, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.##}'}"
                                                Width="75" ElementStyle="{StaticResource MonospaceNumericCell}" />

                            <!-- Editable Tax % -->
                            <DataGridTextColumn Header="Tax %"
                                                Binding="{Binding TaxPercent, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.##}'}"
                                                Width="75" ElementStyle="{StaticResource MonospaceNumericCell}" />

                            <!-- Computed Net Cost -->
                            <DataGridTextColumn Header="Net Cost"
                                                Binding="{Binding EffectiveNetUnitCost, Converter={StaticResource MoneyConverter}}"
                                                IsReadOnly="True"
                                                Width="100" ElementStyle="{StaticResource MonospaceNumericCell}" />

                            <!-- Computed Line Total -->
                            <DataGridTextColumn Header="Line Total"
                                                Binding="{Binding LineTotal, Converter={StaticResource MoneyConverter}}"
                                                IsReadOnly="True"
                                                Width="110" ElementStyle="{StaticResource MonospaceNumericCell}" />

                            <!-- Remove Button Column -->
                            <DataGridTemplateColumn Width="45">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="X"
                                                Click="RemoveLine_Click"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Foreground="{DynamicResource DangerBrush}"
                                                FontWeight="Bold"
                                                ToolTip="Remove item (or press Delete)" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- Product Sidebar Stats -->
            <Border Grid.Column="2" Style="{StaticResource SurfaceCardStyle}" Padding="16">
                <StackPanel>
                    <TextBlock Text="Product Inventory Info" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,12" />

                    <!-- Selected Product Card -->
                    <Border Background="{DynamicResource SurfaceCardSubtleBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="SELECTED PRODUCT" Style="{StaticResource MutedLabelStyle}" />
                            <TextBlock Text="{Binding SelectedLine.ProductName, FallbackValue='(No line selected)'}"
                                       FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,2,0,6" />

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="SKU: " FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding SelectedLine.Sku, FallbackValue='—'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Current Stock On Hand -->
                    <Border Background="{DynamicResource SurfaceCardSubtleBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="CURRENT STOCK ON HAND" Style="{StaticResource MutedLabelStyle}" />
                            <TextBlock Text="{Binding SelectedProductStock, StringFormat='{}{0:0.###} units', TargetNullValue='—', FallbackValue='—'}"
                                       FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,4,0,2" />
                            <TextBlock Text="(Live calculation from ledger)" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Last Purchase Cost -->
                    <Border Background="{DynamicResource SurfaceCardSubtleBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <TextBlock Text="LAST PURCHASE COST" Style="{StaticResource MutedLabelStyle}" />
                            <TextBlock Text="{Binding SelectedProductLastCost, Converter={StaticResource MoneyConverter}, TargetNullValue='—', FallbackValue='—'}"
                                       FontSize="18" FontWeight="Bold" Foreground="{DynamicResource SuccessTextBrush}" Margin="0,4,0,2" />
                            <TextBlock Text="(From previous posted invoice)" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= FOOTER ================= -->
        <Border Grid.Row="4" Style="{StaticResource SurfaceCardStyle}" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left: Immediate Pay Now -->
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="20" />
                    <!-- Right: Summary Totals & Action Buttons -->
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- Immediate Payment Panel -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <CheckBox Content="Record immediate payment upon posting (Pay Now)"
                              IsChecked="{Binding PayNowEnabled, Mode=TwoWay}"
                              IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBooleanConverter}}"
                              FontWeight="Bold"
                              Margin="0,0,0,8" />

                    <Grid Visibility="{Binding PayNowEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="AMOUNT TO PAY" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,2" />
                            <TextBox Text="{Binding PayNowAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.00}'}"
                                     IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBooleanConverter}}"
                                     Style="{StaticResource InputTextBoxStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="PAYMENT METHOD" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,2" />
                            <ComboBox SelectedItem="{Binding PayNowMethod, Mode=TwoWay}"
                                      ItemsSource="{Binding Source={StaticResource PaymentMethods}}"
                                      IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBooleanConverter}}"
                                      Style="{StaticResource InputComboBoxStyle}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Summary Totals & Action Buttons -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Totals Breakdown -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.3*" />
                        </Grid.ColumnDefinitions>

                        <!-- Subtotal -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SUBTOTAL" Style="{StaticResource MutedLabelStyle}" />
                            <TextBlock Text="{Binding SubTotal, Converter={StaticResource MoneyConverter}}" Style="{StaticResource KpiValueStyle}" />
                        </StackPanel>

                        <!-- Invoice Discount -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="DISCOUNT" Style="{StaticResource MutedLabelStyle}" />
                            <TextBox Text="{Binding InvoiceDiscount, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.00}'}"
                                     IsReadOnly="{Binding IsReadOnly}"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     Width="80"
                                     HorizontalAlignment="Left" />
                        </StackPanel>

                        <!-- Tax -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="TAX" Style="{StaticResource MutedLabelStyle}" />
                            <TextBlock Text="{Binding TaxAmount, Converter={StaticResource MoneyConverter}}" Style="{StaticResource KpiValueStyle}" />
                        </StackPanel>

                        <!-- Freight -->
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="FREIGHT" Style="{StaticResource MutedLabelStyle}" />
                            <TextBox Text="{Binding FreightAmount, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.00}'}"
                                     IsReadOnly="{Binding IsReadOnly}"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     Width="80"
                                     HorizontalAlignment="Left" />
                        </StackPanel>

                        <!-- Grand Total -->
                        <StackPanel Grid.Column="4" HorizontalAlignment="Right">
                            <TextBlock Text="GRAND TOTAL" Style="{StaticResource MutedLabelStyle}" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding GrandTotal, Converter={StaticResource MoneyConverter}}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="Close (Esc)"
                                Command="{Binding CloseCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,10,0" />

                        <Button Content="Save Draft (Ctrl+S)"
                                Command="{Binding SaveDraftCommand}"
                                IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBooleanConverter}}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,10,0" />

                        <Button Content="Post Purchase (Ctrl+Enter)"
                                Command="{Binding PostPurchaseCommand}"
                                IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBooleanConverter}}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
