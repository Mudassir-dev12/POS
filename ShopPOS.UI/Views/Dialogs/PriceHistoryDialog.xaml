<Window x:Class="ShopPOS.UI.Views.Dialogs.PriceHistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Product Price Change History"
        Height="450"
        Width="680"
        Style="{StaticResource DialogWindowStyle}">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </Window.InputBindings>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Table -->
            <RowDefinition Height="*" />
            <!-- Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,14" Padding="0,0,0,10" BorderBrush="{DynamicResource SeparatorBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Price Change Audit History" Style="{StaticResource SectionHeaderStyle}" />
                <TextBlock Text="{Binding ProductTitle}" Style="{StaticResource SubTitleStyle}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="1" Style="{StaticResource TableContainerBorderStyle}">
            <DataGrid ItemsSource="{Binding Histories}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Style="{StaticResource AppDataGridStyle}"
                      RowHeight="34">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date &amp; Time" Binding="{Binding ChangedAt, Converter={StaticResource DateDisplayConverter}}" Width="150" />
                    <DataGridTextColumn Header="Modified By" Binding="{Binding ChangedByUserName}" Width="120" />
                    <DataGridTextColumn Header="Old Cost" Binding="{Binding OldCostPrice, Converter={StaticResource MoneyConverter}}" Width="100"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" />
                    <DataGridTextColumn Header="New Cost" Binding="{Binding NewCostPrice, Converter={StaticResource MoneyConverter}}" Width="100"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" />
                    <DataGridTextColumn Header="Old Sale" Binding="{Binding OldSalePrice, Converter={StaticResource MoneyConverter}}" Width="100"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" />
                    <DataGridTextColumn Header="New Sale" Binding="{Binding NewSalePrice, Converter={StaticResource MoneyConverter}}" Width="*"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <Button Grid.Row="2"
                Content="Close"
                Command="{Binding CloseCommand}"
                HorizontalAlignment="Right"
                Margin="0,14,0,0"
                Style="{StaticResource SecondaryButtonStyle}" />
    </Grid>
</Window>
