<Window x:Class="ShopPOS.UI.Views.Dialogs.UnhandledExceptionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShopPOS - Error"
        Height="420"
        Width="580"
        MinHeight="350"
        MinWidth="450"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header Icon & Message -->
            <RowDefinition Height="Auto" />
            <!-- Error details textbox -->
            <RowDefinition Height="*" />
            <!-- Action buttons footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource DangerBackgroundBrush}"
                    BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Width="40"
                    Height="40"
                    Margin="0,0,14,0"
                    VerticalAlignment="Top">
                <TextBlock Text="!" FontWeight="Bold" FontSize="20" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="An Unexpected Error Occurred" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                <TextBlock x:Name="MessageTextBlock"
                           Text="ShopPOS encountered an unexpected error. Details have been recorded in the local log files."
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- Details Box -->
        <Border Grid.Row="1"
                Style="{StaticResource SurfaceCardStyle}"
                Padding="10"
                Margin="0,0,0,16">
            <TextBox x:Name="StackTraceTextBox"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas, Courier New, monospace"
                     FontSize="11"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
        </Border>

        <!-- Buttons Footer -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    x:Name="CopyButton"
                    Content="Copy Details"
                    Click="CopyButton_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="14,6"
                    Margin="0,0,8,0" />

            <Button Grid.Column="1"
                    x:Name="OpenLogsButton"
                    Content="Open Log Folder"
                    Click="OpenLogsButton_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="14,6" />

            <Button Grid.Column="3"
                    x:Name="CloseButton"
                    Content="Close"
                    Click="CloseButton_Click"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Padding="20,6" />
        </Grid>
    </Grid>
</Window>

