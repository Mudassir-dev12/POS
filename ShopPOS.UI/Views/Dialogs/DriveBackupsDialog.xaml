<Window x:Class="ShopPOS.UI.Views.Dialogs.DriveBackupsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.Dialogs"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:DriveBackupsDialogViewModel}"
        Title="{Binding Title}"
        Width="780"
        Height="540"
        Style="{DynamicResource DialogWindowStyle}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Border Padding="20" Style="{DynamicResource SurfaceCardStyle}" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="{Binding Title}" Style="{DynamicResource SectionHeaderStyle}" />
                <TextBlock Text="View and restore backups stored in your Google Drive cloud storage folder."
                           Style="{DynamicResource SubTitleStyle}" Margin="0,2,0,0" />
            </StackPanel>

            <!-- Search and Action Strip -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource InputTextBoxStyle}"
                         Tag="Search backups..."
                         Margin="0,0,10,0" />

                <Button Grid.Column="1"
                        Content="Refresh"
                        Command="{Binding LoadBackupsCommand}"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Width="90" />
            </Grid>

            <!-- Backups DataGrid -->
            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding FilteredBackups}"
                      SelectedItem="{Binding SelectedBackup}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Style="{DynamicResource AppDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="BACKUP ARCHIVE"
                                        Binding="{Binding Name}"
                                        Width="*" />

                    <DataGridTextColumn Header="CREATED (LOCAL TIME)"
                                        Binding="{Binding CreatedTimeFormatted}"
                                        Width="170" />

                    <DataGridTextColumn Header="SIZE"
                                        Binding="{Binding SizeFormatted}"
                                        Width="90" />

                    <DataGridTemplateColumn Header="LOCAL STATUS" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4"
                                        Padding="6,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource NeutralBackgroundBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ExistsLocally}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Cloud Only" />
                                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ExistsLocally}" Value="True">
                                                        <Setter Property="Text" Value="Downloaded" />
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Download and Status Section -->
            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                <!-- Progress bar when downloading -->
                <ProgressBar Height="4"
                             Value="{Binding DownloadProgress}"
                             Maximum="100"
                             Foreground="{DynamicResource AccentBrush}"
                             Margin="0,0,0,6"
                             Visibility="{Binding IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!-- Status / Error message -->
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{DynamicResource MutedLabelStyle}"
                           Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}" />

                <Border Background="{DynamicResource DangerBackgroundBrush}"
                        BorderBrush="{DynamicResource DangerBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8"
                        Margin="0,4,0,0"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="12" TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <!-- Bottom Buttons -->
            <Grid Grid.Row="4" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Download &amp; Restore"
                            Command="{Binding DownloadAndRestoreCommand}"
                            Style="{DynamicResource PrimaryButtonStyle}"
                            Padding="16,6"
                            Margin="0,0,10,0" />

                    <Button Content="Close"
                            Command="{Binding CloseCommand}"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Width="90" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

