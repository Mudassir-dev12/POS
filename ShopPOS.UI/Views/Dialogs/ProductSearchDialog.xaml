<Window x:Class="ShopPOS.UI.Views.Dialogs.ProductSearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.Purchases"
        xmlns:dto="clr-namespace:ShopPOS.Core.DTOs;assembly=ShopPOS.Core"
        mc:Ignorable="d"
        Title="Search Product Catalog (F2)"
        Height="550"
        Width="860"
        Style="{StaticResource DialogWindowStyle}"
        Loaded="Window_Loaded">

    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding AddSelectedCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Select Product(s)" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,4" />
        <TextBlock Grid.Row="0" Text="Select products using checkboxes or press Enter on an item, Esc to close" Style="{StaticResource SubTitleStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />

        <!-- Search Input -->
        <Border Grid.Row="1" Style="{StaticResource FilterBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox"
                         Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputTextBoxStyle}"
                         VerticalAlignment="Center">
                    <TextBox.Resources>
                        <VisualBrush x:Key="CueBannerBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                            <VisualBrush.Visual>
                                <TextBlock Text=" Type SKU, Barcode, or Product Name..." Foreground="{DynamicResource TextMutedBrush}" FontSize="13" />
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </TextBox.Resources>
                </TextBox>

                <ProgressBar Grid.Column="1" IsIndeterminate="True" Width="80" Height="4" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </Grid>
        </Border>

        <!-- Product Table -->
        <Border Grid.Row="2" Style="{StaticResource TableContainerBorderStyle}">
            <DataGrid x:Name="ProductGrid"
                      ItemsSource="{Binding Products}"
                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                      Style="{StaticResource AppDataGridStyle}"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      MouseDoubleClick="DataGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <!-- Checkbox Column with Select All in Header -->
                    <DataGridTemplateColumn Width="45">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding DataContext.SelectAll, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsAlreadyInDocument, Converter={StaticResource InverseBooleanConverter}}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="100"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="120"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Product Name" Binding="{Binding Name}" Width="2*" FontWeight="SemiBold" IsReadOnly="True" />

                    <!-- Status Column (shows "Already Added" badge) -->
                    <DataGridTemplateColumn Header="Status" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Visibility="{Binding IsAlreadyInDocument, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Background="{DynamicResource SurfaceCardSubtleBrush}" CornerRadius="3" Padding="6,2" HorizontalAlignment="Center">
                                    <TextBlock Text="Added" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="Bold" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="*" IsReadOnly="True" />
                    <DataGridTextColumn Header="Unit" Binding="{Binding UnitName}" Width="70" IsReadOnly="True" />
                    <DataGridTextColumn Header="Cost Price" Binding="{Binding CostPrice, Converter={StaticResource MoneyConverter}}" Width="100"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Stock" Binding="{Binding CurrentStock, StringFormat='{}{0:0.###}'}" Width="80"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer Buttons -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="Check items or press Enter to add. Products already in document are disabled."
                       Style="{StaticResource MutedLabelStyle}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel (Esc)" Click="Cancel_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                <Button Content="Add Selected" Click="Select_Click" Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
