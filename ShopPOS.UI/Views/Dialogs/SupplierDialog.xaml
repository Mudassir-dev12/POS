<Window x:Class="ShopPOS.UI.Views.Dialogs.SupplierDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DialogTitle}"
        Height="540"
        Width="580"
        Style="{StaticResource DialogWindowStyle}"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,10" BorderBrush="{DynamicResource SeparatorBorderBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="{Binding DialogTitle}" Style="{StaticResource SectionHeaderStyle}" />
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Supplier Name -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Company / Supplier Name *" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                    <TextBox x:Name="FirstField" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                    <TextBlock Text="{Binding NameError}" Foreground="{DynamicResource DangerBrush}" FontSize="11" Margin="0,2,0,0" Visibility="{Binding NameError, Converter={StaticResource StringToVisibilityConverter}}" />
                </StackPanel>

                <!-- Contact Person & Phone -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Contact Person" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Phone Number" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                        <TextBlock Text="{Binding PhoneError}" Foreground="{DynamicResource DangerBrush}" FontSize="11" Margin="0,2,0,0" Visibility="{Binding PhoneError, Converter={StaticResource StringToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>

                <!-- Email & Tax ID -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Email Address" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                        <TextBlock Text="{Binding EmailError}" Foreground="{DynamicResource DangerBrush}" FontSize="11" Margin="0,2,0,0" Visibility="{Binding EmailError, Converter={StaticResource StringToVisibilityConverter}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Tax / VAT Number" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding TaxNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                    </StackPanel>
                </Grid>

                <!-- Address -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Street Address" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                </StackPanel>

                <!-- Opening Balance -->
                <Border Background="{DynamicResource SurfaceCardSubtleBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Opening Balance (Amount We Owe Them)" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Positive value means store payable (we owe vendor). Negative value means store credit." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,6" />
                        <TextBox Text="{Binding OpeningBalance, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.00}'}"
                                 IsEnabled="{Binding CanEditOpeningBalance}"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 Width="180"
                                 HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- Notes -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Internal Notes / Terms" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" Style="{StaticResource InputTextBoxStyle}" />
                </StackPanel>

                <CheckBox Content="Supplier account is active" IsChecked="{Binding IsActive}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding GeneralError}" Foreground="{DynamicResource DangerBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" />
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save (Ctrl+S)"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0,0,8,0" />
            <Button Content="Cancel (Esc)"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
