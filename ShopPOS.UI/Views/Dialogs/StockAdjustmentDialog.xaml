<Window x:Class="ShopPOS.UI.Views.Dialogs.StockAdjustmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:enums="clr-namespace:ShopPOS.Core.Enums;assembly=ShopPOS.Core"
        Title="Stock Adjustment Entry"
        Height="620"
        Width="920"
        MinHeight="500"
        MinWidth="750"
        Style="{StaticResource DialogWindowStyle}">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header Info -->
            <RowDefinition Height="Auto" />
            <!-- Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- Items DataGrid -->
            <RowDefinition Height="*" />
            <!-- Summary & Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource SurfaceCardStyle}" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Number -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,8">
                        <TextBlock Text="Adjustment #" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding AdjustmentNumber}" IsReadOnly="True" Style="{StaticResource InputTextBoxStyle}" />
                    </StackPanel>

                    <!-- Date -->
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,8">
                        <TextBlock Text="Adjustment Date" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                        <DatePicker SelectedDate="{Binding AdjustmentDate}" IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBooleanConverter}}" Padding="6,4" />
                    </StackPanel>

                    <!-- Reason -->
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,12,8">
                        <TextBlock Text="Reason Category *" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                        <ComboBox SelectedItem="{Binding SelectedReason}" IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBooleanConverter}}" Style="{StaticResource InputComboBoxStyle}">
                            <enums:StockAdjustmentReason>CountCorrection</enums:StockAdjustmentReason>
                            <enums:StockAdjustmentReason>Damaged</enums:StockAdjustmentReason>
                            <enums:StockAdjustmentReason>Expired</enums:StockAdjustmentReason>
                            <enums:StockAdjustmentReason>Lost</enums:StockAdjustmentReason>
                            <enums:StockAdjustmentReason>Found</enums:StockAdjustmentReason>
                            <enums:StockAdjustmentReason>Other</enums:StockAdjustmentReason>
                        </ComboBox>
                    </StackPanel>

                    <!-- Notes -->
                    <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,0,8">
                        <TextBlock Text="Notes / Explanation" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}" Style="{StaticResource InputTextBoxStyle}" />
                    </StackPanel>
                </Grid>

                <!-- Status Badge -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border CornerRadius="4" Padding="10,6" Background="{DynamicResource SurfaceCardSubtleBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1">
                        <TextBlock Text="{Binding Status}" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" FontSize="13" HorizontalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Barcode Scanner input for quick counting -->
            <Grid Grid.Column="0" Margin="0,0,16,0">
                <TextBox x:Name="AdjustmentScanBox"
                         Text="{Binding ScanInput, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBooleanConverter}}"
                         Style="{StaticResource InputTextBoxStyle}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ProcessScanInputCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Text=" Scan barcode with USB scanner or type SKU and press Enter to add..."
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Visibility="{Binding ScanInput, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Inverse}" />
            </Grid>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="+ Add Product(s)..."
                        Command="{Binding AddProductLineCommand}"
                        IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBooleanConverter}}"
                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" />
                <Button Content="Remove Selected Lines"
                        Command="{Binding RemoveSelectedLinesCommand}"
                        IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBooleanConverter}}"
                        Style="{StaticResource DangerButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- Items DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource TableContainerBorderStyle}">
            <DataGrid x:Name="ItemsGrid"
                      ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      Style="{StaticResource AppDataGridStyle}"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      RowHeight="36">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <!-- Checkbox Column -->
                    <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="40" />

                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="100"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*" FontWeight="SemiBold" IsReadOnly="True" />
                    <DataGridTextColumn Header="Current Stock" Binding="{Binding SystemQuantity, StringFormat='{}{0:N2}'}" Width="110"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" IsReadOnly="True" />

                    <DataGridTemplateColumn Header="Adjust To *" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox x:Name="NewQuantityBox"
                                         Text="{Binding NewQuantity, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.###}'}"
                                         FontWeight="Bold"
                                         Padding="4,2"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Center"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         GotFocus="NewQuantityBox_GotFocus"
                                         PreviewKeyDown="NewQuantityBox_PreviewKeyDown"
                                         IsReadOnly="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Difference" Binding="{Binding Difference, StringFormat='{}{0:+0.###;-0.###;0}'}" Width="100"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" IsReadOnly="True" />

                    <DataGridTextColumn Header="Cost" Binding="{Binding UnitCost, Converter={StaticResource MoneyConverter}}" Width="100"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" IsReadOnly="True" />

                    <DataGridTextColumn Header="Val Diff" Binding="{Binding LineValueDifference, Converter={StaticResource MoneyConverter}}" Width="110"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" IsReadOnly="True" />

                    <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="140" />

                    <!-- Remove Line Button -->
                    <DataGridTemplateColumn Width="45">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="X" ToolTip="Remove Line"
                                        Command="{Binding DataContext.RemoveLineItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource InverseBooleanConverter}}"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Summary & Footer Buttons -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Error message -->
            <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Command="{Binding CancelCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" />
                <Button Content="Save Draft" Command="{Binding SaveDraftCommand}"
                        Visibility="{Binding IsReadOnly, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" />
                <Button Content="Save &amp; Post" Command="{Binding SaveAndPostCommand}"
                        Visibility="{Binding IsReadOnly, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
