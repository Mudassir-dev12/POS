<Window x:Class="ShopPOS.UI.Views.Dialogs.CustomerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DialogTitle}"
        Height="560"
        Width="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
        Loaded="Window_Loaded">

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <TextBlock Text="{Binding DialogTitle}" FontSize="16" FontWeight="Bold" Foreground="#0F172A" />
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Name -->
                <StackPanel>
                    <TextBlock Text="Customer Full Name *" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                    <TextBox x:Name="FirstField" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="13" />
                    <TextBlock Text="{Binding NameError}" Foreground="#DC2626" FontSize="11" Margin="0,2,0,0" Visibility="{Binding NameError, Converter={StaticResource StringToVisibilityConverter}}" />
                </StackPanel>

                <!-- Phone & Email -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Phone Number (Unique)" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="13" />
                        <TextBlock Text="{Binding PhoneError}" Foreground="#DC2626" FontSize="11" Margin="0,2,0,0" Visibility="{Binding PhoneError, Converter={StaticResource StringToVisibilityConverter}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Email Address" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="13" />
                        <TextBlock Text="{Binding EmailError}" Foreground="#DC2626" FontSize="11" Margin="0,2,0,0" Visibility="{Binding EmailError, Converter={StaticResource StringToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>

                <!-- Default Price Level & Tax Number -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Default Price Level" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding PriceLevels}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="Name"
                                  SelectedValue="{Binding SelectedPriceLevelId}"
                                  Padding="8,6"
                                  FontSize="13" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Tax / VAT Number" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                        <TextBox Text="{Binding TaxNumber, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="13" />
                    </StackPanel>
                </Grid>

                <!-- Credit Limit & Opening Balance -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Credit Limit" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                        <TextBox Text="{Binding CreditLimit, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.00}'}" Padding="8,6" FontSize="13" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Opening Balance (They Owe Us)" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                        <TextBox Text="{Binding OpeningBalance, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.00}'}"
                                 IsEnabled="{Binding CanEditOpeningBalance}"
                                 Padding="8,6"
                                 FontSize="13" />
                    </StackPanel>
                </Grid>

                <!-- Address -->
                <StackPanel>
                    <TextBlock Text="Street Address" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="13" />
                </StackPanel>

                <!-- Notes -->
                <StackPanel>
                    <TextBlock Text="Customer Notes" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="50" TextWrapping="Wrap" Padding="8,6" FontSize="13" />
                </StackPanel>

                <CheckBox Content="Customer profile is active"
                          IsChecked="{Binding IsActive}"
                          IsEnabled="{Binding CanToggleIsActive}"
                          Margin="0,4,0,0" />

                <TextBlock Text="{Binding GeneralError}" Foreground="#DC2626" FontSize="12" FontWeight="SemiBold" />
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save (Ctrl+S)"
                    Command="{Binding SaveCommand}"
                    Background="#2563EB"
                    Foreground="White"
                    FontWeight="Bold"
                    Padding="18,8"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,0,8,0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="Cancel (Esc)"
                    Command="{Binding CancelCommand}"
                    Background="#E2E8F0"
                    Foreground="#334155"
                    FontWeight="SemiBold"
                    Padding="16,8"
                    BorderThickness="0"
                    Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
