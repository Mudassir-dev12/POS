<Window x:Class="ShopPOS.UI.Views.Dialogs.PurchaseReturnDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.PurchaseReturns"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="640"
        Width="880"
        Style="{StaticResource DialogWindowStyle}">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Error Banner -->
            <RowDefinition Height="Auto" />
            <!-- Header Inputs -->
            <RowDefinition Height="Auto" />
            <!-- Line Items Table -->
            <RowDefinition Height="*" />
            <!-- Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10" />

        <!-- Error Banner -->
        <Border Grid.Row="1" Background="{DynamicResource DangerBackgroundBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" FontSize="12" />
        </Border>

        <!-- Header Inputs -->
        <Border Grid.Row="2" Style="{StaticResource FilterBarStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>

                <!-- Supplier -->
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="VENDOR / SUPPLIER *" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Suppliers}"
                              SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              Style="{StaticResource InputComboBoxStyle}" />
                </StackPanel>

                <!-- Invoice -->
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="LOAD ITEMS FROM INVOICE" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Invoices}"
                              SelectedItem="{Binding SelectedInvoice, Mode=TwoWay}"
                              DisplayMemberPath="PurchaseNumber"
                              Style="{StaticResource InputComboBoxStyle}" />
                </StackPanel>

                <!-- Return Date -->
                <StackPanel Grid.Row="0" Grid.Column="4">
                    <TextBlock Text="RETURN DATE *" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                    <DatePicker SelectedDate="{Binding ReturnDate, Mode=TwoWay}"
                                Padding="6,4"
                                FontSize="13" />
                </StackPanel>

                <!-- Reason / Notes -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,10,0,0">
                    <TextBlock Text="RETURN REASON / NOTES *" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBoxStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Line Items Table -->
        <Border Grid.Row="3" Style="{StaticResource TableContainerBorderStyle}">
            <DataGrid ItemsSource="{Binding LineItems}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      RowHeight="36"
                      Style="{StaticResource AppDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" IsReadOnly="True" Width="2*" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="Unit Cost" Binding="{Binding UnitCost, Converter={StaticResource MoneyConverter}}" IsReadOnly="True" Width="100"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" />
                    <DataGridTextColumn Header="Purchased" Binding="{Binding PurchasedQuantity, StringFormat='{}{0:0.###}'}" IsReadOnly="True" Width="90"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" />
                    <DataGridTextColumn Header="Returnable" Binding="{Binding ReturnableQuantity, StringFormat='{}{0:0.###}'}" IsReadOnly="True" Width="90"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" />

                    <!-- Editable Return Quantity -->
                    <DataGridTextColumn Header="Return Qty"
                                        Binding="{Binding ReturnQuantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.###}'}"
                                        Width="100" ElementStyle="{StaticResource MonospaceNumericCell}" />

                    <DataGridTextColumn Header="Line Total" Binding="{Binding LineTotal, Converter={StaticResource MoneyConverter}}" IsReadOnly="True" Width="110"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="4" Margin="0,14,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="TOTAL RETURN CREDIT: " Style="{StaticResource MutedLabelStyle}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TotalAmount, Converter={StaticResource MoneyConverter}}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" />
                    <Button Content="Post Return (Debit Note)" Command="{Binding PostReturnCommand}" Style="{StaticResource DangerButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
