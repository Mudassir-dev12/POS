<Window x:Class="ShopPOS.UI.Views.Dialogs.DataResetConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.Dialogs"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:DataResetConfirmDialogViewModel}"
        Title="{Binding Title}"
        Width="560"
        MinHeight="450"
        MaxHeight="700"
        SizeToContent="Height"
        Style="{DynamicResource DialogWindowStyle}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Border Padding="20" Style="{DynamicResource SurfaceCardStyle}" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Header & Warning (Fixed at top) -->
                <RowDefinition Height="Auto" />
                <!-- Row 1: Tables List (Scrollable if many rows) -->
                <RowDefinition Height="*" />
                <!-- Row 2: Confirmation Input & Buttons (Fixed at bottom) -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ================= ROW 0: HEADER & WARNING ================= -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="{Binding Title}" Style="{DynamicResource SectionHeaderStyle}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding ActionName}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,10" />

                <!-- Warning Card -->
                <Border Background="{DynamicResource DangerBackgroundBrush}"
                        BorderBrush="{DynamicResource DangerBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="WARNING: PERMANENT DATA ACTION" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="0,0,0,3" />
                        <TextBlock Text="{Binding WarningMessage}" Style="{DynamicResource SubTitleStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="An automatic database backup file will be created before proceeding. If backup fails, the operation aborts."
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ================= ROW 1: TABLES COMPARISON ================= -->
            <ScrollViewer Grid.Row="1" MaxHeight="160" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Deleting Column -->
                    <Border Grid.Column="0" Background="{DynamicResource SurfaceCardSubtleBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="WHAT WILL BE DELETED" Style="{DynamicResource MutedLabelStyle}" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding TablesToDelete}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TableName}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Count}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Keeping Column -->
                    <Border Grid.Column="2" Background="{DynamicResource SurfaceCardSubtleBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="WHAT WILL BE KEPT" Style="{DynamicResource MutedLabelStyle}" Foreground="{DynamicResource SuccessTextBrush}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding TablesToKeep}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- ================= ROW 2: CONFIRMATION INPUT & ACTION BUTTONS ================= -->
            <StackPanel Grid.Row="2">
                <!-- Typed Confirmation Input -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="TYPE RESET TO CONFIRM:" Style="{DynamicResource MutedLabelStyle}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding ConfirmationInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource InputTextBoxStyle}"
                             FontSize="14"
                             FontWeight="Bold"
                             Padding="10,7" />
                    <TextBlock Text="Type the exact word RESET in capital letters to unlock the confirm button."
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,10,0" Padding="16,8" />
                    <Button Content="Reset &amp; Execute" Command="{Binding ConfirmCommand}" IsEnabled="{Binding CanConfirm}" Style="{DynamicResource DangerButtonStyle}" Padding="16,8" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
