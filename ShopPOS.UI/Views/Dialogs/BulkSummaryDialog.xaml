<Window x:Class="ShopPOS.UI.Views.Dialogs.BulkSummaryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bulk Operation Summary"
        Width="580"
        Height="420"
        Style="{StaticResource DialogWindowStyle}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource SurfaceCardStyle}" Padding="16,12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="Bulk Action Complete" Style="{StaticResource SectionHeaderStyle}" />
                <TextBlock x:Name="SummaryText" Text="9 deleted, 3 skipped." Style="{StaticResource SubTitleStyle}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Skipped items grid -->
        <Border Grid.Row="1" Style="{StaticResource TableContainerBorderStyle}">
            <Grid>
                <DataGrid x:Name="SkippedGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          IsReadOnly="True" Style="{StaticResource AppDataGridStyle}" RowHeight="36">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Item / Identifier" Binding="{Binding Identifier}" Width="160" FontWeight="SemiBold"
                                            ElementStyle="{StaticResource MonospaceNumericCell}" />
                        <DataGridTextColumn Header="Reason / Note" Binding="{Binding Message}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="AllSucceededText" Text="All selected items were processed successfully."
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SuccessTextBrush}" FontWeight="Bold" FontSize="14" Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- Footer Buttons -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Button Content="Copy List to Clipboard" Click="Copy_Click" HorizontalAlignment="Left" Style="{StaticResource ToolbarButtonStyle}" Height="36" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="DeactivateBtn" Content="Deactivate In-Use Items" Click="Deactivate_Click"
                        Visibility="Collapsed" Margin="0,0,10,0" Padding="14,0" Height="36"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button Content="Close" Click="Close_Click" Style="{StaticResource PrimaryButtonStyle}" Width="90" Height="36" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
