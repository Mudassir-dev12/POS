<Window x:Class="ShopPOS.UI.Views.Dialogs.ProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DialogTitle}"
        Height="620"
        Width="780"
        MinHeight="550"
        MinWidth="700"
        Style="{StaticResource DialogWindowStyle}"
        Loaded="Window_Loaded">

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Tabs / Form Body -->
            <RowDefinition Height="*" />
            <!-- Footer Buttons -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,12" BorderBrush="{DynamicResource SeparatorBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding DialogTitle}" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Fill in catalog details across the tabs below. Press Ctrl+S to save." Style="{StaticResource SubTitleStyle}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding BarcodeWarning}" Foreground="{DynamicResource WarningTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Main Form Tabs -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Padding" Value="16,8" />
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: GENERAL -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <!-- Name -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Product Name *" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                            <TextBox x:Name="FirstField" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                            <TextBlock Text="{Binding NameError}" Foreground="{DynamicResource DangerBrush}" FontSize="11" Margin="0,2,0,0" Visibility="{Binding NameError, Converter={StaticResource StringToVisibilityConverter}}" />
                        </StackPanel>

                        <!-- SKU & Barcode Grid -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- SKU -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SKU (Leave blank to auto-generate)" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                                <TextBlock Text="{Binding SkuError}" Foreground="{DynamicResource DangerBrush}" FontSize="11" Margin="0,2,0,0" Visibility="{Binding SkuError, Converter={StaticResource StringToVisibilityConverter}}" />
                            </StackPanel>
                            <!-- Primary Barcode -->
                            <StackPanel Grid.Column="2">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Primary Barcode (UPC/EAN)" Style="{StaticResource MutedLabelStyle}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="Auto (EAN)" Command="{Binding AutoGenerateEanBarcodeCommand}"
                                                ToolTip="Generate unique standard EAN-13 barcode"
                                                Style="{StaticResource GhostButtonStyle}" Padding="6,2" FontSize="11" Margin="0,0,4,0" />
                                        <Button Content="Auto (Code 128)" Command="{Binding AutoGenerateCode128BarcodeCommand}"
                                                ToolTip="Generate unique Code 128 barcode"
                                                Style="{StaticResource GhostButtonStyle}" Padding="6,2" FontSize="11" Margin="0,0,4,0" />
                                        <Button Content="Print Label" Command="{Binding PrintBarcodeLabelCommand}"
                                                ToolTip="Print barcode label sheet"
                                                Style="{StaticResource SecondaryButtonStyle}" Padding="6,2" FontSize="11" />
                                    </StackPanel>
                                </Grid>
                                <TextBox x:Name="BarcodeTextBox"
                                         Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         PreviewKeyDown="BarcodeTextBox_PreviewKeyDown" />
                                <TextBlock Text="{Binding BarcodeWarning}" Foreground="{DynamicResource DangerBrush}" FontSize="11" Margin="0,2,0,0" Visibility="{Binding BarcodeWarning, Converter={StaticResource StringToVisibilityConverter}}" />
                            </StackPanel>
                        </Grid>

                        <!-- Opening Stock on Create Mode -->
                        <Border Background="{DynamicResource SurfaceCardSubtleBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12"
                                Visibility="{Binding IsCreateMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Initial Opening Stock (Quantity on Hand)" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="Sets starting stock. An Opening movement will be logged atomically in the ledger at cost price." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                                <TextBox Grid.Column="1" Text="{Binding OpeningQuantity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" Width="120" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Stock Info on Edit Mode -->
                        <Border Background="{DynamicResource SurfaceCardSubtleBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12"
                                Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Current Stock on Hand" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="To adjust stock count on hand, switch to the 'Stock &amp; Ledger' tab." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding CurrentStock, StringFormat='{}{0:0.###} in stock'}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource SuccessTextBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Category, Brand, Unit Grid -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Category -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Category *" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Categories}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="Name"
                                          SelectedValue="{Binding SelectedCategoryId}"
                                          Style="{StaticResource InputComboBoxStyle}" />
                                <TextBlock Text="{Binding CategoryError}" Foreground="{DynamicResource DangerBrush}" FontSize="11" Margin="0,2,0,0" Visibility="{Binding CategoryError, Converter={StaticResource StringToVisibilityConverter}}" />
                            </StackPanel>

                            <!-- Brand -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Brand (Optional)" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Brands}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="Name"
                                          SelectedValue="{Binding SelectedBrandId}"
                                          Style="{StaticResource InputComboBoxStyle}" />
                            </StackPanel>

                            <!-- Unit -->
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Unit of Measure *" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Units}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="Name"
                                          SelectedValue="{Binding SelectedUnitId}"
                                          Style="{StaticResource InputComboBoxStyle}" />
                                <TextBlock Text="{Binding UnitError}" Foreground="{DynamicResource DangerBrush}" FontSize="11" Margin="0,2,0,0" Visibility="{Binding UnitError, Converter={StaticResource StringToVisibilityConverter}}" />
                            </StackPanel>
                        </Grid>

                        <!-- Description -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Product Description" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="80"
                                     Style="{StaticResource InputTextBoxStyle}" />
                        </StackPanel>

                        <!-- Active Toggle -->
                        <CheckBox Content="Product is active and available for trade" IsChecked="{Binding IsActive}" Margin="0,4,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: PRICING -->
            <TabItem Header="Pricing">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Cost Price -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Cost Price *" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding CostPrice, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.00}'}" Style="{StaticResource InputTextBoxStyle}" />
                                <TextBlock Text="{Binding CostPriceError}" Foreground="{DynamicResource DangerBrush}" FontSize="11" Margin="0,2,0,0" Visibility="{Binding CostPriceError, Converter={StaticResource StringToVisibilityConverter}}" />
                            </StackPanel>

                            <!-- Sale Price -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Standard Sale Price *" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding SalePrice, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.00}'}" Style="{StaticResource InputTextBoxStyle}" />
                                <TextBlock Text="{Binding SalePriceError}" Foreground="{DynamicResource DangerBrush}" FontSize="11" Margin="0,2,0,0" Visibility="{Binding SalePriceError, Converter={StaticResource StringToVisibilityConverter}}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Min Sale Price -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Minimum Floor Sale Price" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding MinSalePrice, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.00}'}" Style="{StaticResource InputTextBoxStyle}" />
                                <TextBlock Text="{Binding MinSalePriceError}" Foreground="{DynamicResource DangerBrush}" FontSize="11" Margin="0,2,0,0" Visibility="{Binding MinSalePriceError, Converter={StaticResource StringToVisibilityConverter}}" />
                            </StackPanel>

                            <!-- Tax Percent -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Tax Rate (%)" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding TaxPercent, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.00}'}" Style="{StaticResource InputTextBoxStyle}" />
                            </StackPanel>
                        </Grid>

                        <!-- Price Levels Grid -->
                        <TextBlock Text="Tier Pricing (Optional Level Pricing)" Style="{StaticResource SectionHeaderStyle}" Margin="0,10,0,4" />
                        <Border Style="{StaticResource TableContainerBorderStyle}">
                            <DataGrid ItemsSource="{Binding ProductPrices}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      Style="{StaticResource AppDataGridStyle}"
                                      RowHeight="36">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Pricing Level" Binding="{Binding PriceLevelName}" IsReadOnly="True" Width="200" />
                                    <DataGridTextColumn Header="Special Price" Binding="{Binding Price, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.00}'}" Width="*"
                                                        ElementStyle="{StaticResource MonospaceNumericCell}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: BARCODES -->
            <TabItem Header="Barcodes">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Primary Barcode -->
                    <Border Grid.Row="0" Style="{StaticResource SurfaceCardStyle}" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Primary Barcode" Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock Text="This barcode appears in the products table and is scanned by default." Style="{StaticResource SubTitleStyle}" Margin="0,2,0,6" />
                            <TextBox Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     PreviewKeyDown="BarcodeTextBox_PreviewKeyDown" />
                            <TextBlock Text="{Binding BarcodeWarning}" Foreground="{DynamicResource WarningTextBrush}" FontSize="11" Margin="0,4,0,0"
                                       Visibility="{Binding BarcodeWarning, Converter={StaticResource StringToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>

                    <!-- Add Barcode Input -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding NewAdditionalBarcode, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="BarcodeTextBox_PreviewKeyDown"
                                 Style="{StaticResource InputTextBoxStyle}" />
                        <Button Grid.Column="2"
                                Content="+ Add Barcode"
                                Command="{Binding AddAdditionalBarcodeCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>

                    <!-- Alternate Barcodes List -->
                    <Border Grid.Row="2" Style="{StaticResource TableContainerBorderStyle}">
                        <ListBox ItemsSource="{Binding AdditionalBarcodes}" BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" FontWeight="Medium"
                                                   FontFamily="{StaticResource AppMonospaceFontFamily}" />
                                        <Button Grid.Column="1"
                                                Content="Set as Primary"
                                                Command="{Binding DataContext.SetAsPrimaryBarcodeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Grid.Column="3"
                                                Content="Remove"
                                                Command="{Binding DataContext.RemoveAdditionalBarcodeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DangerButtonStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 4: STOCK -->
            <TabItem Header="Stock &amp; Ledger">
                <StackPanel Margin="0,12,0,0">
                    <!-- Opening Quantity (Shown ONLY when creating a new product) -->
                    <Border Background="{DynamicResource SurfaceCardSubtleBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14"
                            Visibility="{Binding IsCreateMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Initial Opening Stock Quantity" Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock Text="Enter the initial physical quantity on hand. An initial Opening StockMovement will be created atomically in the ledger at cost price." Style="{StaticResource SubTitleStyle}" Margin="0,2,0,8" />
                            <TextBox Text="{Binding OpeningQuantity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" Width="200" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <!-- Stock Adjustment (Shown when EDITING an existing product) -->
                    <Border Background="{DynamicResource SurfaceCardSubtleBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14"
                            Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Inventory Stock Adjustment" Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock Text="Current recorded stock is shown on the left. To change physical stock on hand, enter the new verified quantity on the right. An Adjustment StockMovement will be recorded in the ledger." Style="{StaticResource SubTitleStyle}" Margin="0,2,0,10" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Current Stock (Read-Only) -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Current Stock on Hand" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding CurrentStock, StringFormat='{}{0:0.###}', Mode=OneWay}" IsReadOnly="True" Style="{StaticResource InputTextBoxStyle}" Width="180" HorizontalAlignment="Left" />
                                </StackPanel>

                                <!-- New Adjusted Stock -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Adjust Stock Quantity To *" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding AdjustedStock, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" FontWeight="Bold" Width="180" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Grid>

                            <!-- Adjustment Note -->
                            <StackPanel>
                                <TextBlock Text="Adjustment Reason / Note (Required when changing stock) *" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding StockAdjustmentNote, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                                <TextBlock Text="{Binding StockAdjustmentError}" Foreground="{DynamicResource DangerBrush}" FontSize="11" Margin="0,2,0,0"
                                           Visibility="{Binding StockAdjustmentError, Converter={StaticResource StringToVisibilityConverter}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Reorder Level -->
                    <Border Style="{StaticResource SurfaceCardStyle}" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Low Stock Reorder Alert Level" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,2" />
                            <TextBlock Text="When stock on hand drops to or below this level, a warning badge appears in the catalog list." Style="{StaticResource SubTitleStyle}" Margin="0,0,0,8" />
                            <TextBox Text="{Binding ReorderLevel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" Width="200" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <!-- Inventory Toggles -->
                    <CheckBox Content="Track inventory movements for this product" IsChecked="{Binding TrackStock}" FontWeight="SemiBold" Margin="0,4" />
                    <CheckBox Content="Product is sold by weight (requires scale integration)" IsChecked="{Binding IsWeighable}" Margin="0,4" />
                    <CheckBox Content="Allow decimal quantities (e.g. 1.250 kg)" IsChecked="{Binding AllowDecimalQuantity}" Margin="0,4" />
                </StackPanel>
            </TabItem>

            <!-- TAB 5: IMAGE -->
            <TabItem Header="Product Image">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                        <Button Content="Browse Image..."
                                Command="{Binding BrowseImageCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,10,0" />
                        <TextBlock Text="{Binding ImagePath}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontStyle="Italic" />
                    </StackPanel>

                    <!-- Preview Frame -->
                    <Border Grid.Row="1" Style="{StaticResource SurfaceCardStyle}" Padding="10">
                        <Image Source="{Binding FullImagePreviewPath}" Stretch="Uniform" MaxHeight="300" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="0,12,0,0" BorderBrush="{DynamicResource SeparatorBorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock Text="{Binding GeneralError}" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Save (Ctrl+S)"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,10,0" />
                    <Button Content="Cancel (Esc)"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
