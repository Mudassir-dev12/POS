<Window x:Class="ShopPOS.UI.Views.Dialogs.ProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DialogTitle}"
        Height="620"
        Width="780"
        MinHeight="550"
        MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
        Loaded="Window_Loaded">

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Tabs / Form Body -->
            <RowDefinition Height="*" />
            <!-- Footer Buttons -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding DialogTitle}" FontSize="18" FontWeight="Bold" Foreground="#0F172A" />
                    <TextBlock Text="Fill in catalog details across the tabs below. Press Ctrl+S to save." FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding BarcodeWarning}" Foreground="#D97706" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Main Form Tabs -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Padding" Value="16,8" />
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: GENERAL -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <!-- Name -->
                        <StackPanel>
                            <TextBlock Text="Product Name *" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                            <TextBox x:Name="FirstField" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="13" />
                            <TextBlock Text="{Binding NameError}" Foreground="#DC2626" FontSize="11" Margin="0,2,0,0" Visibility="{Binding NameError, Converter={StaticResource StringToVisibilityConverter}}" />
                        </StackPanel>

                        <!-- SKU & Barcode Grid -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- SKU -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SKU (Leave blank to auto-generate)" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="13" />
                                <TextBlock Text="{Binding SkuError}" Foreground="#DC2626" FontSize="11" Margin="0,2,0,0" Visibility="{Binding SkuError, Converter={StaticResource StringToVisibilityConverter}}" />
                            </StackPanel>
                            <!-- Primary Barcode -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Primary Barcode (UPC/EAN)" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                                <TextBox x:Name="BarcodeTextBox"
                                         Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6"
                                         FontSize="13"
                                         PreviewKeyDown="BarcodeTextBox_PreviewKeyDown" />
                            </StackPanel>
                        </Grid>

                        <!-- Opening Stock on Create Mode -->
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6"
                                Visibility="{Binding IsCreateMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Initial Opening Stock (Quantity on Hand)" FontWeight="SemiBold" Foreground="#1E40AF" />
                                    <TextBlock Text="Sets starting stock. An Opening movement will be logged atomically in the ledger at cost price." FontSize="11" Foreground="#3B82F6" />
                                </StackPanel>
                                <TextBox Grid.Column="1" Text="{Binding OpeningQuantity, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="13" Width="120" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Stock Info on Edit Mode -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6"
                                Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Current Stock on Hand" FontWeight="SemiBold" Foreground="#334155" />
                                    <TextBlock Text="To adjust stock count on hand, switch to the 'Stock &amp; Ledger' tab." FontSize="11" Foreground="#64748B" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding CurrentStock, StringFormat='{}{0:0.###} in stock'}" FontWeight="Bold" FontSize="13" Foreground="#16A34A" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Category, Brand, Unit Grid -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Category -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Category *" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Categories}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="Name"
                                          SelectedValue="{Binding SelectedCategoryId}"
                                          Padding="8,6"
                                          FontSize="13" />
                                <TextBlock Text="{Binding CategoryError}" Foreground="#DC2626" FontSize="11" Margin="0,2,0,0" Visibility="{Binding CategoryError, Converter={StaticResource StringToVisibilityConverter}}" />
                            </StackPanel>

                            <!-- Brand -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Brand (Optional)" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Brands}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="Name"
                                          SelectedValue="{Binding SelectedBrandId}"
                                          Padding="8,6"
                                          FontSize="13" />
                            </StackPanel>

                            <!-- Unit -->
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Unit of Measure *" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Units}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="Name"
                                          SelectedValue="{Binding SelectedUnitId}"
                                          Padding="8,6"
                                          FontSize="13" />
                                <TextBlock Text="{Binding UnitError}" Foreground="#DC2626" FontSize="11" Margin="0,2,0,0" Visibility="{Binding UnitError, Converter={StaticResource StringToVisibilityConverter}}" />
                            </StackPanel>
                        </Grid>

                        <!-- Description -->
                        <StackPanel>
                            <TextBlock Text="Product Description" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="80"
                                     Padding="8,6"
                                     FontSize="13" />
                        </StackPanel>

                        <!-- Active Toggle -->
                        <CheckBox Content="Product is active and available for trade" IsChecked="{Binding IsActive}" Margin="0,4,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: PRICING -->
            <TabItem Header="Pricing">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Cost Price -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Cost Price *" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                                <TextBox Text="{Binding CostPrice, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.00}'}" Padding="8,6" FontSize="13" />
                                <TextBlock Text="{Binding CostPriceError}" Foreground="#DC2626" FontSize="11" Margin="0,2,0,0" Visibility="{Binding CostPriceError, Converter={StaticResource StringToVisibilityConverter}}" />
                            </StackPanel>

                            <!-- Sale Price -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Standard Sale Price *" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                                <TextBox Text="{Binding SalePrice, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.00}'}" Padding="8,6" FontSize="13" />
                                <TextBlock Text="{Binding SalePriceError}" Foreground="#DC2626" FontSize="11" Margin="0,2,0,0" Visibility="{Binding SalePriceError, Converter={StaticResource StringToVisibilityConverter}}" />
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Min Sale Price -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Minimum Floor Sale Price" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                                <TextBox Text="{Binding MinSalePrice, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.00}'}" Padding="8,6" FontSize="13" />
                                <TextBlock Text="{Binding MinSalePriceError}" Foreground="#DC2626" FontSize="11" Margin="0,2,0,0" Visibility="{Binding MinSalePriceError, Converter={StaticResource StringToVisibilityConverter}}" />
                            </StackPanel>

                            <!-- Tax Percent -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Tax Rate (%)" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                                <TextBox Text="{Binding TaxPercent, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.00}'}" Padding="8,6" FontSize="13" />
                            </StackPanel>
                        </Grid>

                        <!-- Price Levels Grid -->
                        <TextBlock Text="Tier Pricing (Optional Level Pricing)" FontWeight="Bold" Foreground="#0F172A" Margin="0,10,0,4" />
                        <DataGrid ItemsSource="{Binding ProductPrices}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  Background="White"
                                  BorderBrush="#CBD5E1"
                                  BorderThickness="1"
                                  RowHeight="36">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Pricing Level" Binding="{Binding PriceLevelName}" IsReadOnly="True" Width="200" />
                                <DataGridTextColumn Header="Special Price" Binding="{Binding Price, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.00}'}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: BARCODES -->
            <TabItem Header="Barcodes">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Primary Barcode -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Primary Barcode" FontWeight="Bold" Foreground="#0F172A" />
                            <TextBlock Text="This barcode appears in the products table and is scanned by default." FontSize="11" Foreground="#64748B" Margin="0,2,0,6" />
                            <TextBox Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6"
                                     FontSize="13"
                                     PreviewKeyDown="BarcodeTextBox_PreviewKeyDown" />
                            <TextBlock Text="{Binding BarcodeWarning}" Foreground="#D97706" FontSize="11" Margin="0,4,0,0"
                                       Visibility="{Binding BarcodeWarning, Converter={StaticResource StringToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>

                    <!-- Add Barcode Input -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding NewAdditionalBarcode, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="BarcodeTextBox_PreviewKeyDown"
                                 Padding="8,6"
                                 FontSize="13" />
                        <Button Grid.Column="2"
                                Content="+ Add Barcode"
                                Command="{Binding AddAdditionalBarcodeCommand}"
                                Background="#2563EB"
                                Foreground="White"
                                Padding="14,6"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Cursor="Hand" />
                    </Grid>

                    <!-- Alternate Barcodes List -->
                    <Border Grid.Row="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
                        <ListBox ItemsSource="{Binding AdditionalBarcodes}" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" FontWeight="Medium" />
                                        <Button Grid.Column="1"
                                                Content="★ Set as Primary"
                                                Command="{Binding DataContext.SetAsPrimaryBarcodeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Foreground="#2563EB"
                                                Background="#EFF6FF"
                                                Padding="8,4"
                                                BorderThickness="1"
                                                BorderBrush="#BFDBFE"
                                                Cursor="Hand" />
                                        <Button Grid.Column="3"
                                                Content="Remove"
                                                Command="{Binding DataContext.RemoveAdditionalBarcodeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Foreground="#DC2626"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 4: STOCK -->
            <TabItem Header="Stock &amp; Ledger">
                <StackPanel Margin="0,12,0,0">
                    <!-- Opening Quantity (Shown ONLY when creating a new product) -->
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14"
                            Visibility="{Binding IsCreateMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Initial Opening Stock Quantity" FontSize="14" FontWeight="Bold" Foreground="#1E40AF" />
                            <TextBlock Text="Enter the initial physical quantity on hand. An initial Opening StockMovement will be created atomically in the ledger at cost price." FontSize="11" Foreground="#3B82F6" Margin="0,2,0,8" />
                            <TextBox Text="{Binding OpeningQuantity, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="14" Width="200" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <!-- Stock Adjustment (Shown when EDITING an existing product) -->
                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14"
                            Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Inventory Stock Adjustment" FontSize="14" FontWeight="Bold" Foreground="#166534" />
                            <TextBlock Text="Current recorded stock is shown on the left. To change physical stock on hand, enter the new verified quantity on the right. An Adjustment StockMovement will be recorded in the ledger." FontSize="11" Foreground="#15803D" Margin="0,2,0,10" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Current Stock (Read-Only) -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Current Stock on Hand" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding CurrentStock, StringFormat='{}{0:0.###}', Mode=OneWay}" IsReadOnly="True" Background="#F1F5F9" Padding="8,6" FontSize="13" Width="180" HorizontalAlignment="Left" />
                                </StackPanel>

                                <!-- New Adjusted Stock -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Adjust Stock Quantity To *" FontWeight="SemiBold" Foreground="#166534" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding AdjustedStock, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="14" FontWeight="Bold" Width="180" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Grid>

                            <!-- Adjustment Note -->
                            <StackPanel>
                                <TextBlock Text="Adjustment Reason / Note (Required when changing stock) *" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                                <TextBox Text="{Binding StockAdjustmentNote, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="13" />
                                <TextBlock Text="{Binding StockAdjustmentError}" Foreground="#DC2626" FontSize="11" Margin="0,2,0,0"
                                           Visibility="{Binding StockAdjustmentError, Converter={StaticResource StringToVisibilityConverter}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Reorder Level -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Low Stock Reorder Alert Level" FontSize="14" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,2" />
                            <TextBlock Text="When stock on hand drops to or below this level, a warning badge appears in the catalog list." FontSize="11" Foreground="#64748B" Margin="0,0,0,8" />
                            <TextBox Text="{Binding ReorderLevel, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="13" Width="200" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <!-- Inventory Toggles -->
                    <CheckBox Content="Track inventory movements for this product" IsChecked="{Binding TrackStock}" FontWeight="SemiBold" Margin="0,4" />
                    <CheckBox Content="Product is sold by weight (requires scale integration)" IsChecked="{Binding IsWeighable}" Margin="0,4" />
                    <CheckBox Content="Allow decimal quantities (e.g. 1.250 kg)" IsChecked="{Binding AllowDecimalQuantity}" Margin="0,4" />
                </StackPanel>
            </TabItem>

            <!-- TAB 5: IMAGE -->
            <TabItem Header="Product Image">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                        <Button Content="Browse Image..."
                                Command="{Binding BrowseImageCommand}"
                                Background="#0284C7"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Padding="14,8"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="0,0,10,0" />
                        <TextBlock Text="{Binding ImagePath}" VerticalAlignment="Center" Foreground="#64748B" FontStyle="Italic" />
                    </StackPanel>

                    <!-- Preview Frame -->
                    <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="10">
                        <Image Source="{Binding FullImagePreviewPath}" Stretch="Uniform" MaxHeight="300" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="0,12,0,0" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock Text="{Binding GeneralError}" Foreground="#DC2626" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Save (Ctrl+S)"
                            Command="{Binding SaveCommand}"
                            Background="#2563EB"
                            Foreground="White"
                            FontWeight="Bold"
                            Padding="20,10"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,0,10,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="Cancel (Esc)"
                            Command="{Binding CancelCommand}"
                            Background="#E2E8F0"
                            Foreground="#334155"
                            FontWeight="SemiBold"
                            Padding="20,10"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
