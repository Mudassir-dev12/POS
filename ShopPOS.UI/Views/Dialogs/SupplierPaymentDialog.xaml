<Window x:Class="ShopPOS.UI.Views.Dialogs.SupplierPaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:enums="clr-namespace:ShopPOS.Core.Enums;assembly=ShopPOS.Core"
        xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.SupplierPayments"
        xmlns:dto="clr-namespace:ShopPOS.Core.DTOs;assembly=ShopPOS.Core"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="540"
        Width="520"
        Style="{DynamicResource DialogWindowStyle}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <ObjectDataProvider x:Key="PaymentMethods" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:PaymentMethod" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{DynamicResource SectionHeaderStyle}" Margin="0,0,0,12" />

        <!-- Error Banner -->
        <Border Grid.Row="1" Background="{DynamicResource DangerBackgroundBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerTextBrush}" FontWeight="SemiBold" FontSize="12" />
        </Border>

        <!-- Form Body -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Vendor / Supplier -->
                <TextBlock Text="VENDOR / SUPPLIER *" Style="{DynamicResource FormLabelStyle}" />
                <ComboBox ItemsSource="{Binding Suppliers}"
                          SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          Margin="0,0,0,12" />

                <!-- Outstanding Invoice Picker (Optional) -->
                <TextBlock Text="APPLY TO INVOICE (OPTIONAL)" Style="{DynamicResource FormLabelStyle}" />
                <ComboBox ItemsSource="{Binding Invoices}"
                          SelectedItem="{Binding SelectedInvoice, Mode=TwoWay}"
                          Margin="0,0,0,12">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding PurchaseNumber}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="  •  Due: " Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding DueDate, StringFormat='{}{0:yyyy-MM-dd}', TargetNullValue='No due date'}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="  •  Balance: " Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding Balance, Converter={StaticResource MoneyConverter}}" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Amount & Date -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="PAYMENT AMOUNT *" Style="{DynamicResource FormLabelStyle}" />
                        <TextBox Text="{Binding Amount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.00}'}"
                                 FontWeight="Bold" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="PAYMENT DATE *" Style="{DynamicResource FormLabelStyle}" />
                        <DatePicker SelectedDate="{Binding PaymentDate, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>

                <!-- Method & Reference -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="PAYMENT METHOD *" Style="{DynamicResource FormLabelStyle}" />
                        <ComboBox SelectedItem="{Binding Method, Mode=TwoWay}"
                                  ItemsSource="{Binding Source={StaticResource PaymentMethods}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="REFERENCE #" Style="{DynamicResource FormLabelStyle}" />
                        <TextBox Text="{Binding Reference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <!-- Notes -->
                <TextBlock Text="NOTES / MEMO" Style="{DynamicResource FormLabelStyle}" />
                <TextBox Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         Height="60"
                         TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,10,0" />
            <Button Content="Record Payment" Command="{Binding SaveCommand}" Style="{DynamicResource SuccessButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
