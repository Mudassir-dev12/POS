<Window x:Class="ShopPOS.UI.Views.Dialogs.BackupPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.Dialogs"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:BackupPasswordDialogViewModel}"
        Title="{Binding Title}"
        Width="460"
        SizeToContent="Height"
        Style="{DynamicResource DialogWindowStyle}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Border Padding="20" Style="{DynamicResource SurfaceCardStyle}" Margin="10">
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{DynamicResource SectionHeaderStyle}" Margin="0,0,0,8" />

            <!-- Warning Callout -->
            <Border Background="{DynamicResource DangerBackgroundBrush}"
                    BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,10"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="CRITICAL SECURITY NOTICE" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="0,0,0,3" />
                    <TextBlock Text="If you lose this password, backups cannot be restored. For security, your password is never stored on disk. Please write it down and keep it in a secure location."
                               Style="{DynamicResource SubTitleStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Error Banner -->
            <Border Background="{DynamicResource DangerBackgroundBrush}"
                    BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8"
                    Margin="0,0,0,10"
                    Visibility="{Binding ValidationError, Converter={StaticResource StringToVisibilityConverter}}">
                <TextBlock Text="{Binding ValidationError}" Foreground="{DynamicResource DangerBrush}" FontSize="12" TextWrapping="Wrap" />
            </Border>

            <!-- Current Password (if changing) -->
            <StackPanel Margin="0,0,0,10" Visibility="{Binding IsChangingPassword, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="CURRENT PASSWORD" Style="{DynamicResource MutedLabelStyle}" Margin="0,0,0,4" />
                <PasswordBox x:Name="CurrentPasswordBox"
                             Style="{DynamicResource InputPasswordBoxStyle}"
                             PasswordChanged="CurrentPasswordBox_PasswordChanged" />
            </StackPanel>

            <!-- New Password -->
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="NEW PASSWORD (MINIMUM 6 CHARACTERS)" Style="{DynamicResource MutedLabelStyle}" Margin="0,0,0,4" />
                <PasswordBox x:Name="NewPasswordBox"
                             Style="{DynamicResource InputPasswordBoxStyle}"
                             PasswordChanged="NewPasswordBox_PasswordChanged" />
            </StackPanel>

            <!-- Confirm New Password -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="CONFIRM NEW PASSWORD" Style="{DynamicResource MutedLabelStyle}" Margin="0,0,0,4" />
                <PasswordBox x:Name="ConfirmPasswordBox"
                             Style="{DynamicResource InputPasswordBoxStyle}"
                             PasswordChanged="ConfirmPasswordBox_PasswordChanged" />
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Padding="16,8"
                        Margin="0,0,8,0" />
                <Button Content="Save Password"
                        Command="{Binding SaveCommand}"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        Padding="16,8" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

