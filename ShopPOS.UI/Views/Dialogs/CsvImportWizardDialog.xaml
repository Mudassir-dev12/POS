<Window x:Class="ShopPOS.UI.Views.Dialogs.CsvImportWizardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Excel &amp; CSV Product Import Wizard"
        Height="560"
        Width="780"
        MinHeight="500"
        MinWidth="700"
        Style="{StaticResource DialogWindowStyle}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Wizard Step Breadcrumbs -->
            <RowDefinition Height="Auto" />
            <!-- Step Content -->
            <RowDefinition Height="*" />
            <!-- Navigation Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Breadcrumbs -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,12" BorderBrush="{DynamicResource SeparatorBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="1. Pick File" FontWeight="Bold" Foreground="{Binding CurrentStep, Converter={StaticResource StepColorConverter}, ConverterParameter=1}" />
                <TextBlock Text=" -> " Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Text="2. Preview" FontWeight="Bold" Foreground="{Binding CurrentStep, Converter={StaticResource StepColorConverter}, ConverterParameter=2}" />
                <TextBlock Text=" -> " Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Text="3. Validation" FontWeight="Bold" Foreground="{Binding CurrentStep, Converter={StaticResource StepColorConverter}, ConverterParameter=3}" />
                <TextBlock Text=" -> " Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Text="4. Confirm &amp; Import" FontWeight="Bold" Foreground="{Binding CurrentStep, Converter={StaticResource StepColorConverter}, ConverterParameter=4}" />
            </StackPanel>
        </Border>

        <!-- STEP 1: PICK FILE -->
        <Border Grid.Row="1" Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=1}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="580">
                <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource SurfaceCardSubtleBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock Text="CSV" FontFamily="{StaticResource AppMonospaceFontFamily}" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Import Products from Excel (.xlsx) or CSV (.csv)" Style="{StaticResource SectionHeaderStyle}" HorizontalAlignment="Center" />
                <TextBlock Text="Easily import or bulk-update your product catalog. Columns are automatically mapped by header names (e.g. SKU, Barcode, Product Name, Sale Price)."
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Style="{StaticResource SubTitleStyle}"
                           Margin="0,4,0,16" />

                <!-- File Picker Row -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding SelectedFilePath}" IsReadOnly="True" Style="{StaticResource InputTextBoxStyle}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="Browse..." Command="{Binding BrowseFileCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,0" />
                        <Button Content="Excel (.xlsx)" Command="{Binding BrowseExcelFileCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" />
                        <Button Content="CSV (.csv)" Command="{Binding BrowseCsvFileCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                </Grid>

                <!-- Template Download Buttons -->
                <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,0,0,10">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Download sample catalog template with pre-filled formatting:" Style="{StaticResource MutedLabelStyle}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="Download Excel Template (.xlsx)"
                                    Command="{Binding DownloadExcelTemplateCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,10,0" />
                            <Button Content="Download CSV Template (.csv)"
                                    Command="{Binding DownloadCsvTemplateCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SuccessTextBrush}" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,4,0,0" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- STEP 2: PREVIEW -->
        <Grid Grid.Row="1" Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=2}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource FilterBarStyle}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Product Data Preview" Style="{StaticResource SectionHeaderStyle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding PreviewRowCount, StringFormat='Found {0} total records in file.  |  Format: '}" Style="{StaticResource MutedLabelStyle}" />
                            <TextBlock Text="{Binding DetectedFileType}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DetectedNameColumn, StringFormat=' Product Name mapped to: {0}'}"
                                   FontWeight="SemiBold" Foreground="{DynamicResource SuccessTextBrush}" FontSize="12"
                                   Visibility="{Binding IsNameColumnDetected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text=" Warning: 'Product Name' column not detected!"
                                   FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" FontSize="12"
                                   Visibility="{Binding IsNameColumnDetected, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource TableContainerBorderStyle}">
                <DataGrid ItemsSource="{Binding PreviewDataTable}"
                          AutoGenerateColumns="True"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          Style="{StaticResource AppDataGridStyle}" />
            </Border>
        </Grid>

        <!-- STEP 3: VALIDATION REPORT -->
        <Grid Grid.Row="1" Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=3}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Pre-Import Validation Report" Style="{StaticResource SectionHeaderStyle}" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding TotalValidatedRows, StringFormat='Total Rows: {0}'}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding ValidRowCount, StringFormat='Valid: {0}'}" FontWeight="SemiBold" Foreground="{DynamicResource SuccessTextBrush}" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding ErrorRowCount, StringFormat='Invalid / Ignored: {0}'}" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource TableContainerBorderStyle}">
                <DataGrid ItemsSource="{Binding ValidationErrors}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Style="{StaticResource AppDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Row #" Binding="{Binding RowNumber}" Width="80"
                                            ElementStyle="{StaticResource MonospaceNumericCell}" />
                        <DataGridTextColumn Header="Validation Error" Binding="{Binding Error}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- STEP 4: CONFIRM & EXECUTE -->
        <Grid Grid.Row="1" Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=4}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                <TextBlock Text="Ready to Import" Style="{StaticResource SectionHeaderStyle}" HorizontalAlignment="Center" Margin="0,0,0,12" />

                <!-- Match Existing Option -->
                <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Matching Strategy for Existing Products (by SKU / Barcode):" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                        <RadioButton Content="Update existing product details (Prices, category, active status)" IsChecked="{Binding UpdateExisting}" FontWeight="Medium" Margin="0,0,0,4" />
                        <RadioButton Content="Skip matching products (keep existing data unchanged)" IsChecked="{Binding UpdateExisting, Converter={StaticResource InverseBooleanConverter}}" FontWeight="Medium" />
                    </StackPanel>
                </Border>

                <!-- Progress Bar -->
                <StackPanel Visibility="{Binding IsImporting, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,12">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ProgressBar Height="16" Value="{Binding ImportProgress}" Minimum="0" Maximum="100" />
                    <TextBlock Text="{Binding ImportProgress, StringFormat='{}{0}%'}" HorizontalAlignment="Center" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Summary Text -->
                <Border Background="{DynamicResource SuccessBackgroundBrush}" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Visibility="{Binding ImportCompleted, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding ImportSummaryText}" Foreground="{DynamicResource SuccessTextBrush}" FontWeight="Medium" LineHeight="20" />
                        <Button Content="Done (Close Wizard)"
                                Command="{Binding CloseDialogCommand}"
                                CommandParameter="True"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Error Display -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
        </Grid>

        <!-- Footer Navigation -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="0,12,0,0" BorderBrush="{DynamicResource SeparatorBorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Button Content="Close"
                        Command="{Binding CloseDialogCommand}"
                        CommandParameter="False"
                        HorizontalAlignment="Left"
                        Style="{StaticResource SecondaryButtonStyle}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="&lt; Back"
                            Command="{Binding PreviousStepCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0"
                            Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=2;3}" />

                    <Button Content="Next &gt;"
                            Command="{Binding NextStepCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=1;2;3}" />

                    <Button Content="Cancel Import"
                            Command="{Binding CancelImportCommand}"
                            Style="{StaticResource DangerButtonStyle}"
                            Visibility="{Binding IsImporting, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <Button Content="Start Import"
                            Command="{Binding StartImportCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=4}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
