<Window x:Class="ShopPOS.UI.Views.Dialogs.DriveConnectProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.Dialogs"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:DriveConnectProgressDialogViewModel}"
        Title="{Binding Title}"
        Width="480"
        SizeToContent="Height"
        Style="{DynamicResource DialogWindowStyle}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Border Padding="24" Style="{DynamicResource SurfaceCardStyle}" Margin="10">
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{DynamicResource SectionHeaderStyle}" Margin="0,0,0,6" />

            <TextBlock Text="Your web browser will open automatically. Sign in with your Google account and allow ShopPOS to manage backup files in Google Drive."
                       Style="{DynamicResource SubTitleStyle}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16" />

            <!-- Timer Card -->
            <Border Background="{DynamicResource NeutralBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Waiting for Google authorization..."
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontSize="13" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   Style="{DynamicResource MutedLabelStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,6"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding RemainingTimeFormatted}"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Indeterminate Progress -->
            <ProgressBar IsIndeterminate="{Binding IsBusy}"
                         Height="4"
                         Margin="0,0,0,16"
                         Foreground="{DynamicResource AccentBrush}" />

            <!-- Error Banner -->
            <Border Background="{DynamicResource DangerBackgroundBrush}"
                    BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,0,14"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="12" TextWrapping="Wrap" />
            </Border>

            <!-- Instructions -->
            <TextBlock Text="Note: ShopPOS only requests permission to files it creates (drive.file scope). It cannot read or modify your other personal Google Drive documents."
                       Style="{DynamicResource MutedLabelStyle}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16" />

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Width="100" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

