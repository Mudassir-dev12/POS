<Window x:Class="ShopPOS.UI.Views.Dialogs.ConfirmActionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm Action"
        Height="250"
        Width="460"
        Style="{StaticResource DialogWindowStyle}"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource DangerBackgroundBrush}" Margin="0,0,12,0">
                <TextBlock x:Name="IconTextBlock" Text="!" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TitleTextBlock" Text="Confirm Deletion" Style="{StaticResource SectionHeaderStyle}" />
                <TextBlock Text="Master Data Management" Style="{StaticResource SubTitleStyle}" />
            </StackPanel>
        </StackPanel>

        <!-- Message Body -->
        <TextBlock Grid.Row="1"
                   x:Name="MessageTextBlock"
                   Text="Are you sure you want to perform this action?"
                   TextWrapping="Wrap"
                   FontSize="13"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   LineHeight="20" />

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="DeleteButton"
                    Content="Delete Record"
                    Style="{StaticResource DangerButtonStyle}"
                    Margin="0,0,8,0"
                    Click="DeleteButton_Click" />

            <Button x:Name="DeactivateButton"
                    Content="Deactivate Instead"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0"
                    Click="DeactivateButton_Click" />

            <Button Content="Cancel"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsCancel="True"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
