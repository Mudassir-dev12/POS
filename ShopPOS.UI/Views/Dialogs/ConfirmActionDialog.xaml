<Window x:Class="ShopPOS.UI.Views.Dialogs.ConfirmActionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm Action"
        Height="250"
        Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Border Width="40" Height="40" CornerRadius="20" Background="#FEE2E2" Margin="0,0,12,0">
                <TextBlock x:Name="IconTextBlock" Text="⚠️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TitleTextBlock" Text="Confirm Deletion" FontSize="16" FontWeight="Bold" Foreground="#0F172A" />
                <TextBlock Text="Master Data Management" FontSize="11" Foreground="#64748B" />
            </StackPanel>
        </StackPanel>

        <!-- Message Body -->
        <TextBlock Grid.Row="1"
                   x:Name="MessageTextBlock"
                   Text="Are you sure you want to perform this action?"
                   TextWrapping="Wrap"
                   FontSize="13"
                   Foreground="#334155"
                   LineHeight="20" />

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="DeleteButton"
                    Content="Delete Record"
                    Background="#DC2626"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Padding="16,8"
                    Margin="0,0,8,0"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="DeleteButton_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </Button.Resources>
            </Button>

            <Button x:Name="DeactivateButton"
                    Content="Deactivate Instead"
                    Background="#D97706"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Padding="16,8"
                    Margin="0,0,8,0"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="DeactivateButton_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="Cancel"
                    Background="#E2E8F0"
                    Foreground="#334155"
                    FontWeight="SemiBold"
                    Padding="16,8"
                    BorderThickness="0"
                    Cursor="Hand"
                    IsCancel="True"
                    Click="CancelButton_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>

