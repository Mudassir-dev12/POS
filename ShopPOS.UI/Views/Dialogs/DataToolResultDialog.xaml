<Window x:Class="ShopPOS.UI.Views.Dialogs.DataToolResultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.Dialogs"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:DataToolResultDialogViewModel}"
        Title="{Binding Title}"
        Width="680"
        SizeToContent="Height"
        MaxHeight="620"
        Style="{DynamicResource DialogWindowStyle}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Border Padding="20" Style="{DynamicResource SurfaceCardStyle}" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Scrollable Content Body -->
                <RowDefinition Height="*" />
                <!-- Row 1: Fixed Bottom Close Button -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Scrollable Content Body -->
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                <StackPanel Margin="0,0,8,0">
                    <!-- Title & Message -->
                    <TextBlock Text="{Binding Title}" Style="{DynamicResource SectionHeaderStyle}" Margin="0,0,0,4" />

                    <!-- Success Banner -->
                    <Border Background="{DynamicResource SuccessBackgroundBrush}"
                            BorderBrush="{DynamicResource SuccessBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,10"
                            Margin="0,0,0,14">
                        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource SuccessTextBrush}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                    </Border>

                    <!-- Automatic Backup File Box -->
                    <Border Background="{DynamicResource SurfaceCardSubtleBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="AUTOMATIC BACKUP ARCHIVE CREATED" Style="{DynamicResource MutedLabelStyle}" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding BackupFilePath}" FontFamily="Consolas, monospace" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Copy Path" Command="{Binding CopyBackupPathCommand}" Style="{DynamicResource SecondaryButtonStyle}" VerticalAlignment="Center" Margin="10,0,0,0" Padding="12,6" />
                        </Grid>
                    </Border>

                    <!-- Demo Data Summary (when IsDemoData is true) -->
                    <StackPanel Visibility="{Binding IsDemoData, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,8">
                        <TextBlock Text="DEMO SHOP DATA GENERATED" Style="{DynamicResource SectionHeaderStyle}" FontSize="14" Margin="0,0,0,8" />

                        <!-- Metrics Badges -->
                        <WrapPanel Margin="0,0,0,14">
                            <Border Background="{DynamicResource SurfaceCardSubtleBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,8,8">
                                <TextBlock Text="{Binding CategoriesCreated, StringFormat='Categories: {0}'}" FontWeight="SemiBold" FontSize="12" />
                            </Border>
                            <Border Background="{DynamicResource SurfaceCardSubtleBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,8,8">
                                <TextBlock Text="{Binding BrandsCreated, StringFormat='Brands: {0}'}" FontWeight="SemiBold" FontSize="12" />
                            </Border>
                            <Border Background="{DynamicResource SurfaceCardSubtleBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,8,8">
                                <TextBlock Text="{Binding SuppliersCreated, StringFormat='Suppliers: {0}'}" FontWeight="SemiBold" FontSize="12" />
                            </Border>
                            <Border Background="{DynamicResource SurfaceCardSubtleBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,8,8">
                                <TextBlock Text="{Binding ProductsCreated, StringFormat='Products: {0}'}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource PrimaryBrush}" />
                            </Border>
                            <Border Background="{DynamicResource SurfaceCardSubtleBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,8,8">
                                <TextBlock Text="{Binding PurchasesCreated, StringFormat='Purchases: {0}'}" FontWeight="SemiBold" FontSize="12" />
                            </Border>
                            <Border Background="{DynamicResource SurfaceCardSubtleBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,8,8">
                                <TextBlock Text="{Binding SalesCreated, StringFormat='Sales: {0}'}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource SuccessTextBrush}" />
                            </Border>
                            <Border Background="{DynamicResource SurfaceCardSubtleBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,8,8">
                                <TextBlock Text="{Binding ReturnsCreated, StringFormat='Returns: {0}'}" FontWeight="SemiBold" FontSize="12" />
                            </Border>
                            <Border Background="{DynamicResource SurfaceCardSubtleBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,8,8">
                                <TextBlock Text="{Binding ExpensesCreated, StringFormat='Expenses: {0}'}" FontWeight="SemiBold" FontSize="12" />
                            </Border>
                        </WrapPanel>

                        <!-- Sample Barcodes Section -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="SAMPLE BARCODES FOR SCANNING &amp; TESTING (EAN-13)" Style="{DynamicResource MutedLabelStyle}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Copy All Barcodes" Command="{Binding CopyAllBarcodesCommand}" Style="{DynamicResource GhostButtonStyle}" Padding="8,4" />
                        </Grid>

                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <DataGrid ItemsSource="{Binding SampleBarcodes}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      Background="Transparent"
                                      MaxHeight="220"
                                      RowHeaderWidth="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="BARCODE (EAN-13)" Binding="{Binding Barcode}" Width="150" FontFamily="Consolas, monospace" FontWeight="Bold" />
                                    <DataGridTextColumn Header="PRODUCT" Binding="{Binding ProductName}" Width="2*" />
                                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="100" />
                                    <DataGridTextColumn Header="PRICE" Binding="{Binding SalePrice, StringFormat='Rs {0:N2}'}" Width="100" />
                                    <DataGridTextColumn Header="STOCK" Binding="{Binding StockQuantity, StringFormat={}{0:N0}}" Width="80" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <TextBlock Text="You can print or copy any of these barcodes into the POS scanner box to immediately test scanning."
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Fixed Bottom Close Button -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Command="{Binding CloseCommand}" Style="{DynamicResource PrimaryButtonStyle}" Padding="20,8" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
