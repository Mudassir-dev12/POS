<UserControl x:Class="ShopPOS.UI.Views.PurchasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.Purchases"
             xmlns:dto="clr-namespace:ShopPOS.Core.DTOs;assembly=ShopPOS.Core"
             xmlns:enums="clr-namespace:ShopPOS.Core.Enums;assembly=ShopPOS.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PurchasesViewModel}"
             Loaded="UserControl_Loaded">

    <UserControl.InputBindings>
        <KeyBinding Gesture="Ctrl+A" Command="{Binding SelectAllOnPageCommand}" />
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewPurchaseCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="Enter" Command="{Binding OpenPurchaseCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto" />
            <!-- Search & Filter Controls -->
            <RowDefinition Height="Auto" />
            <!-- Data Grid & Bulk Actions -->
            <RowDefinition Height="*" />
            <!-- Footer Paging -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Purchases &amp; receiving" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Manage supplier purchase invoices, incoming inventory, and trade payables."
                           Style="{StaticResource SubTitleStyle}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="New purchase Ctrl N"
                        Command="{Binding NewPurchaseCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,8,0" />

                <Button Content="Open"
                        Command="{Binding OpenPurchaseCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Margin="0,0,8,0" />

                <Button Content="Export PDF"
                        Command="{Binding ExportPdfCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Margin="0,0,8,0" />

                <Button Content="Refresh F5"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource ToolbarButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- 2. Search & Filters Bar -->
        <Border Grid.Row="1" Style="{StaticResource FilterBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search PO number or invoice #" />

                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding Suppliers}"
                          SelectedValuePath="Id"
                          DisplayMemberPath="Name"
                          SelectedValue="{Binding SelectedSupplierId}"
                          ToolTip="Filter by Supplier" />

                <ComboBox Grid.Column="4"
                          ItemsSource="{Binding PurchaseStatuses}"
                          SelectedItem="{Binding SelectedStatus}"
                          ToolTip="Filter by Status" />

                <ComboBox Grid.Column="6"
                          ItemsSource="{Binding PaymentStatuses}"
                          SelectedItem="{Binding SelectedPaymentStatus}"
                          ToolTip="Filter by Payment Status" />
            </Grid>
        </Border>

        <!-- 3. Table Area & Bulk Actions -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Bulk Selection Status Banner -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SecondaryBackgroundBrush}"
                    BorderBrush="{DynamicResource SecondaryBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,8"
                    Margin="0,0,0,10"
                    Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectionStatusText}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <Button Content="Clear selection"
                                Command="{Binding ClearSelectionCommand}"
                                Style="{StaticResource GhostButtonStyle}"
                                Padding="8,2"
                                Margin="8,0,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Delete selected"
                                Command="{Binding DeleteSelectedCommand}"
                                Style="{StaticResource DangerButtonStyle}"
                                Visibility="{Binding CanShowDeleteSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Margin="0,0,8,0" />
                        <Button Content="Cancel selected"
                                Command="{Binding CancelSelectedCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Visibility="{Binding CanShowCancelSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Select All Filtered Results Cross-Page Banner -->
            <Border Grid.Row="1"
                    Background="{DynamicResource WarningBackgroundBrush}"
                    BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,8"
                    Margin="0,0,0,10"
                    Visibility="{Binding ShowSelectAllResultsBanner, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding SelectAllResultsBannerText}"
                               Foreground="{DynamicResource WarningTextBrush}"
                               FontWeight="Medium"
                               VerticalAlignment="Center" />
                    <Button Content="Select all matching results across all pages"
                            Command="{Binding SelectAllFilteredResultsCommand}"
                            Style="{StaticResource GhostButtonStyle}"
                            FontWeight="Bold"
                            Foreground="{DynamicResource WarningTextBrush}"
                            Margin="8,0,0,0" />
                </StackPanel>
            </Border>

            <!-- DataGrid Container -->
            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <!-- Loading Indicator Overlay -->
                    <Border Background="{DynamicResource OverlayBackgroundBrush}"
                            Panel.ZIndex="10"
                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Loading purchases..."
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <!-- Empty State Message -->
                    <Border HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Panel.ZIndex="5"
                            Visibility="{Binding Items.Count, Converter={StaticResource InverseBooleanConverter}}">
                        <TextBlock Text="No purchases to show"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center" />
                    </Border>

                    <!-- DataGrid -->
                    <DataGrid ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              MouseDoubleClick="DataGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <!-- Selection Checkbox Column -->
                            <DataGridTemplateColumn Width="38" CanUserResize="False">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox IsChecked="{Binding DataContext.IsAllOnPageSelected, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                              Command="{Binding DataContext.ToggleSelectAllOnPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  Command="{Binding DataContext.ItemSelectionChangedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="PO NUMBER" Binding="{Binding PurchaseNumber}" Width="120" ElementStyle="{StaticResource MonospaceTextStyle}" />
                            <DataGridTextColumn Header="DATE" Binding="{Binding PurchaseDate, Converter={StaticResource DateDisplayConverter}}" Width="110" ElementStyle="{StaticResource MonospaceTextStyle}" />
                            <DataGridTextColumn Header="SUPPLIER" Binding="{Binding SupplierName}" Width="2*" FontWeight="Medium" />
                            <DataGridTextColumn Header="ITEMS" Binding="{Binding ItemCount}" Width="70" ElementStyle="{StaticResource MonospaceNumericCell}" />

                            <!-- Grand Total (Right-aligned, Monospace) -->
                            <DataGridTextColumn Header="TOTAL"
                                                Binding="{Binding GrandTotal, Converter={StaticResource MoneyConverter}}"
                                                Width="110"
                                                ElementStyle="{StaticResource MonospaceNumericCell}" />

                            <!-- Paid (Right-aligned, Monospace) -->
                            <DataGridTextColumn Header="PAID"
                                                Binding="{Binding PaidAmount, Converter={StaticResource MoneyConverter}}"
                                                Width="105"
                                                ElementStyle="{StaticResource MonospaceNumericCell}" />

                            <!-- Balance (Right-aligned, Monospace) -->
                            <DataGridTextColumn Header="BALANCE"
                                                Binding="{Binding Balance, Converter={StaticResource MoneyConverter}}"
                                                Width="105"
                                                ElementStyle="{StaticResource MonospaceNumericCell}" />

                            <!-- Status -->
                            <DataGridTemplateColumn Header="STATUS" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type dto:PurchaseListDto}">
                                        <Border CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Status}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding Status, Converter={StaticResource PurchaseStatusBadgeColorConverter}}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. Paging Footer -->
        <Border Grid.Row="3" Style="{StaticResource PaginationBarStyle}">
            <Grid>
                <TextBlock Text="{Binding RowCountText}"
                           FontFamily="{StaticResource AppMonospaceFontFamily}"
                           FontSize="11"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="&lt; Prev"
                            Command="{Binding PreviousPageCommand}"
                            Style="{StaticResource PaginationButtonStyle}"
                            MinWidth="54" />

                    <TextBlock Text="{Binding CurrentPage, StringFormat='Page {0}'}"
                               FontFamily="{StaticResource AppMonospaceFontFamily}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               Margin="8,0" />

                    <TextBlock Text="{Binding TotalPages, StringFormat='of {0}'}"
                               FontFamily="{StaticResource AppMonospaceFontFamily}"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />

                    <Button Content="Next &gt;"
                            Command="{Binding NextPageCommand}"
                            Style="{StaticResource PaginationButtonStyle}"
                            MinWidth="54" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
