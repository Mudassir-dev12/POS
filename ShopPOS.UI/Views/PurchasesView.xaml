<UserControl x:Class="ShopPOS.UI.Views.PurchasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.Purchases"
             xmlns:dto="clr-namespace:ShopPOS.Core.DTOs;assembly=ShopPOS.Core"
             xmlns:enums="clr-namespace:ShopPOS.Core.Enums;assembly=ShopPOS.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PurchasesViewModel}"
             Background="#F1F5F9"
             FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
             Loaded="UserControl_Loaded">

    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewPurchaseCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="Enter" Command="{Binding OpenPurchaseCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto" />
            <!-- Search & Filter Controls -->
            <RowDefinition Height="Auto" />
            <!-- Data Grid -->
            <RowDefinition Height="*" />
            <!-- Footer Paging -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= 1. HEADER ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Purchases &amp; Receiving" FontSize="22" FontWeight="Bold" Foreground="#0F172A" />
                <TextBlock Text="Manage supplier purchase invoices, incoming inventory, and payables." FontSize="13" Foreground="#64748B" Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="+ New Purchase (Ctrl+N)"
                        Command="{Binding NewPurchaseCommand}"
                        IsEnabled="{Binding CanAdd}"
                        Background="#2563EB"
                        Foreground="White"
                        FontWeight="Bold"
                        Padding="14,8"
                        BorderThickness="0"
                        Cursor="Hand" />

                <Button Content="Open (Enter)"
                        Command="{Binding OpenPurchaseCommand}"
                        Background="#E2E8F0"
                        Foreground="#0F172A"
                        FontWeight="SemiBold"
                        Padding="12,8"
                        Margin="8,0,0,0"
                        BorderThickness="0"
                        Cursor="Hand" />

                <Button Content="Post"
                        Command="{Binding PostSelectedPurchaseCommand}"
                        Background="#16A34A"
                        Foreground="White"
                        FontWeight="Bold"
                        Padding="12,8"
                        Margin="8,0,0,0"
                        BorderThickness="0"
                        Cursor="Hand" />

                <Button Content="Cancel"
                        Command="{Binding CancelSelectedPurchaseCommand}"
                        Background="#FEE2E2"
                        Foreground="#DC2626"
                        FontWeight="Bold"
                        Padding="12,8"
                        Margin="8,0,0,0"
                        BorderThickness="0"
                        Cursor="Hand" />

                <Button Content="📄 Export PDF"
                        Command="{Binding ExportPdfCommand}"
                        Background="#334155"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Padding="12,8"
                        Margin="8,0,0,0"
                        BorderThickness="0"
                        Cursor="Hand" />

                <Button Content="🔄 Refresh (F5)"
                        Command="{Binding RefreshCommand}"
                        Background="#E2E8F0"
                        Foreground="#334155"
                        FontWeight="SemiBold"
                        Padding="12,8"
                        Margin="8,0,0,0"
                        BorderThickness="0"
                        Cursor="Hand" />
            </StackPanel>
        </Grid>

        <!-- ================= 2. FILTERS ================= -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,0,14" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <TextBox Grid.Row="0" Grid.Column="0"
                         Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,6"
                         FontSize="13">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Resources>
                                <VisualBrush x:Key="CueBannerBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                    <VisualBrush.Visual>
                                        <TextBlock Text="🔍 Search #, invoice no, supplier..." Foreground="#94A3B8" FontSize="12" Margin="6,0,0,0" />
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Style.Resources>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background" Value="{StaticResource CueBannerBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- Supplier Filter -->
                <ComboBox Grid.Row="0" Grid.Column="2"
                          ItemsSource="{Binding Suppliers}"
                          SelectedValue="{Binding SelectedSupplierId, Mode=TwoWay}"
                          SelectedValuePath="Id"
                          DisplayMemberPath="Name"
                          Padding="8,6"
                          FontSize="13" />

                <!-- Status Filter -->
                <ComboBox Grid.Row="0" Grid.Column="4"
                          SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"
                          Padding="8,6"
                          FontSize="13">
                    <ComboBox.Items>
                        <x:Null />
                        <x:Static Member="enums:PurchaseStatus.Draft" />
                        <x:Static Member="enums:PurchaseStatus.Posted" />
                        <x:Static Member="enums:PurchaseStatus.Cancelled" />
                    </ComboBox.Items>
                </ComboBox>

                <!-- Payment Status Filter -->
                <ComboBox Grid.Row="0" Grid.Column="6"
                          SelectedItem="{Binding SelectedPaymentStatus, Mode=TwoWay}"
                          Padding="8,6"
                          FontSize="13">
                    <ComboBox.Items>
                        <x:Null />
                        <x:Static Member="enums:PurchasePaymentStatus.Unpaid" />
                        <x:Static Member="enums:PurchasePaymentStatus.Partial" />
                        <x:Static Member="enums:PurchasePaymentStatus.Paid" />
                        <x:Static Member="enums:PurchasePaymentStatus.Overdue" />
                    </ComboBox.Items>
                </ComboBox>

                <!-- Date Range -->
                <StackPanel Grid.Row="0" Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="From:" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" Width="110" Padding="4,2" />
                    <TextBlock Text="To:" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" Margin="8,0,4,0" />
                    <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" Width="110" Padding="4,2" />
                </StackPanel>

                <!-- Error Message -->
                <TextBlock Grid.Row="0" Grid.Column="9"
                           Text="{Binding ErrorMessage}"
                           Foreground="#DC2626"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ================= 3. DATA GRID ================= -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      Background="White"
                      BorderThickness="0"
                      RowHeight="38"
                      MouseDoubleClick="DataGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Doc #" Binding="{Binding PurchaseNumber}" Width="120" FontWeight="Bold" />
                    <DataGridTextColumn Header="Date" Binding="{Binding PurchaseDate, StringFormat='{}{0:dd MMM yyyy HH:mm}'}" Width="135" />
                    <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="1.5*" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="Invoice #" Binding="{Binding SupplierInvoiceNo, TargetNullValue='—'}" Width="110" />
                    <DataGridTextColumn Header="Total" Binding="{Binding GrandTotal, StringFormat='{}{0:0.00}'}" Width="100" FontWeight="Bold" />
                    <DataGridTextColumn Header="Paid" Binding="{Binding PaidAmount, StringFormat='{}{0:0.00}'}" Width="90" />
                    <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat='{}{0:0.00}'}" Width="95" FontWeight="Bold" />

                    <!-- Payment Status Badge -->
                    <DataGridTemplateColumn Header="Payment" Width="95">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type dto:PurchaseListDto}">
                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                                        Background="{Binding PaymentStatus, Converter={StaticResource PaymentStatusBadgeBackgroundConverter}}">
                                    <TextBlock Text="{Binding PaymentStatus}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{Binding PaymentStatus, Converter={StaticResource PaymentStatusBadgeColorConverter}}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Status Badge -->
                    <DataGridTemplateColumn Header="Status" Width="95">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type dto:PurchaseListDto}">
                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                                        Background="{Binding Status, Converter={StaticResource PurchaseStatusBadgeBackgroundConverter}}">
                                    <TextBlock Text="{Binding Status}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{Binding Status, Converter={StaticResource PurchaseStatusBadgeColorConverter}}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ================= 4. FOOTER PAGING ================= -->
        <Border Grid.Row="3" Margin="0,14,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RowCountText}" FontWeight="SemiBold" Foreground="#334155" FontSize="13" />
                    <TextBlock Text="  •  Double-click or press Enter to open  •  Paging 50 items/page" FontSize="12" Foreground="#94A3B8" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="◀ Prev" Command="{Binding PreviousPageCommand}" Padding="12,6" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" />
                    <TextBlock Text="{Binding CurrentPage, StringFormat='Page {0}'}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0" />
                    <TextBlock Text="{Binding TotalPages, StringFormat='of {0}'}" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Content="Next ▶" Command="{Binding NextPageCommand}" Padding="12,6" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

