<UserControl x:Class="ShopPOS.UI.Views.BackupRestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.BackupRestore"
             xmlns:dto="clr-namespace:ShopPOS.Core.DTOs.Backup;assembly=ShopPOS.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:BackupRestoreViewModel}"
             d:DesignHeight="800" d:DesignWidth="1100">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- 0: Page Header & Action Bar -->
            <RowDefinition Height="Auto" />
            <!-- 1: Warning & Notification Banners -->
            <RowDefinition Height="Auto" />
            <!-- 2: Overview KPI Cards -->
            <RowDefinition Height="Auto" />
            <!-- 3: Main Split Content (Backups Table & Settings) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= 0. HEADER & ACTIONS ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Backup &amp; Restore" Style="{DynamicResource PageTitleStyle}" />
                <TextBlock Text="Automated daily snapshots, Grandfather-Father-Son retention, database safety and disaster recovery."
                           Style="{DynamicResource SubTitleStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Discover Files"
                        Command="{Binding DiscoverBackupsCommand}"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Padding="14,8"
                        Margin="0,0,8,0" />

                <Button Content="Open Folder"
                        Command="{Binding OpenBackupFolderCommand}"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Padding="14,8"
                        Margin="0,0,8,0" />

                <Button Content="Restore..."
                        Command="{Binding RestoreFromFileCommand}"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Padding="14,8"
                        Margin="0,0,8,0" />

                <Button Content="Restore from Drive..."
                        Command="{Binding RestoreFromDriveCommand}"
                        IsEnabled="{Binding Summary.IsDriveConnected}"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Padding="14,8"
                        Margin="0,0,8,0" />

                <Button Content="Restore from GitHub..."
                        Command="{Binding RestoreFromGitHubCommand}"
                        IsEnabled="{Binding Summary.IsGitHubConnected}"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Padding="14,8"
                        Margin="0,0,8,0" />

                <Button Content="Backup Now"
                        Command="{Binding BackupNowCommand}"
                        IsEnabled="{Binding IsBackingUp, Converter={StaticResource InverseBooleanConverter}}"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        Padding="18,8" />
            </StackPanel>
        </Grid>

        <!-- ================= 1. BANNERS ================= -->
        <StackPanel Grid.Row="1" Margin="0,0,0,14">


            <!-- Google Drive Reconnect Needed Banner -->
            <Border Background="{DynamicResource DangerBackgroundBrush}"
                    BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10"
                    Margin="0,0,0,10"
                    Visibility="{Binding Summary.IsDriveReconnectNeeded, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="GOOGLE DRIVE RECONNECT REQUIRED" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="0,0,0,2" />
                        <TextBlock Text="Google Drive authorization has expired or was revoked. Cloud uploads are paused until you reconnect."
                                   Foreground="{DynamicResource ForegroundBrush}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Reconnect Now"
                            Command="{Binding ConnectDriveCommand}"
                            Style="{DynamicResource PrimaryButtonStyle}"
                            Padding="12,6"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Google Drive Quota Full Banner -->
            <Border Background="{DynamicResource DangerBackgroundBrush}"
                    BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10"
                    Margin="0,0,0,10"
                    Visibility="{Binding Summary.IsDriveFull, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="GOOGLE DRIVE STORAGE FULL" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="0,0,0,2" />
                    <TextBlock Text="Your Google Drive storage quota has been reached. Cloud uploads will pause until space is freed on Google Drive."
                               Foreground="{DynamicResource ForegroundBrush}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- GitHub Reconnect Needed Banner -->
            <Border Background="{DynamicResource DangerBackgroundBrush}"
                    BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10"
                    Margin="0,0,0,10"
                    Visibility="{Binding Summary.IsGitHubReconnectNeeded, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="GITHUB ACCESS TOKEN RECONNECT REQUIRED" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="0,0,0,2" />
                    <TextBlock Text="GitHub authorization failed or token has expired. Please re-enter a valid personal access token in GitHub Cloud Backup Settings."
                               Foreground="{DynamicResource ForegroundBrush}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- GitHub Public Repo Refused Banner -->
            <Border Background="{DynamicResource DangerBackgroundBrush}"
                    BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10"
                    Margin="0,0,0,10"
                    Visibility="{Binding Summary.IsGitHubRepoPublic, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="GITHUB REPOSITORY IS PUBLIC (UPLOAD REFUSED)" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="0,0,0,2" />
                    <TextBlock Text="The configured GitHub repository is marked PUBLIC. For data security, ShopPOS will only upload to a PRIVATE repository."
                               Foreground="{DynamicResource ForegroundBrush}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- GitHub File Too Large Banner -->
            <Border Background="{DynamicResource DangerBackgroundBrush}"
                    BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10"
                    Margin="0,0,0,10"
                    Visibility="{Binding Summary.IsGitHubFileTooLarge, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="BACKUP FILE EXCEEDS 1.8 GiB (UPLOAD REFUSED)" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="0,0,0,2" />
                    <TextBlock Text="Backup release asset exceeds 1.8 GiB limit. Exclude product images from cloud backup or archive older transaction data."
                               Foreground="{DynamicResource ForegroundBrush}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Warning Banner (When no backup in 2 days or last backup failed) -->
            <Border Background="{DynamicResource WarningBackgroundBrush}"
                    BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10"
                    Margin="0,0,0,10"
                    Visibility="{Binding Summary.HasWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="BACKUP ATTENTION REQUIRED" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" FontSize="12" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding Summary.WarningMessage}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Backup Now"
                            Command="{Binding BackupNowCommand}"
                            Style="{DynamicResource PrimaryButtonStyle}"
                            Padding="14,6"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Action Status Banner -->
            <Border Background="{DynamicResource SuccessBackgroundBrush}"
                    BorderBrush="{DynamicResource SuccessBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,8"
                    Margin="0,0,0,10"
                    Visibility="{Binding ActionMessage, Converter={StaticResource StringToVisibilityConverter}}">
                <TextBlock Text="{Binding ActionMessage}" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" FontSize="12" />
            </Border>
        </StackPanel>

        <!-- ================= 2. OVERVIEW CARDS ================= -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Last Backup -->
            <Border Grid.Column="0" Style="{DynamicResource SurfaceCardStyle}" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="LAST BACKUP" Style="{DynamicResource MutedLabelStyle}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding Summary.LastBackupAtFormatted, FallbackValue='Never'}" FontWeight="Bold" FontSize="15" />
                    <TextBlock Text="{Binding Summary.LastBackupResult, StringFormat='Result: {0}'}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Card 2: Next Scheduled -->
            <Border Grid.Column="2" Style="{DynamicResource SurfaceCardStyle}" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="NEXT SCHEDULED" Style="{DynamicResource MutedLabelStyle}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding Summary.NextScheduledBackupFormatted}" FontWeight="Bold" FontSize="15" />
                    <TextBlock Text="{Binding Settings.BackupTime, StringFormat='Configured for {0} daily'}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Card 3: Storage & Free Space -->
            <Border Grid.Column="4" Style="{DynamicResource SurfaceCardStyle}" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="BACKUP STORAGE" Style="{DynamicResource MutedLabelStyle}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding Summary.FreeDiskSpaceFormatted, StringFormat='{}{0} free'}" FontWeight="Bold" FontSize="15" />
                    <TextBlock Text="{Binding Summary.BackupDirectory}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- Card 4: Google Drive Sync Status -->
            <Border Grid.Column="6" Style="{DynamicResource SurfaceCardStyle}" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="GOOGLE DRIVE SYNC" Style="{DynamicResource MutedLabelStyle}" Margin="0,0,0,4" />
                    <!-- Connected -->
                    <TextBlock Text="Connected" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource SuccessBrush}"
                               Visibility="{Binding Summary.IsDriveConnected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <!-- Not Connected (Configured) -->
                    <TextBlock Text="Not Connected" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource WarningBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Summary.IsDriveConfiguredInBuild}" Value="True" />
                                            <Condition Binding="{Binding Summary.IsDriveConnected}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- Not Configured -->
                    <TextBlock Text="Not Configured" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextMutedBrush}"
                               Visibility="{Binding Summary.IsDriveConfiguredInBuild, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                    <!-- Subtitle: Connected Account Email -->
                    <TextBlock Text="{Binding Summary.DriveAccountEmail}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Summary.IsDriveConnected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <!-- Subtitle: Ready to Connect -->
                    <TextBlock Text="Ready to connect" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Summary.IsDriveConfiguredInBuild}" Value="True" />
                                            <Condition Binding="{Binding Summary.IsDriveConnected}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- Subtitle: Configure Credentials -->
                    <TextBlock Text="Setup credentials below" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"
                               Visibility="{Binding Summary.IsDriveConfiguredInBuild, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= 3. SPLIT CONTENT ================= -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <!-- Backups Table (65%) -->
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <!-- Backup Settings (35%) -->
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Backups Table Card -->
            <Border Grid.Column="0" Style="{DynamicResource SurfaceCardStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Table Toolbar -->
                        <RowDefinition Height="Auto" />
                        <!-- Data Table -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Table Toolbar -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Backup History" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding Backups.Count, StringFormat='({0} total)'}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox Content="Select All"
                                      IsChecked="{Binding IsSelectAll}"
                                      Command="{Binding ToggleSelectAllCommand}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,12,0" />

                            <Button Content="{Binding SelectedCount, StringFormat='Delete Selected ({0})'}"
                                    Command="{Binding DeleteSelectedCommand}"
                                    IsEnabled="{Binding HasSelection}"
                                    Style="{DynamicResource DangerButtonStyle}"
                                    Padding="12,6" />
                        </StackPanel>
                    </Grid>

                    <!-- DataGrid for Backups -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Backups}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              Background="Transparent"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource BorderBrush}">

                        <DataGrid.Columns>
                            <!-- Selection Checkbox -->
                            <DataGridTemplateColumn Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type dto:BackupRecordDto}">
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Click="OnRecordCheckBoxClick" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Date & Time -->
                            <DataGridTextColumn Header="Date &amp; Time"
                                                Binding="{Binding CreatedAtFormatted}"
                                                Width="160" />

                            <!-- Kind Badge -->
                            <DataGridTemplateColumn Header="Kind" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type dto:BackupRecordDto}">
                                        <Border Background="{DynamicResource SecondaryBackgroundBrush}"
                                                BorderBrush="{DynamicResource SecondaryBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Padding="6,2"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding KindDisplay}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Size -->
                            <DataGridTextColumn Header="Size"
                                                Binding="{Binding SizeFormatted}"
                                                Width="85" />

                            <!-- Encrypted Indicator -->
                            <DataGridTemplateColumn Header="Encrypted" Width="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type dto:BackupRecordDto}">
                                        <TextBlock Text="{Binding IsEncrypted, Converter={StaticResource BooleanToYesNoConverter}}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Verification Badge -->
                            <DataGridTemplateColumn Header="Integrity" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type dto:BackupRecordDto}">
                                        <Border CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding VerifyStatus}" Value="Ok">
                                                            <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding VerifyStatus}" Value="Failed">
                                                            <Setter Property="Background" Value="{DynamicResource DangerBackgroundBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Unverified" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding VerifyStatus}" Value="Ok">
                                                                <Setter Property="Text" Value="Verified" />
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding VerifyStatus}" Value="Failed">
                                                                <Setter Property="Text" Value="Failed" />
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Cloud Status Column -->
                            <DataGridTemplateColumn Header="Cloud" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type dto:BackupRecordDto}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource NeutralBackgroundBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DriveStatus}" Value="Uploaded">
                                                                <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DriveStatus}" Value="Uploading">
                                                                <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DriveStatus}" Value="Failed">
                                                                <Setter Property="Background" Value="{DynamicResource DangerBackgroundBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding DriveStatus}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DriveStatus}" Value="Uploaded">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding DriveStatus}" Value="Uploading">
                                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding DriveStatus}" Value="Failed">
                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <Button Content="Upload"
                                                    ToolTip="Upload to Google Drive now"
                                                    Command="{Binding DataContext.UploadRecordToDriveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding CanUploadToDrive, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Style="{DynamicResource SecondaryButtonStyle}"
                                                    Padding="4,2"
                                                    FontSize="10"
                                                    Margin="4,0,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- GitHub Status Column -->
                            <DataGridTemplateColumn Header="GITHUB" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource NeutralBackgroundBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding GitHubStatus}" Value="Uploaded">
                                                                <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding GitHubStatus}" Value="Uploading">
                                                                <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding GitHubStatus}" Value="Failed">
                                                                <Setter Property="Background" Value="{DynamicResource DangerBackgroundBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding GitHubStatus}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding GitHubStatus}" Value="Uploaded">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding GitHubStatus}" Value="Uploading">
                                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding GitHubStatus}" Value="Failed">
                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <Button Content="Upload"
                                                    ToolTip="Upload to GitHub releases now"
                                                    Command="{Binding DataContext.UploadRecordToGitHubCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding CanUploadToGitHub, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Style="{DynamicResource SecondaryButtonStyle}"
                                                    Padding="4,2"
                                                    FontSize="10"
                                                    Margin="4,0,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Actions -->
                            <DataGridTemplateColumn Header="Actions" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type dto:BackupRecordDto}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Verify"
                                                    Command="{Binding DataContext.VerifyRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{DynamicResource SecondaryButtonStyle}"
                                                    Padding="8,3"
                                                    Margin="0,0,4,0" />

                                            <Button Content="Restore"
                                                    Command="{Binding DataContext.RestoreRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{DynamicResource SecondaryButtonStyle}"
                                                    Padding="8,3"
                                                    Margin="0,0,4,0" />

                                            <Button Content="Copy To"
                                                    Command="{Binding DataContext.CopyToCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{DynamicResource SecondaryButtonStyle}"
                                                    Padding="8,3"
                                                    Margin="0,0,4,0" />

                                            <Button Content="Delete"
                                                    Command="{Binding DataContext.DeleteRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{DynamicResource DangerButtonStyle}"
                                                    Padding="8,3" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Right: Settings Card -->
            <Border Grid.Column="2" Style="{DynamicResource SurfaceCardStyle}" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Backup &amp; Retention Settings" FontWeight="Bold" FontSize="14" Margin="0,0,0,12" />

                        <!-- Schedule Toggle -->
                        <CheckBox Content="Enable Automatic Daily Backup"
                                  IsChecked="{Binding Settings.BackupEnabled, UpdateSourceTrigger=PropertyChanged}"
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,10" />

                        <!-- Scheduled Backup Time -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="DAILY BACKUP TIME (HH:MM)" Style="{DynamicResource MutedLabelStyle}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Settings.BackupTime, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource InputTextBoxStyle}"
                                     Padding="8,6" />
                        </StackPanel>

                        <!-- Backup on Close -->
                        <CheckBox Content="Take Automatic Backup on App Close"
                                  IsChecked="{Binding Settings.BackupOnAppClose, UpdateSourceTrigger=PropertyChanged}"
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,16" />

                        <!-- Retention Section -->
                        <TextBlock Text="RETENTION POLICY (GFS)" Style="{DynamicResource MutedLabelStyle}" Margin="0,0,0,6" />
                        <Border Background="{DynamicResource SurfaceCardSubtleBrush}"
                                BorderBrush="{DynamicResource SurfaceCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,10"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Daily backups to retain:" VerticalAlignment="Center" FontSize="12" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding Settings.KeepDaily, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{DynamicResource InputTextBoxStyle}"
                                             Padding="4,4"
                                             HorizontalContentAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Weekly backups to retain:" VerticalAlignment="Center" FontSize="12" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding Settings.KeepWeekly, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{DynamicResource InputTextBoxStyle}"
                                             Padding="4,4"
                                             HorizontalContentAlignment="Center" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Monthly backups to retain:" VerticalAlignment="Center" FontSize="12" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding Settings.KeepMonthly, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{DynamicResource InputTextBoxStyle}"
                                             Padding="4,4"
                                             HorizontalContentAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Secondary Folder Mirror -->
                        <TextBlock Text="SECONDARY MIRROR FOLDER (USB / DISK)" Style="{DynamicResource MutedLabelStyle}" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding Settings.SecondFolderPath, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource InputTextBoxStyle}"
                                     Padding="8,6" />
                            <Button Grid.Column="2"
                                    Content="Browse"
                                    Command="{Binding BrowseSecondFolderCommand}"
                                    Style="{DynamicResource SecondaryButtonStyle}"
                                    Padding="10,6" />
                        </Grid>
                        <TextBlock Text="{Binding SecondFolderStatusText, StringFormat='Status: {0}'}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,0,0,16" />

                        <!-- GitHub Cloud Backup Section -->
                        <TextBlock Text="GITHUB PRIVATE REPOSITORY (RELEASE ASSETS)" Style="{DynamicResource MutedLabelStyle}" Margin="0,0,0,6" />
                        <Border Background="{DynamicResource SurfaceCardSubtleBrush}"
                                BorderBrush="{DynamicResource SurfaceCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,10"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <CheckBox Content="Enable Automatic GitHub Backups"
                                          IsChecked="{Binding Settings.GitHubEnabled, Mode=TwoWay}"
                                          FontWeight="SemiBold"
                                          Margin="0,0,0,8" />

                                <TextBlock Text="Stores encrypted backup release assets (daily, monthly, year-end archives) on a private GitHub repository."
                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />

                                <!-- Inputs Grid -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="REPOSITORY OWNER" Style="{DynamicResource MutedLabelStyle}" Margin="0,0,0,2" />
                                        <TextBox Text="{Binding Settings.GitHubOwner, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource InputTextBoxStyle}" Padding="6,4" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="REPOSITORY NAME" Style="{DynamicResource MutedLabelStyle}" Margin="0,0,0,2" />
                                        <TextBox Text="{Binding Settings.GitHubRepo, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource InputTextBoxStyle}" Padding="6,4" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="BRANCH" Style="{DynamicResource MutedLabelStyle}" Margin="0,0,0,2" />
                                        <TextBox Text="{Binding Settings.GitHubBranch, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource InputTextBoxStyle}" Padding="6,4" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="PERSONAL ACCESS TOKEN" Style="{DynamicResource MutedLabelStyle}" Margin="0,0,0,2" />
                                        <TextBox Text="{Binding GitHubTokenInput, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource InputTextBoxStyle}" Padding="6,4" Tag="Enter or update token..." />
                                    </StackPanel>
                                </Grid>

                                <CheckBox Content="Exclude product images from cloud copy (default ON)"
                                          IsChecked="{Binding Settings.GitHubExcludeImages, Mode=TwoWay}"
                                          FontSize="12"
                                          Margin="0,0,0,8" />

                                <!-- Warning Block if token accesses multiple repos -->
                                <Border Background="{DynamicResource WarningBackgroundBrush}"
                                        BorderBrush="{DynamicResource WarningBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="6"
                                        Margin="0,0,0,8"
                                        Visibility="{Binding HasGitHubWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding GitHubWarningMessage}" Foreground="{DynamicResource WarningBrush}" FontSize="11" TextWrapping="Wrap" />
                                </Border>

                                <!-- Buttons Strip -->
                                <WrapPanel Margin="0,0,0,8">
                                    <Button Content="Test Connection"
                                            Command="{Binding TestGitHubConnectionCommand}"
                                            Style="{DynamicResource SecondaryButtonStyle}"
                                            Padding="8,4"
                                            FontSize="11"
                                            Margin="0,0,6,4" />

                                    <Button Content="Prepare Repo (README.md)"
                                            Command="{Binding PrepareGitHubRepositoryCommand}"
                                            Style="{DynamicResource SecondaryButtonStyle}"
                                            Padding="8,4"
                                            FontSize="11"
                                            Margin="0,0,6,4" />

                                    <Button Content="Save GitHub Settings"
                                            Command="{Binding SaveGitHubConfigCommand}"
                                            Style="{DynamicResource PrimaryButtonStyle}"
                                            Padding="8,4"
                                            FontSize="11"
                                            Margin="0,0,6,4" />

                                    <Button Content="Disconnect"
                                            Command="{Binding DisconnectGitHubCommand}"
                                            Style="{DynamicResource DangerButtonStyle}"
                                            Padding="8,4"
                                            FontSize="11"
                                            Margin="0,0,6,4" />
                                </WrapPanel>

                                <!-- Tools & Actions Strip -->
                                <TextBlock Text="TOOLS &amp; MAINTENANCE" Style="{DynamicResource MutedLabelStyle}" Margin="0,4,0,4" />
                                <WrapPanel Margin="0,0,0,6">
                                    <Button Content="Upload Pending Now"
                                            Command="{Binding UploadAllPendingToGitHubCommand}"
                                            Style="{DynamicResource SecondaryButtonStyle}"
                                            Padding="8,4"
                                            FontSize="11"
                                            Margin="0,0,6,4" />

                                    <Button Content="Create Year-End Archive"
                                            Command="{Binding CreateYearEndArchiveCommand}"
                                            Style="{DynamicResource SecondaryButtonStyle}"
                                            Padding="8,4"
                                            FontSize="11"
                                            Margin="0,0,6,4" />

                                    <Button Content="Copy to Another Repo..."
                                            Command="{Binding OpenCopyRepoDialogCommand}"
                                            Style="{DynamicResource SecondaryButtonStyle}"
                                            Padding="8,4"
                                            FontSize="11"
                                            Margin="0,0,6,4" />
                                </WrapPanel>

                                <TextBlock Text="{Binding GitHubStatus.FormattedLastUpload, StringFormat='Last Upload: {0}'}"
                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,2" />

                                <TextBlock Text="{Binding GitHubStatus.PendingCount, StringFormat='Pending uploads: {0}'}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"
                                           Visibility="{Binding GitHubStatus.PendingCount, Converter={StaticResource DecimalGreaterThanZeroToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>

                        <!-- Google Drive Cloud Section -->
                        <TextBlock Text="GOOGLE DRIVE CLOUD BACKUP" Style="{DynamicResource MutedLabelStyle}" Margin="0,0,0,6" />
                        <Border Background="{DynamicResource SurfaceCardSubtleBrush}"
                                BorderBrush="{DynamicResource SurfaceCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,10"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <!-- When not configured in build -->
                                <StackPanel Visibility="{Binding Summary.IsDriveConfiguredInBuild, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                    <TextBlock Text="Google Drive is not configured yet." FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                                    <TextBlock Text="Import googledrive.client.json downloaded from Google Cloud Console, or enter Client ID &amp; Secret."
                                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Button Content="Import Google JSON File..."
                                                Command="{Binding ImportGoogleClientJsonCommand}"
                                                Style="{DynamicResource PrimaryButtonStyle}"
                                                Padding="10,6"
                                                Margin="0,0,8,0" />

                                        <Button Content="Open ShopData Folder"
                                                Command="{Binding OpenDataFolderCommand}"
                                                Style="{DynamicResource SecondaryButtonStyle}"
                                                Padding="10,6" />
                                    </StackPanel>

                                    <!-- Manual entry toggle -->
                                    <Button Content="Or Enter Client ID &amp; Secret Manually"
                                            Command="{Binding ToggleDriveCredentialsExpandedCommand}"
                                            Style="{DynamicResource SecondaryButtonStyle}"
                                            HorizontalAlignment="Left"
                                            Padding="8,4"
                                            FontSize="11"
                                            Margin="0,0,0,8" />

                                    <StackPanel Visibility="{Binding IsDriveCredentialsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,8">
                                        <TextBlock Text="CLIENT ID" Style="{DynamicResource MutedLabelStyle}" Margin="0,0,0,3" />
                                        <TextBox Text="{Binding GoogleClientIdInput, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{DynamicResource InputTextBoxStyle}" Padding="6,4" Margin="0,0,0,6" />

                                        <TextBlock Text="CLIENT SECRET" Style="{DynamicResource MutedLabelStyle}" Margin="0,0,0,3" />
                                        <TextBox Text="{Binding GoogleClientSecretInput, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{DynamicResource InputTextBoxStyle}" Padding="6,4" Margin="0,0,0,8" />

                                        <Button Content="Save Credentials"
                                                Command="{Binding SaveManualGoogleCredentialsCommand}"
                                                Style="{DynamicResource PrimaryButtonStyle}"
                                                HorizontalAlignment="Left"
                                                Padding="10,5" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- When configured in build but not connected -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Summary.IsDriveConfiguredInBuild}" Value="True" />
                                                        <Condition Binding="{Binding Summary.IsDriveConnected}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Google Drive credentials configured." FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                                    <TextBlock Text="Connect your Google account to automatically upload secondary backup archives to Google Drive."
                                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Content="Connect Google Drive"
                                                Command="{Binding ConnectDriveCommand}"
                                                Style="{DynamicResource PrimaryButtonStyle}"
                                                Padding="12,6"
                                                Margin="0,0,8,0" />
                                        <Button Content="Re-Import Credentials"
                                                Command="{Binding ImportGoogleClientJsonCommand}"
                                                Style="{DynamicResource SecondaryButtonStyle}"
                                                Padding="10,6"
                                                Margin="0,0,8,0" />
                                        <Button Content="Remove"
                                                Command="{Binding ClearGoogleCredentialsCommand}"
                                                Style="{DynamicResource SecondaryButtonStyle}"
                                                Padding="8,6" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- When connected -->
                                <StackPanel Visibility="{Binding Summary.IsDriveConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Connected Account:" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                                            <TextBlock Text="{Binding Summary.DriveAccountEmail}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="Disconnect"
                                                Command="{Binding DisconnectDriveCommand}"
                                                Style="{DynamicResource DangerButtonStyle}"
                                                Padding="8,3"
                                                FontSize="11" />
                                    </Grid>

                                    <!-- Cloud Backup Toggle -->
                                    <CheckBox Content="Enable Cloud Uploads"
                                              IsChecked="{Binding Settings.GoogleDriveEnabled, UpdateSourceTrigger=PropertyChanged}"
                                              FontWeight="SemiBold"
                                              Margin="0,0,0,8" />

                                    <!-- Keep Manual Backups on Drive -->
                                    <CheckBox Content="Keep Manual Backups on Drive"
                                              IsChecked="{Binding Settings.KeepManualBackupsOnDrive, UpdateSourceTrigger=PropertyChanged}"
                                              FontSize="12"
                                              Margin="0,0,0,6" />

                                    <!-- Delete to Trash -->
                                    <CheckBox Content="Move Old Backups to Trash"
                                              IsChecked="{Binding Settings.GoogleDriveDeleteToTrash, UpdateSourceTrigger=PropertyChanged}"
                                              FontSize="12"
                                              Margin="0,0,0,10" />

                                    <!-- Sync Info -->
                                    <TextBlock Text="{Binding Summary.LastDriveUploadFormatted, StringFormat='Last Upload: {0}'}"
                                               FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4" />

                                    <!-- Pending count if any -->
                                    <TextBlock Text="{Binding Summary.DrivePendingCount, StringFormat='Pending uploads: {0}'}"
                                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"
                                               Margin="0,0,0,6"
                                               Visibility="{Binding Summary.DrivePendingCount, Converter={StaticResource DecimalGreaterThanZeroToVisibilityConverter}}" />

                                    <!-- Actions strip -->
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="Upload Now"
                                                Command="{Binding UploadNowCommand}"
                                                Style="{DynamicResource SecondaryButtonStyle}"
                                                Padding="10,5"
                                                FontSize="11"
                                                Margin="0,0,6,0" />

                                        <Button Content="Open Drive Folder"
                                                Command="{Binding OpenDriveFolderCommand}"
                                                Style="{DynamicResource SecondaryButtonStyle}"
                                                Padding="10,5"
                                                FontSize="11" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Save Settings Button -->
                        <Button Content="Save Settings"
                                Command="{Binding SaveSettingsCommand}"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                Padding="16,8"
                                HorizontalAlignment="Stretch" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>

