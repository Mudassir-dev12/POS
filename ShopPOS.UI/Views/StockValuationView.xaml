<UserControl x:Class="ShopPOS.UI.Views.StockValuationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.Inventory"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:StockValuationViewModel}"
             Background="{DynamicResource PageBackgroundBrush}"
             FontFamily="{StaticResource AppFontFamily}"
             Loaded="UserControl_Loaded">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding LoadDataCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto" />
            <!-- KPI Cards -->
            <RowDefinition Height="Auto" />
            <!-- DataGrid -->
            <RowDefinition Height="*" />
            <!-- Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Inventory Stock Valuation by Category" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Financial analysis of cost, retail value, and projected gross profit margins across inventory categories." Style="{StaticResource SubTitleStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Export CSV" Command="{Binding ExportCsvCommand}"
                        Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,8,0" />
                <Button Content="Export PDF" Command="{Binding ExportPdfCommand}"
                        Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,8,0" />
                <Button Content="Refresh (F5)" Command="{Binding LoadDataCommand}"
                        Style="{StaticResource ToolbarButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- KPI Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Products -->
            <Border Grid.Column="0" Style="{StaticResource SurfaceCardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Total Tracked Products" Style="{StaticResource KpiLabelStyle}" />
                    <TextBlock Text="{Binding TotalProducts}" Style="{StaticResource KpiValueStyle}" />
                </StackPanel>
            </Border>

            <!-- Units -->
            <Border Grid.Column="1" Style="{StaticResource SurfaceCardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Total Units in Stock" Style="{StaticResource KpiLabelStyle}" />
                    <TextBlock Text="{Binding TotalUnits, StringFormat='{}{0:N2}'}" Style="{StaticResource KpiValueStyle}" />
                </StackPanel>
            </Border>

            <!-- Cost Value -->
            <Border Grid.Column="2" Style="{StaticResource SurfaceCardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Total Cost Value" Style="{StaticResource KpiLabelStyle}" />
                    <TextBlock Text="{Binding TotalCostValue, Converter={StaticResource MoneyConverter}}" Style="{StaticResource KpiValueStyle}" />
                </StackPanel>
            </Border>

            <!-- Retail Value -->
            <Border Grid.Column="3" Style="{StaticResource SurfaceCardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Total Retail Value" Style="{StaticResource KpiLabelStyle}" Foreground="{DynamicResource SuccessTextBrush}" />
                    <TextBlock Text="{Binding TotalRetailValue, Converter={StaticResource MoneyConverter}}" Style="{StaticResource KpiValueStyle}" Foreground="{DynamicResource SuccessTextBrush}" />
                </StackPanel>
            </Border>

            <!-- Potential Profit -->
            <Border Grid.Column="4" Style="{StaticResource SurfaceCardStyle}">
                <StackPanel>
                    <TextBlock Text="Potential Gross Profit" Style="{StaticResource KpiLabelStyle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding TotalPotentialProfit, Converter={StaticResource MoneyConverter}}" Style="{StaticResource KpiValueStyle}" />
                        <TextBlock Text="{Binding OverallProfitMarginPercent, StringFormat='{} ({0:N1}%)'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SuccessTextBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource TableContainerBorderStyle}">
            <DataGrid ItemsSource="{Binding Valuations}"
                      Style="{StaticResource AppDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Category Name" Binding="{Binding CategoryName}" Width="*" FontWeight="SemiBold" IsReadOnly="True" />
                    <DataGridTextColumn Header="Products" Binding="{Binding ProductCount}" Width="100"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" IsReadOnly="True" />

                    <DataGridTextColumn Header="Total Units" Binding="{Binding TotalUnits, StringFormat='{}{0:N2}'}" Width="120"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" IsReadOnly="True" />

                    <DataGridTextColumn Header="Value at Cost" Binding="{Binding TotalCostValue, Converter={StaticResource MoneyConverter}}" Width="140"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" IsReadOnly="True" />

                    <DataGridTextColumn Header="Value at Retail" Binding="{Binding TotalRetailValue, Converter={StaticResource MoneyConverter}}" Width="140"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" IsReadOnly="True" />

                    <DataGridTextColumn Header="Potential Profit" Binding="{Binding PotentialProfit, Converter={StaticResource MoneyConverter}}" Width="140"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" IsReadOnly="True" />

                    <DataGridTextColumn Header="Margin %" Binding="{Binding ProfitMarginPercent, StringFormat='{}{0:N1}%'}" Width="110"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <TextBlock Grid.Row="3" Text="{Binding Valuations.Count, StringFormat='{}Categories: {0}'}" Style="{StaticResource MutedLabelStyle}" Margin="4,10,0,0" />
    </Grid>
</UserControl>
