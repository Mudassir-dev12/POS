<UserControl x:Class="ShopPOS.UI.Views.StockMovementHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.Inventory"
             xmlns:enums="clr-namespace:ShopPOS.Core.Enums;assembly=ShopPOS.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:StockMovementHistoryViewModel}"
             Background="#F1F5F9"
             FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
             Loaded="UserControl_Loaded">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding LoadDataCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto" />
            <!-- Filters -->
            <RowDefinition Height="Auto" />
            <!-- DataGrid -->
            <RowDefinition Height="*" />
            <!-- Footer Paging -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Stock Movement History &amp; Ledger" FontSize="22" FontWeight="Bold" Foreground="#0F172A" />
                <TextBlock Text="Complete immutable audit trail of every stock increase, decrease, purchase, and adjustment." FontSize="13" Foreground="#64748B" Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Export CSV" Command="{Binding ExportCsvCommand}"
                        Background="#0F172A" Foreground="White" FontWeight="SemiBold" Padding="14,8" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand" />
                <Button Content="Refresh (F5)" Command="{Binding LoadDataCommand}"
                        Background="#E2E8F0" Foreground="#0F172A" FontWeight="SemiBold" Padding="12,8" BorderThickness="0" Cursor="Hand" />
            </StackPanel>
        </Grid>

        <!-- Filters Bar -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Product Picker -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Product Filter" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding SelectedProductName}" IsReadOnly="True" Background="#F8FAFC" Padding="6,4" />
                        <Button Grid.Column="1" Content="..." Command="{Binding SelectProductCommand}" Margin="4,0,0,0" Padding="8,4" Background="#E2E8F0" BorderThickness="0" Cursor="Hand" />
                        <Button Grid.Column="2" Content="X" Command="{Binding ClearProductCommand}" Margin="2,0,0,0" Padding="8,4" Background="#FEE2E2" Foreground="#B91C1C" BorderThickness="0" Cursor="Hand" />
                    </Grid>
                </StackPanel>

                <!-- Movement Type -->
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Movement Type" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                    <ComboBox SelectedItem="{Binding SelectedMovementType}" Padding="6,4">
                        <x:Null />
                        <enums:StockMovementType>Opening</enums:StockMovementType>
                        <enums:StockMovementType>Purchase</enums:StockMovementType>
                        <enums:StockMovementType>PurchaseReturn</enums:StockMovementType>
                        <enums:StockMovementType>Adjustment</enums:StockMovementType>
                        <enums:StockMovementType>AdjustmentCancel</enums:StockMovementType>
                        <enums:StockMovementType>Sale</enums:StockMovementType>
                        <enums:StockMovementType>SaleReturn</enums:StockMovementType>
                    </ComboBox>
                </StackPanel>

                <!-- From Date -->
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="From Date" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                    <DatePicker SelectedDate="{Binding FromDate}" Padding="6,4" />
                </StackPanel>

                <!-- To Date -->
                <StackPanel Grid.Column="3" Margin="0,0,10,0">
                    <TextBlock Text="To Date" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                    <DatePicker SelectedDate="{Binding ToDate}" Padding="6,4" />
                </StackPanel>

                <!-- Reference Search -->
                <StackPanel Grid.Column="4" Margin="0,0,10,0">
                    <TextBlock Text="Reference / Note" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                    <TextBox Text="{Binding ReferenceSearch, UpdateSourceTrigger=PropertyChanged}" Padding="6,4">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Filter" Command="{Binding SearchCommand}"
                            Background="#0F172A" Foreground="White" FontWeight="SemiBold" Padding="14,6" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand" />
                    <Button Content="Clear" Command="{Binding ClearFilterCommand}"
                            Background="#E2E8F0" Foreground="#475569" FontWeight="SemiBold" Padding="12,6" BorderThickness="0" Cursor="Hand" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="1">
            <DataGrid ItemsSource="{Binding Items}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F1F5F9"
                      RowHeight="36"
                      BorderThickness="0"
                      Background="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date &amp; Time" Binding="{Binding MovementDate, StringFormat='{}{0:dd MMM yyyy HH:mm}'}" Width="150" IsReadOnly="True" />
                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="90" FontWeight="SemiBold" IsReadOnly="True" />
                    <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*" FontWeight="Bold" IsReadOnly="True" />

                    <!-- Movement Type -->
                    <DataGridTemplateColumn Header="Type" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="3" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MovementType}" Value="{x:Static enums:StockMovementType.Purchase}">
                                                    <Setter Property="Background" Value="#DCFCE7" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding MovementType}" Value="{x:Static enums:StockMovementType.Opening}">
                                                    <Setter Property="Background" Value="#EFF6FF" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding MovementType}" Value="{x:Static enums:StockMovementType.Adjustment}">
                                                    <Setter Property="Background" Value="#FEF3C7" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding MovementType}" Value="{x:Static enums:StockMovementType.AdjustmentCancel}">
                                                    <Setter Property="Background" Value="#FEE2E2" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding MovementType}" Value="{x:Static enums:StockMovementType.PurchaseReturn}">
                                                    <Setter Property="Background" Value="#FEE2E2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding MovementType}" FontWeight="SemiBold" FontSize="11" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Quantity -->
                    <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, StringFormat='{}{0:+0.###;-0.###;0}'}" Width="100" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Padding" Value="0,0,10,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Unit Cost -->
                    <DataGridTextColumn Header="Unit Cost" Binding="{Binding UnitCost, StringFormat='${0:N2}'}" Width="95" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Padding" Value="0,0,10,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Running Balance (calculated when single product is selected) -->
                    <DataGridTextColumn Header="Balance" Binding="{Binding RunningBalance, StringFormat='{}{0:N2}'}" Width="100" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Foreground" Value="#1E40AF" />
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Padding" Value="0,0,10,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Reference -->
                    <DataGridTextColumn Header="Reference" Binding="{Binding ReferenceNumber}" Width="140" IsReadOnly="True" />

                    <!-- Note -->
                    <DataGridTextColumn Header="Note / Reason" Binding="{Binding Note}" Width="180" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer Paging -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding RowCountText}" Foreground="#64748B" FontWeight="SemiBold" VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="&lt; Prev" Command="{Binding PreviousPageCommand}"
                        Background="#E2E8F0" Foreground="#0F172A" FontWeight="SemiBold" Padding="12,6" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand" />
                <TextBlock VerticalAlignment="Center" Margin="0,0,8,0">
                    <Run Text="Page " Foreground="#64748B" />
                    <Run Text="{Binding CurrentPage}" FontWeight="Bold" Foreground="#0F172A" />
                    <Run Text=" of " Foreground="#64748B" />
                    <Run Text="{Binding TotalPages}" FontWeight="Bold" Foreground="#0F172A" />
                </TextBlock>
                <Button Content="Next &gt;" Command="{Binding NextPageCommand}"
                        Background="#E2E8F0" Foreground="#0F172A" FontWeight="SemiBold" Padding="12,6" BorderThickness="0" Cursor="Hand" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

