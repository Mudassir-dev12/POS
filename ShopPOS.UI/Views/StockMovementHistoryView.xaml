<UserControl x:Class="ShopPOS.UI.Views.StockMovementHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.Inventory"
             xmlns:enums="clr-namespace:ShopPOS.Core.Enums;assembly=ShopPOS.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:StockMovementHistoryViewModel}"
             Background="{DynamicResource PageBackgroundBrush}"
             FontFamily="{StaticResource AppFontFamily}"
             Loaded="UserControl_Loaded">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding LoadDataCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto" />
            <!-- Filters -->
            <RowDefinition Height="Auto" />
            <!-- DataGrid -->
            <RowDefinition Height="*" />
            <!-- Footer Paging -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Stock Movement History &amp; Ledger" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Complete immutable audit trail of every stock increase, decrease, purchase, and adjustment." Style="{StaticResource SubTitleStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Export CSV" Command="{Binding ExportCsvCommand}"
                        Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,8,0" />
                <Button Content="Refresh (F5)" Command="{Binding LoadDataCommand}"
                        Style="{StaticResource ToolbarButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- Filters Bar -->
        <Border Grid.Row="1" Style="{StaticResource FilterBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Product Picker -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Product Filter" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding SelectedProductName}" IsReadOnly="True" Style="{StaticResource InputTextBoxStyle}" />
                        <Button Grid.Column="1" Content="..." Command="{Binding SelectProductCommand}" Margin="4,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" />
                        <Button Grid.Column="2" Content="X" Command="{Binding ClearProductCommand}" Margin="2,0,0,0" Style="{StaticResource DangerButtonStyle}" Padding="8,4" />
                    </Grid>
                </StackPanel>

                <!-- Movement Type -->
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Movement Type" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                    <ComboBox SelectedItem="{Binding SelectedMovementType}" Style="{StaticResource InputComboBoxStyle}">
                        <x:Null />
                        <enums:StockMovementType>Opening</enums:StockMovementType>
                        <enums:StockMovementType>Purchase</enums:StockMovementType>
                        <enums:StockMovementType>PurchaseReturn</enums:StockMovementType>
                        <enums:StockMovementType>Adjustment</enums:StockMovementType>
                        <enums:StockMovementType>AdjustmentCancel</enums:StockMovementType>
                        <enums:StockMovementType>Sale</enums:StockMovementType>
                        <enums:StockMovementType>SaleReturn</enums:StockMovementType>
                    </ComboBox>
                </StackPanel>

                <!-- From Date -->
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="From Date" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                    <DatePicker SelectedDate="{Binding FromDate}" Padding="6,4" />
                </StackPanel>

                <!-- To Date -->
                <StackPanel Grid.Column="3" Margin="0,0,10,0">
                    <TextBlock Text="To Date" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                    <DatePicker SelectedDate="{Binding ToDate}" Padding="6,4" />
                </StackPanel>

                <!-- Reference Search -->
                <StackPanel Grid.Column="4" Margin="0,0,10,0">
                    <TextBlock Text="Reference / Note" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding ReferenceSearch, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Filter" Command="{Binding SearchCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,0" />
                    <Button Content="Clear" Command="{Binding ClearFilterCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource TableContainerBorderStyle}">
            <DataGrid ItemsSource="{Binding Items}"
                      Style="{StaticResource AppDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date &amp; Time" Binding="{Binding MovementDate, Converter={StaticResource DateDisplayConverter}}" Width="150" IsReadOnly="True" />
                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="100"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*" FontWeight="SemiBold" IsReadOnly="True" />

                    <!-- Movement Type -->
                    <DataGridTemplateColumn Header="Type" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="3" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MovementType}" Value="{x:Static enums:StockMovementType.Purchase}">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding MovementType}" Value="{x:Static enums:StockMovementType.Opening}">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceCardSubtleBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding MovementType}" Value="{x:Static enums:StockMovementType.Adjustment}">
                                                    <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding MovementType}" Value="{x:Static enums:StockMovementType.AdjustmentCancel}">
                                                    <Setter Property="Background" Value="{DynamicResource DangerBackgroundBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding MovementType}" Value="{x:Static enums:StockMovementType.PurchaseReturn}">
                                                    <Setter Property="Background" Value="{DynamicResource DangerBackgroundBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding MovementType}" FontWeight="SemiBold" FontSize="11" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Quantity -->
                    <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, StringFormat='{}{0:+0.###;-0.###;0}'}" Width="100"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" IsReadOnly="True" />

                    <!-- Unit Cost -->
                    <DataGridTextColumn Header="Unit Cost" Binding="{Binding UnitCost, Converter={StaticResource MoneyConverter}}" Width="110"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" IsReadOnly="True" />

                    <!-- Running Balance (calculated when single product is selected) -->
                    <DataGridTextColumn Header="Balance" Binding="{Binding RunningBalance, StringFormat='{}{0:N2}'}" Width="100"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" IsReadOnly="True" />

                    <!-- Reference -->
                    <DataGridTextColumn Header="Reference" Binding="{Binding ReferenceNumber}" Width="140"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" IsReadOnly="True" />

                    <!-- Note -->
                    <DataGridTextColumn Header="Note / Reason" Binding="{Binding Note}" Width="180" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer Paging -->
        <Border Grid.Row="3" Style="{StaticResource PaginationBarStyle}">
            <Grid>
                <TextBlock Grid.Column="0" Text="{Binding RowCountText}" Style="{StaticResource MutedLabelStyle}" VerticalAlignment="Center" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="&lt; Prev" Command="{Binding PreviousPageCommand}" Style="{StaticResource PaginationButtonStyle}" />
                    <TextBlock VerticalAlignment="Center" Margin="8,0">
                        <Run Text="Page " Foreground="{DynamicResource TextMutedBrush}" />
                        <Run Text="{Binding CurrentPage}" FontWeight="Bold" />
                        <Run Text=" of " Foreground="{DynamicResource TextMutedBrush}" />
                        <Run Text="{Binding TotalPages}" FontWeight="Bold" />
                    </TextBlock>
                    <Button Content="Next &gt;" Command="{Binding NextPageCommand}" Style="{StaticResource PaginationButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
