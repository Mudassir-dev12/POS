<UserControl x:Class="ShopPOS.UI.Views.CategoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.Categories"
             xmlns:dto="clr-namespace:ShopPOS.Core.DTOs;assembly=ShopPOS.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CategoriesViewModel}"
             Background="#F1F5F9"
             FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
             Loaded="UserControl_Loaded">

    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding AddCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteOrDeactivateCommand}" />
        <KeyBinding Key="Enter" Command="{Binding EditCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header bar -->
            <RowDefinition Height="Auto" />
            <!-- Toolbar & Filter -->
            <RowDefinition Height="Auto" />
            <!-- TreeView Body -->
            <RowDefinition Height="*" />
            <!-- Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Categories Hierarchy" FontSize="22" FontWeight="Bold" Foreground="#0F172A" />
                <TextBlock Text="Organize catalog taxonomy into multi-level parent and subcategories." FontSize="13" Foreground="#64748B" Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="+ Add Root Category (Ctrl+N)"
                        Command="{Binding AddCommand}"
                        IsEnabled="{Binding CanAdd}"
                        Background="#2563EB"
                        Foreground="White"
                        FontWeight="Bold"
                        Padding="14,8"
                        BorderThickness="0"
                        Cursor="Hand" />

                <Button Content="+ Add Subcategory"
                        Command="{Binding AddChildCategoryCommand}"
                        IsEnabled="{Binding CanAdd}"
                        Background="#0284C7"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Padding="12,8"
                        BorderThickness="0"
                        Cursor="Hand" />

                <Button Content="✏️ Edit / Rename"
                        Command="{Binding EditCommand}"
                        IsEnabled="{Binding CanEdit}"
                        Background="#475569"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Padding="12,8"
                        BorderThickness="0"
                        Cursor="Hand" />

                <Button Content="🗑️ Deactivate / Delete (Del)"
                        Command="{Binding DeleteOrDeactivateCommand}"
                        IsEnabled="{Binding CanDelete}"
                        Background="#DC2626"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Padding="12,8"
                        BorderThickness="0"
                        Cursor="Hand" />

                <Button Content="🔄 Refresh (F5)"
                        Command="{Binding RefreshCommand}"
                        Background="#E2E8F0"
                        Foreground="#334155"
                        FontWeight="SemiBold"
                        Padding="12,8"
                        BorderThickness="0"
                        Cursor="Hand" />
            </StackPanel>
        </Grid>

        <!-- Filter bar -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16,10" Margin="0,0,0,14" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <CheckBox Content="Show Inactive Categories"
                          IsChecked="{Binding ShowInactive}"
                          FontWeight="Medium"
                          Foreground="#64748B"
                          VerticalAlignment="Center" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Main TreeView -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14">
            <TreeView ItemsSource="{Binding CategoryTree}"
                      SelectedItemChanged="TreeView_SelectedItemChanged"
                      BorderThickness="0">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type dto:CategoryDto}" ItemsSource="{Binding SubCategories}">
                        <StackPanel Orientation="Horizontal" Margin="4,4" Opacity="{Binding IsActive, Converter={StaticResource InactiveOpacityConverter}}">
                            <TextBlock Text="📁 " FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center" />
                            <Border Background="#F1F5F9" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ProductCount, StringFormat='{}{0} products'}" FontSize="11" Foreground="#64748B" />
                            </Border>
                            <Border Background="#FEE2E2" CornerRadius="4" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding IsActive, Converter={StaticResource InverseBooleanConverter}}">
                                <TextBlock Text="Inactive" FontSize="10" Foreground="#DC2626" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="Select a category and press Enter or double-click to edit, Del to deactivate or delete." FontSize="12" Foreground="#94A3B8" />
        </Border>
    </Grid>
</UserControl>
