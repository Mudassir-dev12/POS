<UserControl x:Class="ShopPOS.UI.Views.CategoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.Categories"
             xmlns:dto="clr-namespace:ShopPOS.Core.DTOs;assembly=ShopPOS.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CategoriesViewModel}"
             Loaded="UserControl_Loaded">

    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding AddCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Gesture="Ctrl+A" Command="{Binding SelectAllOnPageCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" />
        <KeyBinding Key="Enter" Command="{Binding EditCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header bar -->
            <RowDefinition Height="Auto" />
            <!-- Toolbar & Filter -->
            <RowDefinition Height="Auto" />
            <!-- TreeView Body -->
            <RowDefinition Height="*" />
            <!-- Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Categories hierarchy" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Organize catalog taxonomy into multi-level parent and subcategories."
                           Style="{StaticResource SubTitleStyle}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Add root category Ctrl N"
                        Command="{Binding AddCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,8,0" />

                <Button Content="Add subcategory"
                        Command="{Binding AddChildCategoryCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Margin="0,0,8,0" />

                <Button Content="Edit"
                        Command="{Binding EditCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Margin="0,0,8,0" />

                <Button Content="Refresh F5"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource ToolbarButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- 2. Filter Bar -->
        <Border Grid.Row="1" Style="{StaticResource FilterBarStyle}">
            <Grid>
                <CheckBox Content="Show Inactive Categories"
                          IsChecked="{Binding ShowInactive}"
                          VerticalAlignment="Center" />
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource DangerBrush}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 3. Main TreeView -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Bulk Selection Status Banner -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SecondaryBackgroundBrush}"
                    BorderBrush="{DynamicResource SecondaryBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,8"
                    Margin="0,0,0,10"
                    Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectionStatusText}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <Button Content="Clear selection"
                                Command="{Binding ClearSelectionCommand}"
                                Style="{StaticResource GhostButtonStyle}"
                                Padding="8,2"
                                Margin="8,0,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Delete selected"
                                Command="{Binding DeleteSelectedCommand}"
                                Style="{StaticResource DangerButtonStyle}"
                                Visibility="{Binding CanShowDeleteSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Margin="0,0,8,0" />
                        <Button Content="Cancel selected"
                                Command="{Binding CancelSelectedCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Visibility="{Binding CanShowCancelSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Select All Filtered Results Cross-Page Banner -->
            <Border Grid.Row="1"
                    Background="{DynamicResource WarningBackgroundBrush}"
                    BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,8"
                    Margin="0,0,0,10"
                    Visibility="{Binding ShowSelectAllResultsBanner, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding SelectAllResultsBannerText}"
                               Foreground="{DynamicResource WarningTextBrush}"
                               FontWeight="Medium"
                               VerticalAlignment="Center" />
                    <Button Content="Select all matching results across all pages"
                            Command="{Binding SelectAllFilteredResultsCommand}"
                            Style="{StaticResource GhostButtonStyle}"
                            FontWeight="Bold"
                            Foreground="{DynamicResource WarningTextBrush}"
                            Margin="8,0,0,0" />
                </StackPanel>
            </Border>

            <!-- TreeView Container -->
            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="16">
                <TreeView ItemsSource="{Binding CategoryTree}"
                          SelectedItemChanged="TreeView_SelectedItemChanged"
                          Background="Transparent"
                          BorderThickness="0">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type dto:CategoryDto}" ItemsSource="{Binding SubCategories}">
                            <StackPanel Orientation="Horizontal" Margin="4,4" Opacity="{Binding IsActive, Converter={StaticResource InactiveOpacityConverter}}">
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                          Command="{Binding DataContext.ItemSelectionChangedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding}"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center" />

                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" />

                                <Border Background="{DynamicResource TableHeaderBackgroundBrush}"
                                        BorderBrush="{DynamicResource ThinRuleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Padding="6,1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ProductCount, StringFormat='{}{0} products'}"
                                               FontFamily="{StaticResource AppMonospaceFontFamily}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>

                                <Border Style="{StaticResource StockTagOut}"
                                        Margin="6,0,0,0"
                                        Visibility="{Binding IsActive, Converter={StaticResource InverseBooleanConverter}}">
                                    <TextBlock Text="Inactive"
                                               FontFamily="{StaticResource AppMonospaceFontFamily}"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource DangerOutlineTextBrush}" />
                                </Border>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>
        </Grid>

        <!-- 4. Footer -->
        <Border Grid.Row="3" Style="{StaticResource PaginationBarStyle}">
            <TextBlock Text="Select a category and press Enter or double-click to edit, Del to deactivate or delete."
                       FontFamily="{StaticResource AppMonospaceFontFamily}"
                       FontSize="11"
                       Foreground="{DynamicResource TextMutedBrush}"
                       VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
