<UserControl x:Class="ShopPOS.UI.Views.ReorderListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.Inventory"
             xmlns:enums="clr-namespace:ShopPOS.Core.Enums;assembly=ShopPOS.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ReorderListViewModel}"
             Background="{DynamicResource PageBackgroundBrush}"
             FontFamily="{StaticResource AppFontFamily}"
             Loaded="UserControl_Loaded">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding LoadDataCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto" />
            <!-- Supplier Action Bar -->
            <RowDefinition Height="Auto" />
            <!-- DataGrid -->
            <RowDefinition Height="*" />
            <!-- Footer Summary -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Inventory Reorder &amp; Purchase Suggestions" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Automated replenishment suggestions based on current stock, alert thresholds, and reorder multipliers." Style="{StaticResource SubTitleStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Refresh (F5)" Command="{Binding LoadDataCommand}"
                        Style="{StaticResource ToolbarButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- Supplier & PO Action Bar -->
        <Border Grid.Row="1" Style="{StaticResource FilterBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Select Supplier for Purchase:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Suppliers}"
                          SelectedValue="{Binding SelectedSupplierId}"
                          SelectedValuePath="Id"
                          DisplayMemberPath="Name"
                          Style="{StaticResource InputComboBoxStyle}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Text="Selected Items: " Style="{StaticResource MutedLabelStyle}" />
                    <TextBlock Text="{Binding SelectedCount}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" Margin="0,0,16,0" />

                    <TextBlock Text="Estimated Total Cost: " Style="{StaticResource MutedLabelStyle}" />
                    <TextBlock Text="{Binding SelectedTotalCost, Converter={StaticResource MoneyConverter}}" Foreground="{DynamicResource SuccessTextBrush}" FontWeight="Bold" />
                </StackPanel>

                <Button Grid.Column="3"
                        Content="Create Draft Purchase Order"
                        Command="{Binding CreatePurchaseDraftCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </Grid>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource TableContainerBorderStyle}">
            <DataGrid ItemsSource="{Binding Items}"
                      Style="{StaticResource AppDataGridStyle}">
                <DataGrid.Columns>
                    <!-- Checkbox -->
                    <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50">
                        <DataGridCheckBoxColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding DataContext.SelectAll, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                            </DataTemplate>
                        </DataGridCheckBoxColumn.HeaderTemplate>
                    </DataGridCheckBoxColumn>

                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="100"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*" FontWeight="SemiBold" IsReadOnly="True" />
                    <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="130" IsReadOnly="True" />

                    <DataGridTextColumn Header="Current Stock" Binding="{Binding CurrentStock, StringFormat='{}{0:N2}'}" Width="110"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" IsReadOnly="True" />

                    <!-- Status -->
                    <DataGridTemplateColumn Header="Status" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="3" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:StockStatus.Low}">
                                                    <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:StockStatus.OutOfStock}">
                                                    <Setter Property="Background" Value="{DynamicResource DangerBackgroundBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:StockStatus.Negative}">
                                                    <Setter Property="Background" Value="{DynamicResource DangerBackgroundBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontWeight="Bold" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:StockStatus.Low}">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
                                                        <Setter Property="Text" Value="Low stock" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:StockStatus.OutOfStock}">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        <Setter Property="Text" Value="Out of stock" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:StockStatus.Negative}">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        <Setter Property="Text" Value="Negative" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Alert Level" Binding="{Binding ReorderLevel, StringFormat='{}{0:N0}'}" Width="90"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" IsReadOnly="True" />

                    <DataGridTextColumn Header="Multiplier" Binding="{Binding Multiplier, StringFormat='{}{0:N1}x'}" Width="80"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" IsReadOnly="True" />

                    <!-- Suggested Order Quantity (Editable) -->
                    <DataGridTemplateColumn Header="Suggested Qty *" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding SuggestedQuantity, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.###}'}"
                                         FontWeight="Bold"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         Padding="6,2"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Unit Cost" Binding="{Binding CostPrice, Converter={StaticResource MoneyConverter}}" Width="110"
                                        ElementStyle="{StaticResource MonospaceNumericCell}" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <TextBlock Grid.Row="3" Text="{Binding Items.Count, StringFormat='{}Items Needing Reorder: {0}'}" Style="{StaticResource MutedLabelStyle}" Margin="4,10,0,0" />
    </Grid>
</UserControl>
