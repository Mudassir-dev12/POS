<UserControl x:Class="ShopPOS.UI.Views.StockAdjustmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.Inventory"
             xmlns:enums="clr-namespace:ShopPOS.Core.Enums;assembly=ShopPOS.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:StockAdjustmentsViewModel}"
             Background="{DynamicResource PageBackgroundBrush}"
             FontFamily="{StaticResource AppFontFamily}"
             Loaded="UserControl_Loaded">

    <UserControl.InputBindings>
        <KeyBinding Gesture="Ctrl+A" Command="{Binding SelectAllOnPageCommand}" />
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewAdjustmentCommand}" />
        <KeyBinding Key="Enter" Command="{Binding OpenAdjustmentCommand}" />
        <KeyBinding Key="F5" Command="{Binding LoadDataCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto" />
            <!-- Filters -->
            <RowDefinition Height="Auto" />
            <!-- DataGrid -->
            <RowDefinition Height="*" />
            <!-- Footer Paging -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Inventory Stock Adjustments" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Record and audit manual stock adjustments for damages, expirations, discrepancies, and corrections." Style="{StaticResource SubTitleStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="+ New Adjustment (Ctrl+N)"
                        Command="{Binding NewAdjustmentCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" />
                <Button Content="Open / Edit (Enter)"
                        Command="{Binding OpenAdjustmentCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                <Button Content="Post"
                        Command="{Binding PostAdjustmentCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" />
                <Button Content="Cancel Adjustment"
                        Command="{Binding CancelAdjustmentCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                <Button Content="Delete Draft"
                        Command="{Binding DeleteAdjustmentCommand}"
                        Style="{StaticResource DangerButtonStyle}" Margin="0,0,8,0" />
                <Button Content="Refresh (F5)"
                        Command="{Binding LoadDataCommand}"
                        Style="{StaticResource ToolbarButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- Filters Bar -->
        <Border Grid.Row="1" Style="{StaticResource FilterBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- From Date -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="From Date" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                    <DatePicker SelectedDate="{Binding FromDate}" Padding="6,4" />
                </StackPanel>

                <!-- To Date -->
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="To Date" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                    <DatePicker SelectedDate="{Binding ToDate}" Padding="6,4" />
                </StackPanel>

                <!-- Status -->
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="Status" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                    <ComboBox SelectedItem="{Binding SelectedStatus}" Style="{StaticResource InputComboBoxStyle}">
                        <x:Null />
                        <enums:StockAdjustmentStatus>Draft</enums:StockAdjustmentStatus>
                        <enums:StockAdjustmentStatus>Posted</enums:StockAdjustmentStatus>
                        <enums:StockAdjustmentStatus>Cancelled</enums:StockAdjustmentStatus>
                    </ComboBox>
                </StackPanel>

                <!-- Action Button -->
                <Button Grid.Column="3" Content="Filter" Command="{Binding LoadDataCommand}"
                        VerticalAlignment="Bottom" HorizontalAlignment="Left"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </Grid>
        </Border>

        <!-- DataGrid -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Bulk Selection Banner & Toolbar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceCardSubtleBrush}"
                    BorderBrush="{DynamicResource TableSelectedBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,8"
                    Margin="0,0,0,10"
                    Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectionStatusText}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <Button Content="Clear selection" Command="{Binding ClearSelectionCommand}"
                                Style="{StaticResource GhostButtonStyle}" Margin="8,0,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Delete Selected" Command="{Binding DeleteSelectedCommand}"
                                Visibility="{Binding CanShowDeleteSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource DangerButtonStyle}" Margin="0,0,8,0" />
                        <Button Content="Cancel Selected" Command="{Binding CancelSelectedCommand}"
                                Visibility="{Binding CanShowCancelSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Select All Filtered Results Banner -->
            <Border Grid.Row="1"
                    Background="{DynamicResource WarningBackgroundBrush}"
                    BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,8"
                    Margin="0,0,0,10"
                    Visibility="{Binding ShowSelectAllResultsBanner, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding SelectAllResultsBannerText}" Foreground="{DynamicResource WarningTextBrush}" FontWeight="Medium" VerticalAlignment="Center" />
                    <Button Content="Click here to select all matching results" Command="{Binding SelectAllFilteredResultsCommand}"
                            Style="{StaticResource GhostButtonStyle}" Foreground="{DynamicResource WarningTextBrush}" FontWeight="Bold" Margin="8,0,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource TableContainerBorderStyle}">
                <DataGrid ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedAdjustment}"
                          Style="{StaticResource AppDataGridStyle}">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <!-- Selection Checkbox Column -->
                        <DataGridTemplateColumn Width="40" CanUserResize="False">
                            <DataGridTemplateColumn.Header>
                                <CheckBox IsChecked="{Binding DataContext.IsAllOnPageSelected, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                          Command="{Binding DataContext.ToggleSelectAllOnPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                              Command="{Binding DataContext.ItemSelectionChangedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Adjustment #" Binding="{Binding AdjustmentNumber}" Width="150"
                                            ElementStyle="{StaticResource MonospaceNumericCell}" IsReadOnly="True" />
                        <DataGridTextColumn Header="Date" Binding="{Binding AdjustmentDate, Converter={StaticResource DateDisplayConverter}}" Width="140" IsReadOnly="True" />
                        <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="150" FontWeight="Medium" IsReadOnly="True" />
                        <DataGridTextColumn Header="Items" Binding="{Binding ItemCount}" Width="80"
                                            ElementStyle="{StaticResource MonospaceNumericCell}" IsReadOnly="True" />

                        <DataGridTextColumn Header="Total Val Diff" Binding="{Binding TotalValueDifference, Converter={StaticResource MoneyConverter}}" Width="140"
                                            ElementStyle="{StaticResource MonospaceNumericCell}" IsReadOnly="True" />

                        <!-- Status -->
                        <DataGridTemplateColumn Header="Status" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="8,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:StockAdjustmentStatus.Posted}">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:StockAdjustmentStatus.Draft}">
                                                        <Setter Property="Background" Value="{DynamicResource SurfaceCardSubtleBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:StockAdjustmentStatus.Cancelled}">
                                                        <Setter Property="Background" Value="{DynamicResource DangerBackgroundBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}" FontWeight="Bold" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:StockAdjustmentStatus.Posted}">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:StockAdjustmentStatus.Draft}">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:StockAdjustmentStatus.Cancelled}">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Footer Paging -->
        <Border Grid.Row="3" Style="{StaticResource PaginationBarStyle}">
            <Grid>
                <TextBlock Grid.Column="0" Text="{Binding RowCountText}" Style="{StaticResource MutedLabelStyle}" VerticalAlignment="Center" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="&lt; Prev" Command="{Binding PreviousPageCommand}" Style="{StaticResource PaginationButtonStyle}" />
                    <TextBlock VerticalAlignment="Center" Margin="8,0">
                        <Run Text="Page " Foreground="{DynamicResource TextMutedBrush}" />
                        <Run Text="{Binding CurrentPage}" FontWeight="Bold" />
                        <Run Text=" of " Foreground="{DynamicResource TextMutedBrush}" />
                        <Run Text="{Binding TotalPages}" FontWeight="Bold" />
                    </TextBlock>
                    <Button Content="Next &gt;" Command="{Binding NextPageCommand}" Style="{StaticResource PaginationButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
