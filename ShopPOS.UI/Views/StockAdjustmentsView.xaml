<UserControl x:Class="ShopPOS.UI.Views.StockAdjustmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.Inventory"
             xmlns:enums="clr-namespace:ShopPOS.Core.Enums;assembly=ShopPOS.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:StockAdjustmentsViewModel}"
             Background="#F1F5F9"
             FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
             Loaded="UserControl_Loaded">

    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewAdjustmentCommand}" />
        <KeyBinding Key="Enter" Command="{Binding OpenAdjustmentCommand}" />
        <KeyBinding Key="F5" Command="{Binding LoadDataCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto" />
            <!-- Filters -->
            <RowDefinition Height="Auto" />
            <!-- DataGrid -->
            <RowDefinition Height="*" />
            <!-- Footer Paging -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Inventory Stock Adjustments" FontSize="22" FontWeight="Bold" Foreground="#0F172A" />
                <TextBlock Text="Record and audit manual stock adjustments for damages, expirations, discrepancies, and corrections." FontSize="13" Foreground="#64748B" Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="+ New Adjustment (Ctrl+N)"
                        Command="{Binding NewAdjustmentCommand}"
                        Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="14,8" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand" />
                <Button Content="Open / Edit (Enter)"
                        Command="{Binding OpenAdjustmentCommand}"
                        Background="#E2E8F0" Foreground="#0F172A" FontWeight="SemiBold" Padding="12,8" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand" />
                <Button Content="Post"
                        Command="{Binding PostAdjustmentCommand}"
                        Background="#16A34A" Foreground="White" FontWeight="SemiBold" Padding="14,8" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand" />
                <Button Content="Cancel Adjustment"
                        Command="{Binding CancelAdjustmentCommand}"
                        Background="#E2E8F0" Foreground="#B91C1C" FontWeight="SemiBold" Padding="12,8" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand" />
                <Button Content="Delete Draft"
                        Command="{Binding DeleteAdjustmentCommand}"
                        Background="#FEE2E2" Foreground="#B91C1C" FontWeight="SemiBold" Padding="12,8" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand" />
                <Button Content="Refresh (F5)"
                        Command="{Binding LoadDataCommand}"
                        Background="#E2E8F0" Foreground="#0F172A" FontWeight="SemiBold" Padding="12,8" BorderThickness="0" Cursor="Hand" />
            </StackPanel>
        </Grid>

        <!-- Filters Bar -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- From Date -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="From Date" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                    <DatePicker SelectedDate="{Binding FromDate}" Padding="6,4" />
                </StackPanel>

                <!-- To Date -->
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="To Date" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                    <DatePicker SelectedDate="{Binding ToDate}" Padding="6,4" />
                </StackPanel>

                <!-- Status -->
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="Status" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" />
                    <ComboBox SelectedItem="{Binding SelectedStatus}" Padding="6,4">
                        <x:Null />
                        <enums:StockAdjustmentStatus>Draft</enums:StockAdjustmentStatus>
                        <enums:StockAdjustmentStatus>Posted</enums:StockAdjustmentStatus>
                        <enums:StockAdjustmentStatus>Cancelled</enums:StockAdjustmentStatus>
                    </ComboBox>
                </StackPanel>

                <!-- Action Button -->
                <Button Grid.Column="3" Content="Filter" Command="{Binding LoadDataCommand}"
                        VerticalAlignment="Bottom" HorizontalAlignment="Left"
                        Background="#0F172A" Foreground="White" FontWeight="SemiBold" Padding="16,7" BorderThickness="0" Cursor="Hand" />
            </Grid>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="1">
            <DataGrid ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedAdjustment}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F1F5F9"
                      RowHeight="38"
                      BorderThickness="0"
                      Background="White">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Adjustment #" Binding="{Binding AdjustmentNumber}" Width="140" FontWeight="Bold" IsReadOnly="True" />
                    <DataGridTextColumn Header="Date" Binding="{Binding AdjustmentDate, StringFormat='{}{0:dd MMM yyyy HH:mm}'}" Width="135" IsReadOnly="True" />
                    <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="140" FontWeight="SemiBold" IsReadOnly="True" />
                    <DataGridTextColumn Header="Items" Binding="{Binding ItemCount}" Width="80" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Padding" Value="0,0,10,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Total Val Diff" Binding="{Binding TotalValueDifference, StringFormat='${0:N2}'}" Width="130" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Padding" Value="0,0,10,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Status -->
                    <DataGridTemplateColumn Header="Status" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="8,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:StockAdjustmentStatus.Posted}">
                                                    <Setter Property="Background" Value="#DCFCE7" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:StockAdjustmentStatus.Draft}">
                                                    <Setter Property="Background" Value="#EFF6FF" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:StockAdjustmentStatus.Cancelled}">
                                                    <Setter Property="Background" Value="#FEE2E2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}" FontWeight="Bold" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:StockAdjustmentStatus.Posted}">
                                                        <Setter Property="Foreground" Value="#15803D" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:StockAdjustmentStatus.Draft}">
                                                        <Setter Property="Foreground" Value="#1D4ED8" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:StockAdjustmentStatus.Cancelled}">
                                                        <Setter Property="Foreground" Value="#B91C1C" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer Paging -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding RowCountText}" Foreground="#64748B" FontWeight="SemiBold" VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="&lt; Prev" Command="{Binding PreviousPageCommand}"
                        Background="#E2E8F0" Foreground="#0F172A" FontWeight="SemiBold" Padding="12,6" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand" />
                <TextBlock VerticalAlignment="Center" Margin="0,0,8,0">
                    <Run Text="Page " Foreground="#64748B" />
                    <Run Text="{Binding CurrentPage}" FontWeight="Bold" Foreground="#0F172A" />
                    <Run Text=" of " Foreground="#64748B" />
                    <Run Text="{Binding TotalPages}" FontWeight="Bold" Foreground="#0F172A" />
                </TextBlock>
                <Button Content="Next &gt;" Command="{Binding NextPageCommand}"
                        Background="#E2E8F0" Foreground="#0F172A" FontWeight="SemiBold" Padding="12,6" BorderThickness="0" Cursor="Hand" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

