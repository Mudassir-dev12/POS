<UserControl x:Class="ShopPOS.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.Dashboard"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DashboardViewModel}"
             Background="#F1F5F9"
             FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
             Loaded="UserControl_Loaded">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding LoadStatsCommand}" />
    </UserControl.InputBindings>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <!-- Welcome Header & Quick Action -->
                <RowDefinition Height="Auto" />
                <!-- POS & Sales Metrics -->
                <RowDefinition Height="Auto" />
                <!-- Inventory & Purchasing Metrics -->
                <RowDefinition Height="Auto" />
                <!-- Operations Info -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 1. Welcome Header & Quick POS Button -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding WelcomeMessage}" FontSize="24" FontWeight="Bold" Foreground="#0F172A" />
                    <TextBlock Text="Store performance dashboard, real-time POS cash metrics, and inventory alerts." FontSize="13" Foreground="#64748B" Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🔄 Refresh (F5)" Command="{Binding LoadStatsCommand}"
                            Background="#E2E8F0" Foreground="#0F172A" FontWeight="SemiBold" Height="42" Padding="14,0" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand" />
                    <Button Content="🛒 Start Selling (POS)" Command="{Binding QuickStartPosCommand}"
                            Background="#16A34A" Foreground="White" FontSize="15" FontWeight="Bold" Height="42" Padding="20,0" BorderThickness="0" Cursor="Hand" />
                </StackPanel>
            </Grid>

            <!-- 2. POS & Daily Sales Metric Cards -->
            <StackPanel Grid.Row="1" Margin="0,0,0,16">
                <TextBlock Text="Today's Sales &amp; Cash Drawer" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Today's Sales -->
                    <Border Grid.Column="0" Background="White" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,10,0" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding OpenSalesCommand}" />
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="Today's Sales" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" />
                            <TextBlock Text="{Binding TodaySalesTotal, StringFormat='${0:N2}'}" FontSize="22" FontWeight="Bold" Foreground="#2563EB" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding TodaySalesCount, StringFormat='{} {0} transactions'}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Today's Profit -->
                    <Border Grid.Column="1" Background="White" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Today's Profit" FontSize="12" FontWeight="SemiBold" Foreground="#16A34A" />
                            <TextBlock Text="{Binding TodayProfit, StringFormat='${0:N2}'}" FontSize="22" FontWeight="Bold" Foreground="#16A34A" Margin="0,6,0,0" />
                            <TextBlock Text="Gross margin over COGS" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Expected Cash in Drawer -->
                    <Border Grid.Column="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,10,0" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding OpenShiftsCommand}" />
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="Cash in Drawer" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" />
                            <TextBlock Text="{Binding CashInDrawerExpected, StringFormat='${0:N2}'}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,6,0,0" />
                            <TextBlock Text="Current active shift float" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Held Bills -->
                    <Border Grid.Column="3" Background="White" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,10,0" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding OpenHeldBillsCommand}" />
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="Held Bills (Parked)" FontSize="12" FontWeight="SemiBold" Foreground="#D97706" />
                            <TextBlock Text="{Binding HeldBillsCount}" FontSize="22" FontWeight="Bold" Foreground="#D97706" Margin="0,6,0,0" />
                            <TextBlock Text="Parked sales in memory" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Customers Owing -->
                    <Border Grid.Column="4" Background="White" BorderBrush="#FECDD3" BorderThickness="1" CornerRadius="8" Padding="16" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding OpenCustomersOwingCommand}" />
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="Customers Owing" FontSize="12" FontWeight="SemiBold" Foreground="#E11D48" />
                            <TextBlock Text="{Binding CustomersOwingTotal, StringFormat='${0:N2}'}" FontSize="22" FontWeight="Bold" Foreground="#E11D48" Margin="0,6,0,0" />
                            <TextBlock Text="Total receivable balances" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- 3. Inventory & Purchasing Metrics -->
            <StackPanel Grid.Row="2" Margin="0,0,0,16">
                <TextBlock Text="Inventory &amp; Supplier Payables" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10" />
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Low Stock -->
                    <Border Grid.Column="0" Background="White" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,10,0" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding OpenLowStockCommand}" />
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="Low Stock Warnings" FontSize="12" FontWeight="SemiBold" Foreground="#D97706" />
                            <TextBlock Text="{Binding Stats.LowStockCount}" FontSize="22" FontWeight="Bold" Foreground="#D97706" Margin="0,6,0,0" />
                            <TextBlock Text="At or below reorder level" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Out of Stock -->
                    <Border Grid.Column="1" Background="White" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,10,0" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding OpenOutOfStockCommand}" />
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="Out of Stock Items" FontSize="12" FontWeight="SemiBold" Foreground="#DC2626" />
                            <TextBlock Text="{Binding Stats.OutOfStockCount}" FontSize="22" FontWeight="Bold" Foreground="#DC2626" Margin="0,6,0,0" />
                            <TextBlock Text="Zero or negative stock" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Total Products -->
                    <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Catalog Products" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" />
                            <TextBlock Text="{Binding Stats.TotalProducts}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,6,0,0" />
                            <TextBlock Text="Active items in store" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Stock Value at Cost -->
                    <Border Grid.Column="3" Background="White" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Stock Value (Cost)" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" />
                            <TextBlock Text="{Binding Stats.StockValueAtCost, StringFormat='${0:N2}'}" FontSize="22" FontWeight="Bold" Foreground="#2563EB" Margin="0,6,0,0" />
                            <TextBlock Text="Weighted unit cost" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Supplier Payables -->
                    <Border Grid.Column="4" Background="White" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Supplier Payables" FontSize="12" FontWeight="SemiBold" Foreground="#7C3AED" />
                            <TextBlock Text="{Binding Stats.SupplierPayableTotal, StringFormat='${0:N2}'}" FontSize="22" FontWeight="Bold" Foreground="#7C3AED" Margin="0,6,0,0" />
                            <TextBlock Text="Total owed to suppliers" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- 4. Quick Recommendations Card -->
            <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel>
                    <TextBlock Text="Operational Status &amp; Daily Checklist" FontSize="15" FontWeight="Bold" Foreground="#0F172A" />
                    <TextBlock Text="Ensure your shift is opened before starting POS transactions, check low stock alerts, and reconcile drawer before closing." FontSize="13" Foreground="#475569" Margin="0,3,0,10" />

                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <TextBlock Text="• Start Selling (POS): High-speed barcode scanning, fast search, multi-tenders and receipts." Foreground="#64748B" Margin="0,2" />
                            <TextBlock Text="• Shifts &amp; Drawer: Reconcile opening float, manage cash in/out, print X/Z reports." Foreground="#64748B" Margin="0,2" />
                            <TextBlock Text="• Customer Returns: Select previous invoice or process refund lines with automatic stock restoration." Foreground="#64748B" Margin="0,2" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
