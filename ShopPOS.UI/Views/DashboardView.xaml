<UserControl x:Class="ShopPOS.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.Dashboard"
             mc:Ignorable="d"
             Loaded="UserControl_Loaded"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding LoadStatsCommand}" />
    </UserControl.InputBindings>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,0,0,24">
            <Grid.RowDefinitions>
                <!-- Top Header: Date, Title & Actions -->
                <RowDefinition Height="Auto" />
                <!-- KPI Strip -->
                <RowDefinition Height="Auto" />
                <!-- Middle Section: 30-Day Sales Chart + Top 5 Products -->
                <RowDefinition Height="Auto" />
                <!-- Lower Split: Stock & Payables + Daily Checklist -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ================= 1. TOP HEADER ================= -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <!-- Cloud Backup Warning Banner -->
                <Border Background="{DynamicResource DangerBackgroundBrush}"
                        BorderBrush="{DynamicResource DangerBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,10"
                        Margin="0,0,0,12"
                        Visibility="{Binding HasCloudBackupWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="GOOGLE DRIVE BACKUP WARNING" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding CloudBackupWarningMessage}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="View Backups"
                                Command="{Binding OpenBackupRestoreCommand}"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                Padding="14,6"
                                VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Backup Warning Banner -->
                <Border Background="{DynamicResource WarningBackgroundBrush}"
                        BorderBrush="{DynamicResource WarningBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,10"
                        Margin="0,0,0,16"
                        Visibility="{Binding HasBackupWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="BACKUP ATTENTION REQUIRED" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" FontSize="12" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding BackupWarningMessage}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Backup Now"
                                Command="{Binding BackupNowCommand}"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                Padding="14,6"
                                VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <!-- Small Uppercase Monospaced Date Line -->
                    <TextBlock Text="{Binding TodayDateFormatted}"
                               FontFamily="{StaticResource AppMonospaceFontFamily}"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,0,0,4" />

                    <!-- Large Page Title -->
                    <TextBlock Text="Today in the store"
                               Style="{StaticResource PageTitleStyle}" />
                </StackPanel>

                <!-- Header Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Refresh F5"
                            Command="{Binding LoadStatsCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,10,0" />

                    <Button Content="Start selling F2"
                            Command="{Binding StartSellingCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
                </Grid>
            </StackPanel>

            <!-- ================= 2. KPI STRIP (5 Metrics) ================= -->
            <Border Grid.Row="1"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="0"
                    Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Metric 1: Today's Sales -->
                    <StackPanel Grid.Column="0" Margin="18,16">
                        <TextBlock Text="TODAY'S SALES" Style="{StaticResource KpiLabelStyle}" />
                        <TextBlock Text="{Binding TodaySalesTotal, Converter={StaticResource MoneyConverter}}"
                                   Style="{StaticResource KpiValueStyle}" />
                        <TextBlock Text="{Binding SalesVsYesterdayText}"
                                   FontFamily="{StaticResource AppMonospaceFontFamily}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding SalesVsYesterdayText, Converter={StaticResource StringToVisibilityConverter}}" />
                    </StackPanel>

                    <!-- Divider 1 -->
                    <Border Grid.Column="1" Background="{DynamicResource ThinRuleBrush}" />

                    <!-- Metric 2: Today's Profit -->
                    <StackPanel Grid.Column="2" Margin="18,16">
                        <TextBlock Text="TODAY'S PROFIT" Style="{StaticResource KpiLabelStyle}" />
                        <TextBlock Text="{Binding TodayProfit, Converter={StaticResource MoneyConverter}}"
                                   Style="{StaticResource KpiValueStyle}" />
                        <TextBlock Text="{Binding ProfitVsYesterdayText}"
                                   FontFamily="{StaticResource AppMonospaceFontFamily}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding ProfitVsYesterdayText, Converter={StaticResource StringToVisibilityConverter}}" />
                    </StackPanel>

                    <!-- Divider 2 -->
                    <Border Grid.Column="3" Background="{DynamicResource ThinRuleBrush}" />

                    <!-- Metric 3: Sales Count Today -->
                    <StackPanel Grid.Column="4" Margin="18,16">
                        <TextBlock Text="SALES COUNT" Style="{StaticResource KpiLabelStyle}" />
                        <TextBlock Text="{Binding TodaySalesCount}"
                                   Style="{StaticResource KpiValueStyle}" />
                        <TextBlock Text="{Binding SalesCountVsYesterdayText}"
                                   FontFamily="{StaticResource AppMonospaceFontFamily}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding SalesCountVsYesterdayText, Converter={StaticResource StringToVisibilityConverter}}" />
                    </StackPanel>

                    <!-- Divider 3 -->
                    <Border Grid.Column="5" Background="{DynamicResource ThinRuleBrush}" />

                    <!-- Metric 4: Held Bills (Clickable) -->
                    <Border Grid.Column="6" Background="Transparent" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding OpenHeldBillsCommand}" />
                        </Border.InputBindings>
                        <StackPanel Margin="18,16">
                            <TextBlock Text="HELD BILLS" Style="{StaticResource KpiLabelStyle}" />
                            <TextBlock Text="{Binding HeldBillsCount}"
                                       Style="{StaticResource KpiValueStyle}" />
                            <TextBlock Text="active orders paused"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Divider 4 -->
                    <Border Grid.Column="7" Background="{DynamicResource ThinRuleBrush}" />

                    <!-- Metric 5: Supplier Payables (Clickable) -->
                    <Border Grid.Column="8" Background="Transparent" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding OpenSupplierPayablesCommand}" />
                        </Border.InputBindings>
                        <StackPanel Margin="18,16">
                            <TextBlock Text="SUPPLIER PAYABLES" Style="{StaticResource KpiLabelStyle}" />
                            <TextBlock Text="{Binding SupplierPayables, Converter={StaticResource MoneyConverter}}"
                                       Style="{StaticResource KpiValueStyle}" />
                            <TextBlock Text="total balance owed"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ================= 3. MIDDLE SECTION: 30-DAY SALES CHART & TOP 5 PRODUCTS ================= -->
            <Grid Grid.Row="2" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- Left: 30-Day Net Sales Chart -->
                <Border Grid.Column="0"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="180" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="30-day net sales trend" Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock Grid.Column="1" Text="Last 30 Days" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                        </Grid>

                        <Border Grid.Row="1" Height="1" Background="{DynamicResource ThinRuleBrush}" Margin="0,0,0,12" />

                        <!-- Chart Surface with Y-Axis and Bars -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <!-- Y Axis Labels -->
                                <ColumnDefinition Width="65" />
                                <!-- Chart Canvas / Bars -->
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Y-Axis Values -->
                            <Grid Grid.Column="0" Margin="0,0,8,16">
                                <TextBlock Text="{Binding ChartMaxLabel}" FontSize="10" FontFamily="{StaticResource AppMonospaceFontFamily}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Top" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding ChartMidLabel}" FontSize="10" FontFamily="{StaticResource AppMonospaceFontFamily}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding ChartZeroLabel}" FontSize="10" FontFamily="{StaticResource AppMonospaceFontFamily}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
                            </Grid>

                            <!-- Grid Horizontal Reference Lines -->
                            <Grid Grid.Column="1" Margin="0,0,0,16">
                                <Border Height="1" Background="{DynamicResource ThinRuleBrush}" VerticalAlignment="Top" />
                                <Border Height="1" Background="{DynamicResource ThinRuleBrush}" VerticalAlignment="Center" />
                                <Border Height="1" Background="{DynamicResource BorderBrush}" VerticalAlignment="Bottom" />

                                <!-- Bars ItemsControl -->
                                <ItemsControl ItemsSource="{Binding ChartBars}" VerticalAlignment="Bottom" HorizontalAlignment="Stretch">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Bottom" ToolTipService.ToolTip="{Binding TooltipText}" Cursor="Hand" Margin="2,0">
                                                <Border Height="{Binding BarHeight}"
                                                        Background="{DynamicResource PrimaryBrush}"
                                                        CornerRadius="2,2,0,0"
                                                        MinWidth="4"
                                                        HorizontalAlignment="Stretch"
                                                        Opacity="0.85">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Opacity" Value="1.0" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>

                        <!-- X Axis Subtext -->
                        <Grid Grid.Row="3" Margin="65,4,0,0">
                            <TextBlock Text="30 days ago" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left" />
                            <TextBlock Text="Today" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Right: Top 5 Products Today -->
                <Border Grid.Column="2"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <TextBlock Grid.Row="0" Text="Top products today" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,12" />
                        <Border Grid.Row="1" Height="1" Background="{DynamicResource ThinRuleBrush}" Margin="0,0,0,12" />

                        <!-- List of Products -->
                        <ItemsControl Grid.Row="2" ItemsSource="{Binding Top5Products}" Visibility="{Binding HasTopProducts, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource ThinRuleBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding ProductName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Quantity, StringFormat='{}{0:N0} sold'}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Revenue, Converter={StaticResource MoneyConverter}}"
                                                       FontFamily="{StaticResource AppMonospaceFontFamily}" FontWeight="Bold" FontSize="13"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty State if no sales today -->
                        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasTopProducts, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <TextBlock Text="No sales recorded today yet" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                            <Button Content="Start selling F2" Command="{Binding StartSellingCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,10,0,0" Padding="12,6" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= 4. LOWER SECTION: STOCK & PAYABLES + DAILY CHECKLIST ================= -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- Left Card: Stock and Payables -->
                <Border Grid.Column="0"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="20">
                    <StackPanel>
                        <!-- Section Header -->
                        <TextBlock Text="Stock and payables" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,16" />
                        <Border Height="1" Background="{DynamicResource ThinRuleBrush}" Margin="0,0,0,8" />

                        <!-- Row 1: Low Stock Warnings -->
                        <Border Padding="10,12"
                                BorderBrush="{DynamicResource ThinRuleBrush}"
                                BorderThickness="0,0,0,1"
                                Background="Transparent"
                                Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding Gesture="LeftClick" Command="{Binding OpenLowStockCommand}" />
                            </Border.InputBindings>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Low stock warnings"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="Products at or below designated reorder level"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Style="{StaticResource StockTagLow}"
                                        Padding="10,3"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LowStockCount, StringFormat='{}{0} items'}"
                                               FontFamily="{StaticResource AppMonospaceFontFamily}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource WarningTextBrush}" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Row 2: Out of Stock Items -->
                        <Border Padding="10,12"
                                BorderBrush="{DynamicResource ThinRuleBrush}"
                                BorderThickness="0,0,0,1"
                                Background="Transparent"
                                Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding Gesture="LeftClick" Command="{Binding OpenOutOfStockCommand}" />
                            </Border.InputBindings>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Out of stock items"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="Depleted items requiring immediate purchase"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Style="{StaticResource StockTagOut}"
                                        Padding="10,3"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding OutOfStockCount, StringFormat='{}{0} items'}"
                                               FontFamily="{StaticResource AppMonospaceFontFamily}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource DangerOutlineTextBrush}" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Row 3: Products Needing Reorder -->
                        <Border Padding="10,12"
                                BorderBrush="{DynamicResource ThinRuleBrush}"
                                BorderThickness="0,0,0,1"
                                Background="Transparent"
                                Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding Gesture="LeftClick" Command="{Binding OpenReorderCommand}" />
                            </Border.InputBindings>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Products needing reorder"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="Review restock recommendations and supplier orders"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding LowStockCount}"
                                           FontFamily="{StaticResource AppMonospaceFontFamily}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Row 4: Supplier Payables -->
                        <Border Padding="10,12"
                                Background="Transparent"
                                Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding Gesture="LeftClick" Command="{Binding OpenSupplierPayablesCommand}" />
                            </Border.InputBindings>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Supplier payables"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="Outstanding balances owed across active suppliers"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SupplierPayables, Converter={StaticResource MoneyConverter}}"
                                           FontFamily="{StaticResource AppMonospaceFontFamily}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Row 5: Last Backup -->
                        <Border BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Last database backup"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="Local disaster recovery archive"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding LastBackupText}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Right Card: Daily Checklist -->
                <Border Grid.Column="2"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="20">
                    <StackPanel>
                        <!-- Section Header -->
                        <TextBlock Text="Daily checklist" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,16" />
                        <Border Height="1" Background="{DynamicResource ThinRuleBrush}" Margin="0,0,0,8" />

                        <!-- Checklist Item 1: Make a Sale Today -->
                        <Border Padding="10,12"
                                BorderBrush="{DynamicResource ThinRuleBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding ChecklistSaleMade}"
                                          IsEnabled="False"
                                          Margin="0,0,12,0"
                                          VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Make a sale today"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="At least 1 completed sale transaction"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Checklist Item 2: Check Low Stock Alerts -->
                        <Border Padding="10,12"
                                BorderBrush="{DynamicResource ThinRuleBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding ChecklistLowStockChecked}"
                                          IsEnabled="False"
                                          Margin="0,0,12,0"
                                          VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Review low stock alerts"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="Verify reorder quantities and supplier lead time"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Checklist Item 3: Backup Data -->
                        <Border Padding="10,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding ChecklistBackupCurrent}"
                                          IsEnabled="False"
                                          Margin="0,0,12,0"
                                          VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Store database backup"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="Ensure safe offline database copy in backups folder"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
