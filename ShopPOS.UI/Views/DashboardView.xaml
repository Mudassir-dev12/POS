<UserControl x:Class="ShopPOS.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.Dashboard"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,0,0,24">
            <Grid.RowDefinitions>
                <!-- Top Header: Date, Title & Actions -->
                <RowDefinition Height="Auto" />
                <!-- KPI Strip -->
                <RowDefinition Height="Auto" />
                <!-- Lower Split: Stock & Payables + Daily Checklist -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ================= TOP HEADER ================= -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <!-- Small Uppercase Monospaced Date Line -->
                    <TextBlock Text="{Binding TodayDateFormatted}"
                               FontFamily="{StaticResource AppMonospaceFontFamily}"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,0,0,4" />

                    <!-- Large Page Title -->
                    <TextBlock Text="Today in the store"
                               Style="{StaticResource PageTitleStyle}" />
                </StackPanel>

                <!-- Header Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Refresh F5"
                            Command="{Binding LoadStatsCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,10,0" />

                    <Button Content="Start selling F2"
                            Command="{Binding StartSellingCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>

            <!-- ================= KPI STRIP (5 Metrics) ================= -->
            <Border Grid.Row="1"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="0"
                    Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Metric 1: Today's Sales -->
                    <StackPanel Grid.Column="0" Margin="18,16">
                        <TextBlock Text="TODAY'S SALES" Style="{StaticResource KpiLabelStyle}" />
                        <TextBlock Text="{Binding TodaySalesTotal, Converter={StaticResource MoneyConverter}}"
                                   Style="{StaticResource KpiValueStyle}" />
                        <TextBlock Text="{Binding SalesVsYesterdayText}"
                                   FontFamily="{StaticResource AppMonospaceFontFamily}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding SalesVsYesterdayText, Converter={StaticResource StringToVisibilityConverter}}" />
                    </StackPanel>

                    <!-- Divider 1 -->
                    <Border Grid.Column="1" Background="{DynamicResource ThinRuleBrush}" />

                    <!-- Metric 2: Today's Profit -->
                    <StackPanel Grid.Column="2" Margin="18,16">
                        <TextBlock Text="TODAY'S PROFIT" Style="{StaticResource KpiLabelStyle}" />
                        <TextBlock Text="{Binding TodayProfit, Converter={StaticResource MoneyConverter}}"
                                   Style="{StaticResource KpiValueStyle}" />
                        <TextBlock Text="{Binding ProfitVsYesterdayText}"
                                   FontFamily="{StaticResource AppMonospaceFontFamily}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding ProfitVsYesterdayText, Converter={StaticResource StringToVisibilityConverter}}" />
                    </StackPanel>

                    <!-- Divider 2 -->
                    <Border Grid.Column="3" Background="{DynamicResource ThinRuleBrush}" />

                    <!-- Metric 3: Sales Count Today -->
                    <StackPanel Grid.Column="4" Margin="18,16">
                        <TextBlock Text="SALES COUNT" Style="{StaticResource KpiLabelStyle}" />
                        <TextBlock Text="{Binding TodaySalesCount}"
                                   Style="{StaticResource KpiValueStyle}" />
                        <TextBlock Text="{Binding SalesCountVsYesterdayText}"
                                   FontFamily="{StaticResource AppMonospaceFontFamily}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding SalesCountVsYesterdayText, Converter={StaticResource StringToVisibilityConverter}}" />
                    </StackPanel>

                    <!-- Divider 3 -->
                    <Border Grid.Column="5" Background="{DynamicResource ThinRuleBrush}" />

                    <!-- Metric 4: Held Bills (Clickable) -->
                    <Border Grid.Column="6" Background="Transparent" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding OpenHeldBillsCommand}" />
                        </Border.InputBindings>
                        <StackPanel Margin="18,16">
                            <TextBlock Text="HELD BILLS" Style="{StaticResource KpiLabelStyle}" />
                            <TextBlock Text="{Binding HeldBillsCount}"
                                       Style="{StaticResource KpiValueStyle}" />
                            <TextBlock Text="active orders paused"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Divider 4 -->
                    <Border Grid.Column="7" Background="{DynamicResource ThinRuleBrush}" />

                    <!-- Metric 5: Supplier Payables (Clickable) -->
                    <Border Grid.Column="8" Background="Transparent" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding OpenSupplierPayablesCommand}" />
                        </Border.InputBindings>
                        <StackPanel Margin="18,16">
                            <TextBlock Text="SUPPLIER PAYABLES" Style="{StaticResource KpiLabelStyle}" />
                            <TextBlock Text="{Binding SupplierPayables, Converter={StaticResource MoneyConverter}}"
                                       Style="{StaticResource KpiValueStyle}" />
                            <TextBlock Text="total balance owed"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ================= LOWER SECTION: STOCK & PAYABLES + DAILY CHECKLIST ================= -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- Left Card: Stock and Payables -->
                <Border Grid.Column="0"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="20">
                    <StackPanel>
                        <!-- Section Header -->
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="Stock and payables"
                                       Style="{StaticResource SectionHeaderStyle}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource ThinRuleBrush}" Margin="0,0,0,8" />

                        <!-- Row 1: Low Stock Warnings -->
                        <Border Padding="10,12"
                                BorderBrush="{DynamicResource ThinRuleBrush}"
                                BorderThickness="0,0,0,1"
                                Background="Transparent"
                                Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding Gesture="LeftClick" Command="{Binding OpenLowStockCommand}" />
                            </Border.InputBindings>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Low stock warnings"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="Products at or below designated reorder level"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Style="{StaticResource StockTagLow}"
                                        Padding="10,3"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Stats.LowStockCount, StringFormat='{}{0} items'}"
                                               FontFamily="{StaticResource AppMonospaceFontFamily}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource WarningTextBrush}" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Row 2: Out of Stock Items -->
                        <Border Padding="10,12"
                                BorderBrush="{DynamicResource ThinRuleBrush}"
                                BorderThickness="0,0,0,1"
                                Background="Transparent"
                                Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding Gesture="LeftClick" Command="{Binding OpenOutOfStockCommand}" />
                            </Border.InputBindings>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Out of stock items"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="Depleted items requiring immediate purchase"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Style="{StaticResource StockTagOut}"
                                        Padding="10,3"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Stats.OutOfStockCount, StringFormat='{}{0} items'}"
                                               FontFamily="{StaticResource AppMonospaceFontFamily}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource DangerOutlineTextBrush}" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Row 3: Catalog Products -->
                        <Border Padding="10,12"
                                BorderBrush="{DynamicResource ThinRuleBrush}"
                                BorderThickness="0,0,0,1"
                                Background="Transparent"
                                Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding Gesture="LeftClick" Command="{Binding OpenProductsCommand}" />
                            </Border.InputBindings>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Catalog products"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="Total active catalog products tracked in database"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Stats.TotalProducts}"
                                           FontFamily="{StaticResource AppMonospaceFontFamily}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Row 4: Supplier Payables -->
                        <Border Padding="10,12"
                                Background="Transparent"
                                Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding Gesture="LeftClick" Command="{Binding OpenSupplierPayablesCommand}" />
                            </Border.InputBindings>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Supplier payables"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="Outstanding balances owed across active suppliers"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SupplierPayables, Converter={StaticResource MoneyConverter}}"
                                           FontFamily="{StaticResource AppMonospaceFontFamily}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Right Card: Daily Checklist -->
                <Border Grid.Column="2"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="20">
                    <StackPanel>
                        <!-- Section Header -->
                        <TextBlock Text="Daily checklist"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="0,0,0,16" />
                        <Border Height="1" Background="{DynamicResource ThinRuleBrush}" Margin="0,0,0,8" />

                        <!-- Checklist Item 1: Make a Sale Today -->
                        <Border Padding="10,12"
                                BorderBrush="{DynamicResource ThinRuleBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding ChecklistSaleMade}"
                                          IsEnabled="False"
                                          Margin="0,0,12,0"
                                          VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Make a sale today"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="At least 1 completed customer sale transaction"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Checklist Item 2: Check Low Stock Alerts -->
                        <Border Padding="10,12"
                                BorderBrush="{DynamicResource ThinRuleBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding ChecklistLowStockChecked}"
                                          IsEnabled="False"
                                          Margin="0,0,12,0"
                                          VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Review low stock alerts"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="Verify reorder quantities and supplier lead time"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Checklist Item 3: Backup Data -->
                        <Border Padding="10,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding ChecklistBackupCurrent}"
                                          IsEnabled="False"
                                          Margin="0,0,12,0"
                                          VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Store database backup"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="Ensure safe offline database copy in C:\ShopData\Backups"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
