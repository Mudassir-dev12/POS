<UserControl x:Class="ShopPOS.UI.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.Sales"
             xmlns:enums="clr-namespace:ShopPOS.Core.Enums;assembly=ShopPOS.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SalesViewModel}"
             Background="#F8FAFC"
             FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TITLE & ACTION BUTTONS -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Sales Invoices &amp; History" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
                <TextBlock Text="Search, inspect, reprint receipts, cancel or process returns for sales." FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="View Details (Enter)" Command="{Binding OpenDetailsCommand}" Height="34" Margin="0,0,6,0" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" FontWeight="SemiBold" />
                <Button Content="Reprint Receipt" Command="{Binding ReprintSaleCommand}" Height="34" Margin="0,0,6,0" Background="#EFF6FF" Foreground="#2563EB" BorderBrush="#BFDBFE" FontWeight="SemiBold" />
                <Button Content="Process Return" Command="{Binding StartReturnCommand}" Height="34" Margin="0,0,6,0" Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECACA" FontWeight="SemiBold" />
                <Button Content="Cancel Sale" Command="{Binding CancelSaleCommand}" Height="34" Margin="0,0,6,0" Background="#FFF1F2" Foreground="#E11D48" BorderBrush="#FECDD3" />
                <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" Height="34" Margin="0,0,6,0" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" />
                <Button Content="Export PDF" Command="{Binding ExportPdfCommand}" Height="34" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" />
            </StackPanel>
        </Grid>

        <!-- FILTERS PANEL -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <WrapPanel VerticalAlignment="Center">
                <!-- Search term -->
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="Search:" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3" />
                    <TextBox Text="{Binding SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="160" Height="30" VerticalContentAlignment="Center" Padding="6,2">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding LoadSalesCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>

                <!-- Date Range -->
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="From Date:" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3" />
                    <DatePicker SelectedDate="{Binding DateFrom, Mode=TwoWay}" Width="120" Height="30" />
                </StackPanel>

                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="To Date:" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3" />
                    <DatePicker SelectedDate="{Binding DateTo, Mode=TwoWay}" Width="120" Height="30" />
                </StackPanel>

                <!-- Customer -->
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="Customer:" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3" />
                    <ComboBox ItemsSource="{Binding Customers}" SelectedValue="{Binding SelectedCustomerId, Mode=TwoWay}"
                              SelectedValuePath="Id" DisplayMemberPath="Name" Width="150" Height="30" VerticalContentAlignment="Center" />
                </StackPanel>

                <!-- Due Only -->
                <StackPanel VerticalAlignment="Bottom" Margin="0,0,14,4">
                    <CheckBox Content="With Due Only" IsChecked="{Binding WithDueOnly, Mode=TwoWay}" VerticalAlignment="Center" FontSize="12" />
                </StackPanel>

                <!-- Filter Button -->
                <Button Content="Filter / Refresh (F5)" Command="{Binding LoadSalesCommand}" Width="130" Height="30" Margin="0,16,0,0"
                        Background="#2563EB" Foreground="White" FontWeight="SemiBold" BorderThickness="0" />
            </WrapPanel>
        </Border>

        <!-- SALES GRID -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <EventSetter Event="MouseDoubleClick" Handler="OnRowDoubleClick" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Invoice #" Binding="{Binding SaleNumber}" Width="130" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="Date" Binding="{Binding SaleDate, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="140" />
                    <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName, TargetNullValue='Walk-in'}" Width="*" />
                    <DataGridTextColumn Header="Items" Binding="{Binding ItemCount}" Width="65" />
                    <DataGridTextColumn Header="Total" Binding="{Binding GrandTotal, StringFormat='${0:N2}'}" Width="100" FontWeight="Bold" />
                    <DataGridTextColumn Header="Paid" Binding="{Binding PaidAmount, StringFormat='${0:N2}'}" Width="95" Foreground="#16A34A" />
                    <DataGridTextColumn Header="Due" Binding="{Binding DueAmount, StringFormat='${0:N2}'}" Width="95" Foreground="#EA580C" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="Payment Methods" Binding="{Binding PaymentMethodsSummary}" Width="140" />
                    <DataGridTemplateColumn Header="Status" Width="95">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Status, Converter={StaticResource SaleStatusBadgeBackgroundConverter}}"
                                        CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Status}" Foreground="{Binding Status, Converter={StaticResource SaleStatusBadgeColorConverter}}"
                                               FontSize="11" FontWeight="Bold" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- FOOTER: TOTALS SUMMARY & PAGINATION -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Summary Totals in Current Filter -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#EFF6FF" CornerRadius="6" Padding="10,6" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Total Sales: " FontSize="12" Foreground="#1E3A8A" />
                        <TextBlock Text="{Binding FilteredGrandTotal, StringFormat='${0:N2}'}" FontSize="13" FontWeight="Bold" Foreground="#2563EB" />
                    </StackPanel>
                </Border>
                <Border Background="#DCFCE7" CornerRadius="6" Padding="10,6" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Total Collected: " FontSize="12" Foreground="#14532D" />
                        <TextBlock Text="{Binding FilteredPaidAmount, StringFormat='${0:N2}'}" FontSize="13" FontWeight="Bold" Foreground="#16A34A" />
                    </StackPanel>
                </Border>
                <Border Background="#FFEDD5" CornerRadius="6" Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Total Due: " FontSize="12" Foreground="#7C2D12" />
                        <TextBlock Text="{Binding FilteredDueAmount, StringFormat='${0:N2}'}" FontSize="13" FontWeight="Bold" Foreground="#EA580C" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Pagination Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding TotalCount, StringFormat='Total Records: {0} | '}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                <TextBlock Text="{Binding PageNumber, StringFormat='Page {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" />
                <TextBlock Text="{Binding TotalPages, StringFormat=' of {0}'}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,10,0" />

                <Button Content="‹ Prev" Command="{Binding PreviousPageCommand}" Width="75" Height="30" Margin="0,0,6,0" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" />
                <Button Content="Next ›" Command="{Binding NextPageCommand}" Width="75" Height="30" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

