<UserControl x:Class="ShopPOS.UI.Views.PosSaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.Sales"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PosSaleViewModel}"
             Background="#F1F5F9"
             FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Grid>
        <!-- Main POS Selling Layout -->
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- TOP BAR: Barcode Scan / Search Box & Shift Status -->
            <Border Grid.Row="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Scan / Search Input -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="🔍 SCAN / SEARCH:" FontSize="13" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBox x:Name="ScanBox" Grid.Column="1" Text="{Binding ScanInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="16" FontWeight="SemiBold" Padding="10,6" VerticalAlignment="Center">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding ProcessScanCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="2" Content="Search (F2)" Command="{Binding OpenProductSearchCommand}"
                                    Width="110" Height="38" Margin="8,0,0,0" Background="#2563EB" Foreground="White" FontWeight="SemiBold" BorderThickness="0" />
                        </Grid>

                        <!-- Error or Scan hint message -->
                        <TextBlock Grid.Row="1" Text="{Binding ScanErrorMessage}" Foreground="#DC2626" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"
                                   Visibility="{Binding ScanErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />
                    </Grid>

                    <!-- Shift Status Display -->
                    <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Shift: " FontSize="12" Foreground="#64748B" />
                            <TextBlock Text="{Binding ShiftStatusText}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" />
                        </StackPanel>
                    </Border>

                    <!-- Help Button -->
                    <Button Grid.Column="2" Content="Help (F1)" Command="{Binding ShowHelpCommand}"
                            Width="85" Height="36" Margin="10,0,0,0" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" />
                </Grid>
            </Border>

            <!-- MAIN WORKSPACE: Left = Cart Items Grid; Right = Customer & Totals -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="480" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1.7*" MinWidth="340" MaxWidth="440" />
                </Grid.ColumnDefinitions>

                <!-- LEFT: CART ITEMS -->
                <Border Grid.Column="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Cart header & items count -->
                        <Grid Grid.Row="0" Margin="4,0,4,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🛒 Shopping Cart" FontSize="16" FontWeight="Bold" Foreground="#0F172A" />
                                <TextBlock Text="{Binding ItemsCount, StringFormat=' ({0} items)'}" FontSize="14" Foreground="#64748B" VerticalAlignment="Center" Margin="4,0,0,0" />
                            </StackPanel>

                            <Button Grid.Column="1" Content="Clear Cart (F8)" Command="{Binding DiscardCartCommand}"
                                    IsEnabled="{Binding HasCartItems}" Height="28" Padding="8,0" Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0" FontWeight="SemiBold" />
                        </Grid>

                        <!-- Cart DataGrid -->
                        <DataGrid Grid.Row="1" ItemsSource="{Binding CartItems}" SelectedItem="{Binding SelectedCartItem, Mode=TwoWay}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                  Background="Transparent" BorderThickness="0" RowHeight="44">
                            <DataGrid.Columns>
                                <!-- Product Description -->
                                <DataGridTemplateColumn Header="Item / Sku" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProductName}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Sku}" FontSize="11" Foreground="#64748B" Margin="0,0,6,0" />
                                                    <Border Background="{Binding CurrentStock, Converter={StaticResource LowStockBackgroundConverter}}" CornerRadius="3" Padding="4,1">
                                                        <TextBlock Text="{Binding StockStatusText}" FontSize="10" Foreground="#475569" />
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Quantity with +/- -->
                                <DataGridTemplateColumn Header="Qty" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="-" Command="{Binding DataContext.DecreaseQtyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Width="26" Height="26" Background="#F1F5F9" FontWeight="Bold" BorderThickness="0" />
                                                <TextBox Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="50" Height="26" FontSize="13" FontWeight="Bold" TextAlignment="Center" VerticalContentAlignment="Center" Margin="4,0" />
                                                <Button Content="+" Command="{Binding DataContext.IncreaseQtyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Width="26" Height="26" Background="#F1F5F9" FontWeight="Bold" BorderThickness="0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Unit Price -->
                                <DataGridTemplateColumn Header="Price" Width="85">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding UnitPrice, StringFormat='${0:N2}'}" FontSize="13" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Discount -->
                                <DataGridTemplateColumn Header="Disc" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding LineDiscountAmount, StringFormat='-${0:N2}'}" FontSize="12" Foreground="#DC2626" VerticalAlignment="Center"
                                                       Visibility="{Binding LineDiscountAmount, Converter={StaticResource DecimalGreaterThanZeroToVisibilityConverter}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Line Total -->
                                <DataGridTemplateColumn Header="Total" Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding LineTotal, StringFormat='${0:N2}'}" FontSize="14" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Remove Action -->
                                <DataGridTemplateColumn Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕" Command="{Binding DataContext.RemoveCartItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Width="26" Height="26" Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0" FontWeight="Bold" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- RIGHT: CUSTOMER, SUMMARY & CHECKOUT BUTTON -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Customer Card -->
                    <Border Grid.Row="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="CUSTOMER" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock Text="{Binding CustomerDisplayName}" FontSize="14" FontWeight="Bold" Foreground="#0F172A" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="F3" Command="{Binding SelectCustomerCommand}" Width="36" Height="28" Background="#EFF6FF" Foreground="#2563EB" FontWeight="Bold" BorderThickness="0" ToolTip="Select Customer (F3)" />
                                    <Button Content="✕" Command="{Binding ClearCustomerCommand}" Width="28" Height="28" Margin="4,0,0,0" Background="#F1F5F9" Foreground="#64748B" BorderThickness="0" ToolTip="Reset to Walk-in" />
                                </StackPanel>
                            </Grid>

                            <!-- Balance & Limit info (visible for selected customer) -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0"
                                        Visibility="{Binding SelectedCustomerId, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock Text="{Binding CustomerCurrentBalance, StringFormat='Balance: ${0:N2}'}" FontSize="12" FontWeight="SemiBold" Foreground="#D97706" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding CustomerCreditLimit, StringFormat='Limit: ${0:N2}'}" FontSize="12" Foreground="#64748B" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Totals Breakdown & Action Buttons -->
                    <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="16,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <!-- Subtotal -->
                                <Grid Margin="0,3">
                                    <TextBlock Text="Subtotal:" FontSize="13" Foreground="#64748B" />
                                    <TextBlock Text="{Binding SubTotal, StringFormat='${0:N2}'}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right" />
                                </Grid>

                                <!-- Line Discounts -->
                                <Grid Margin="0,3" Visibility="{Binding LineDiscountTotal, Converter={StaticResource DecimalGreaterThanZeroToVisibilityConverter}}">
                                    <TextBlock Text="Line Discounts:" FontSize="13" Foreground="#DC2626" />
                                    <TextBlock Text="{Binding LineDiscountTotal, StringFormat='-${0:N2}'}" FontSize="13" FontWeight="SemiBold" Foreground="#DC2626" HorizontalAlignment="Right" />
                                </Grid>

                                <!-- Bill Discount -->
                                <Grid Margin="0,3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Bill Discount:" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" />
                                        <Button Content="F6" Command="{Binding OpenBillDiscountCommand}" Height="20" Padding="6,0" Margin="6,0,0,0" FontSize="10" Background="#F1F5F9" Foreground="#2563EB" BorderThickness="0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding BillDiscountAmount, StringFormat='-${0:N2}'}" FontSize="13" FontWeight="SemiBold" Foreground="#DC2626" HorizontalAlignment="Right" />
                                </Grid>

                                <!-- Tax -->
                                <Grid Margin="0,3">
                                    <TextBlock Text="Tax / VAT:" FontSize="13" Foreground="#64748B" />
                                    <TextBlock Text="{Binding TaxAmount, StringFormat='${0:N2}'}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right" />
                                </Grid>

                                <!-- Round off -->
                                <Grid Margin="0,3">
                                    <TextBlock Text="Rounding:" FontSize="13" Foreground="#64748B" />
                                    <TextBlock Text="{Binding RoundOff, StringFormat='${0:N2}'}" FontSize="13" Foreground="#64748B" HorizontalAlignment="Right" />
                                </Grid>

                                <Separator Margin="0,10" Background="#E2E8F0" />

                                <!-- GRAND TOTAL PROMINENT DISPLAY -->
                                <Border Background="#1E293B" CornerRadius="8" Padding="14,10" Margin="0,4,0,12">
                                    <Grid>
                                        <TextBlock Text="TOTAL" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding GrandTotal, StringFormat='${0:N2}'}" FontSize="32" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>

                                <!-- Quick Secondary Buttons -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Hold Bill (F4)" Command="{Binding HoldBillCommand}" IsEnabled="{Binding HasCartItems}" Height="34" Margin="0,0,4,0" Background="#F8FAFC" BorderBrush="#CBD5E1" Foreground="#334155" FontWeight="SemiBold" />
                                    <Button Grid.Column="1" Content="{Binding HeldBillsCount, StringFormat='Held Bills ({0}) [F5]'}" Command="{Binding ShowHeldBillsCommand}" Height="34" Margin="4,0,0,0" Background="#F8FAFC" BorderBrush="#CBD5E1" Foreground="#2563EB" FontWeight="SemiBold" />
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Line Disc (F7)" Command="{Binding OpenLineDiscountCommand}" Height="34" Margin="0,0,4,0" Background="#F8FAFC" BorderBrush="#CBD5E1" Foreground="#334155" />
                                    <Button Grid.Column="1" Content="Drawer (F9)" Command="{Binding OpenCashDrawerCommand}" Height="34" Margin="4,0,0,0" Background="#F8FAFC" BorderBrush="#CBD5E1" Foreground="#334155" />
                                </Grid>
                            </StackPanel>

                            <!-- LARGE TENDER & PAY BUTTON -->
                            <Button Grid.Row="1" Content="PAY / TENDER (F12)" Command="{Binding CheckoutCommand}" IsEnabled="{Binding HasCartItems}"
                                    Height="54" Background="#16A34A" Foreground="White" FontSize="18" FontWeight="Bold" BorderThickness="0" Margin="0,10,0,0" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- FOOTER BAR: Keyboard Shortcuts Reference -->
            <Border Grid.Row="2" Background="#1E293B" CornerRadius="6" Padding="14,6" Margin="0,10,0,0">
                <TextBlock Text="F1: Help  |  F2: Product Search  |  F3: Customer  |  F4: Hold  |  F5: Recall  |  F6: Bill Disc  |  F7: Line Disc  |  F8: Discard  |  F9: Drawer  |  F12: Tender &amp; Pay"
                           FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" FontWeight="SemiBold" />
            </Border>
        </Grid>

        <!-- POST-SALE SUCCESS OVERLAY -->
        <Grid Background="#B0000000" Visibility="{Binding IsSaleSuccess, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="White" CornerRadius="12" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28,24">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="✓" FontSize="48" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Center" Margin="0,0,0,4" />
                    <TextBlock Text="Sale Completed Successfully!" FontSize="20" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding LastCompletedSale.SaleNumber, StringFormat='Invoice: {0}'}" FontSize="14" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,16" />

                    <!-- Sale Details Summary Card -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,16" MinWidth="340">
                        <StackPanel>
                            <Grid Margin="0,2">
                                <TextBlock Text="Total Amount:" FontSize="13" Foreground="#64748B" />
                                <TextBlock Text="{Binding LastCompletedSale.GrandTotal, StringFormat='${0:N2}'}" FontSize="14" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="Total Paid:" FontSize="13" Foreground="#64748B" />
                                <TextBlock Text="{Binding LastCompletedSale.PaidAmount, StringFormat='${0:N2}'}" FontSize="13" FontWeight="SemiBold" Foreground="#16A34A" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,2" Visibility="{Binding LastChangeAmount, Converter={StaticResource DecimalGreaterThanZeroToVisibilityConverter}}">
                                <TextBlock Text="Change Given:" FontSize="14" FontWeight="Bold" Foreground="#16A34A" />
                                <TextBlock Text="{Binding LastChangeAmount, StringFormat='${0:N2}'}" FontSize="18" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Success Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Print Receipt" Command="{Binding PrintLastReceiptCommand}"
                                Width="120" Height="40" Margin="0,0,10,0" Background="#2563EB" Foreground="White" FontWeight="SemiBold" BorderThickness="0" />
                        <Button Content="Reprint (Duplicate)" Command="{Binding ReprintLastReceiptCommand}"
                                Width="150" Height="40" Margin="0,0,10,0" Background="#475569" Foreground="White" FontWeight="SemiBold" BorderThickness="0" />
                        <Button Content="New Sale (Space / Enter)" Command="{Binding DismissSuccessPanelCommand}"
                                Width="180" Height="40" Background="#16A34A" Foreground="White" FontWeight="Bold" BorderThickness="0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

