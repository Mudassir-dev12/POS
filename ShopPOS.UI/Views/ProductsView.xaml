<UserControl x:Class="ShopPOS.UI.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.Products"
             xmlns:dto="clr-namespace:ShopPOS.Core.DTOs;assembly=ShopPOS.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ProductsViewModel}"
             Loaded="UserControl_Loaded">

    <UserControl.InputBindings>
        <KeyBinding Gesture="Ctrl+A" Command="{Binding SelectAllOnPageCommand}" />
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding AddCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteOrDeactivateCommand}" />
        <KeyBinding Key="Enter" Command="{Binding EditCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Page Header & Action Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- Filter Bar -->
            <RowDefinition Height="Auto" />
            <!-- Table & Bulk Actions -->
            <RowDefinition Height="*" />
            <!-- Pagination Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Page Header & Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Products &amp; catalog" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Double-click or press Enter to edit. Manage products, barcodes, prices and stock alerts."
                           Style="{StaticResource SubTitleStyle}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="New product Ctrl N"
                        Command="{Binding AddCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,8,0" />

                <Button Content="Duplicate"
                        Command="{Binding DuplicateProductCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Margin="0,0,8,0" />

                <Button Content="Price history"
                        Command="{Binding ViewPriceHistoryCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Margin="0,0,8,0" />

                <Button Content="Import"
                        Command="{Binding ImportCsvCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Margin="0,0,8,0" />

                <Button Content="Export"
                        Command="{Binding ExportCsvCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Margin="0,0,8,0" />

                <Button Content="Print labels"
                        Command="{Binding PrintLabelsCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Margin="0,0,8,0" />

                <Button Content="Refresh F5"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource ToolbarButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- 2. Filter Bar -->
        <Border Grid.Row="1" Style="{StaticResource FilterBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Search box -->
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="12" />
                    <!-- Category filter -->
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="12" />
                    <!-- Brand filter -->
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="16" />
                    <!-- Low Stock Checkbox -->
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <!-- Out of Stock Checkbox -->
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <!-- Show Inactive Checkbox -->
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <TextBox Grid.Column="0"
                         Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search by SKU, barcode, or name" />

                <!-- Category Filter -->
                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding FilterCategories}"
                          SelectedValuePath="Id"
                          DisplayMemberPath="Name"
                          SelectedValue="{Binding FilterCategoryId}"
                          ToolTip="Filter by Category" />

                <!-- Brand Filter -->
                <ComboBox Grid.Column="4"
                          ItemsSource="{Binding FilterBrands}"
                          SelectedValuePath="Id"
                          DisplayMemberPath="Name"
                          SelectedValue="{Binding FilterBrandId}"
                          ToolTip="Filter by Brand" />

                <!-- Low Stock Toggle -->
                <CheckBox Grid.Column="6"
                          Content="Low stock only"
                          IsChecked="{Binding LowStockOnly}"
                          VerticalAlignment="Center" />

                <!-- Out of Stock Toggle -->
                <CheckBox Grid.Column="8"
                          Content="Out of stock only"
                          IsChecked="{Binding OutOfStockOnly}"
                          VerticalAlignment="Center" />

                <!-- Show Inactive Toggle -->
                <CheckBox Grid.Column="10"
                          Content="Show Inactive"
                          IsChecked="{Binding ShowInactive}"
                          VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 3. Table & Bulk Action Area -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Bulk Selection Status Banner -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SecondaryBackgroundBrush}"
                    BorderBrush="{DynamicResource SecondaryBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,8"
                    Margin="0,0,0,10"
                    Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectionStatusText}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <Button Content="Clear selection"
                                Command="{Binding ClearSelectionCommand}"
                                Style="{StaticResource GhostButtonStyle}"
                                Padding="8,2"
                                Margin="8,0,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Delete selected"
                                Command="{Binding DeleteSelectedCommand}"
                                Style="{StaticResource DangerButtonStyle}"
                                Visibility="{Binding CanShowDeleteSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Margin="0,0,8,0" />
                        <Button Content="Cancel selected"
                                Command="{Binding CancelSelectedCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Visibility="{Binding CanShowCancelSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Select All Filtered Results Cross-Page Banner -->
            <Border Grid.Row="1"
                    Background="{DynamicResource WarningBackgroundBrush}"
                    BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,8"
                    Margin="0,0,0,10"
                    Visibility="{Binding ShowSelectAllResultsBanner, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding SelectAllResultsBannerText}"
                               Foreground="{DynamicResource WarningTextBrush}"
                               FontWeight="Medium"
                               VerticalAlignment="Center" />
                    <Button Content="Select all matching results across all pages"
                            Command="{Binding SelectAllFilteredResultsCommand}"
                            Style="{StaticResource GhostButtonStyle}"
                            FontWeight="Bold"
                            Foreground="{DynamicResource WarningTextBrush}"
                            Margin="8,0,0,0" />
                </StackPanel>
            </Border>

            <!-- Main DataGrid Container -->
            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <!-- Loading Indicator Overlay -->
                    <Border Background="{DynamicResource OverlayBackgroundBrush}"
                            Panel.ZIndex="10"
                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Loading products..."
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <!-- Empty State Message -->
                    <Border HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Panel.ZIndex="5"
                            Visibility="{Binding Items.Count, Converter={StaticResource InverseBooleanConverter}}">
                        <TextBlock Text="No products to show"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center" />
                    </Border>

                    <!-- Products Table -->
                    <DataGrid ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              MouseDoubleClick="DataGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <!-- Selection Checkbox Column -->
                            <DataGridTemplateColumn Width="38" CanUserResize="False">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox IsChecked="{Binding DataContext.IsAllOnPageSelected, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                              Command="{Binding DataContext.ToggleSelectAllOnPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  Command="{Binding DataContext.ItemSelectionChangedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- SKU (Monospace) -->
                            <DataGridTextColumn Header="SKU"
                                                Binding="{Binding Sku}"
                                                Width="100"
                                                ElementStyle="{StaticResource MonospaceTextStyle}" />

                            <!-- Barcode (Monospace) -->
                            <DataGridTextColumn Header="BARCODE"
                                                Binding="{Binding Barcode}"
                                                Width="120"
                                                ElementStyle="{StaticResource MonospaceTextStyle}" />

                            <!-- Name (With Trimming and Tooltip) -->
                            <DataGridTemplateColumn Header="NAME" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type dto:ProductListItemDto}">
                                        <TextBlock Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}"
                                                   FontWeight="Medium"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Category -->
                            <DataGridTextColumn Header="CATEGORY" Binding="{Binding CategoryName}" Width="*" />

                            <!-- Brand -->
                            <DataGridTextColumn Header="BRAND" Binding="{Binding BrandName}" Width="*" />

                            <!-- Unit -->
                            <DataGridTextColumn Header="UNIT" Binding="{Binding UnitShortName}" Width="65" />

                            <!-- Cost Price (Right-aligned, Monospace) -->
                            <DataGridTextColumn Header="COST"
                                                Binding="{Binding CostPrice, Converter={StaticResource MoneyConverter}}"
                                                Width="95"
                                                ElementStyle="{StaticResource MonospaceNumericCell}" />

                            <!-- Sale Price (Right-aligned, Monospace) -->
                            <DataGridTextColumn Header="SALE PRICE"
                                                Binding="{Binding SalePrice, Converter={StaticResource MoneyConverter}}"
                                                Width="105"
                                                ElementStyle="{StaticResource MonospaceNumericCell}" />

                            <!-- Stock (Monospace with OUT / LOW / OK Tags) -->
                            <DataGridTemplateColumn Header="STOCK" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type dto:ProductListItemDto}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CurrentStock, StringFormat='{}{0:0.###}'}"
                                                       FontFamily="{StaticResource AppMonospaceFontFamily}"
                                                       FontWeight="Bold"
                                                       Margin="0,0,6,0" />

                                            <!-- OUT Tag (Red Outline) -->
                                            <Border Style="{StaticResource StockTagOut}"
                                                    Visibility="{Binding IsOutOfStock, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="OUT"
                                                           FontFamily="{StaticResource AppMonospaceFontFamily}"
                                                           FontSize="9"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource DangerOutlineTextBrush}" />
                                            </Border>

                                            <!-- LOW Tag (Amber Outline) -->
                                            <Border Style="{StaticResource StockTagLow}"
                                                    Visibility="{Binding IsLowStock, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="LOW"
                                                           FontFamily="{StaticResource AppMonospaceFontFamily}"
                                                           FontSize="9"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource WarningTextBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Status Dot + Text -->
                            <DataGridTemplateColumn Header="STATUS" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type dto:ProductListItemDto}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Style="{StaticResource StatusDotActive}"
                                                     Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <Ellipse Style="{StaticResource StatusDotInactive}"
                                                     Visibility="{Binding IsActive, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                            <TextBlock Text="{Binding IsActive, Converter={StaticResource BooleanToActiveStatusConverter}}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. Pagination Footer -->
        <Border Grid.Row="3" Style="{StaticResource PaginationBarStyle}">
            <Grid>
                <!-- Left: Record Count & Hint -->
                <TextBlock Text="{Binding RowCountText}"
                           FontFamily="{StaticResource AppMonospaceFontFamily}"
                           FontSize="11"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" />

                <!-- Right: Page Controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="&lt; Prev"
                            Command="{Binding PreviousPageCommand}"
                            Style="{StaticResource PaginationButtonStyle}"
                            MinWidth="54" />

                    <TextBlock Text="{Binding CurrentPage, StringFormat='Page {0}'}"
                               FontFamily="{StaticResource AppMonospaceFontFamily}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               Margin="8,0" />

                    <TextBlock Text="{Binding TotalPages, StringFormat='of {0}'}"
                               FontFamily="{StaticResource AppMonospaceFontFamily}"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />

                    <Button Content="Next &gt;"
                            Command="{Binding NextPageCommand}"
                            Style="{StaticResource PaginationButtonStyle}"
                            MinWidth="54" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
