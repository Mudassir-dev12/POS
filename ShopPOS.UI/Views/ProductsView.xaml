<UserControl x:Class="ShopPOS.UI.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.Products"
             xmlns:dto="clr-namespace:ShopPOS.Core.DTOs;assembly=ShopPOS.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ProductsViewModel}"
             Background="#F1F5F9"
             FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
             Loaded="UserControl_Loaded">

    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding AddCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteOrDeactivateCommand}" />
        <KeyBinding Key="Enter" Command="{Binding EditCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header bar with Title & Action buttons -->
            <RowDefinition Height="Auto" />
            <!-- Search & Filter bar -->
            <RowDefinition Height="Auto" />
            <!-- DataGrid Table -->
            <RowDefinition Height="*" />
            <!-- Paging footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Products &amp; Catalog" FontSize="22" FontWeight="Bold" Foreground="#0F172A" />
                <TextBlock Text="Manage master products, scannable barcodes, pricing, and stock alerts." FontSize="13" Foreground="#64748B" Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <!-- Add Product -->
                <Button Content="+ New Product (Ctrl+N)"
                        Command="{Binding AddCommand}"
                        IsEnabled="{Binding CanAdd}"
                        Background="#2563EB"
                        Foreground="White"
                        FontWeight="Bold"
                        Padding="14,8"
                        BorderThickness="0"
                        Cursor="Hand" />

                <!-- Duplicate -->
                <Button Content="📋 Duplicate"
                        Command="{Binding DuplicateProductCommand}"
                        IsEnabled="{Binding CanAdd}"
                        Background="#0284C7"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Padding="12,8"
                        BorderThickness="0"
                        Cursor="Hand" />

                <!-- Price History -->
                <Button Content="📊 Price History"
                        Command="{Binding ViewPriceHistoryCommand}"
                        Background="#475569"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Padding="12,8"
                        BorderThickness="0"
                        Cursor="Hand" />

                <!-- Import File -->
                <Button Content="📥 Import (Excel/CSV)"
                        Command="{Binding ImportCsvCommand}"
                        IsEnabled="{Binding CanAdd}"
                        Background="#10B981"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Padding="12,8"
                        BorderThickness="0"
                        Cursor="Hand" />

                <!-- Export File -->
                <Button Content="📤 Export (Excel/CSV)"
                        Command="{Binding ExportCsvCommand}"
                        Background="#059669"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Padding="12,8"
                        BorderThickness="0"
                        Cursor="Hand" />

                <!-- Refresh -->
                <Button Content="🔄 Refresh (F5)"
                        Command="{Binding RefreshCommand}"
                        Background="#E2E8F0"
                        Foreground="#334155"
                        FontWeight="SemiBold"
                        Padding="12,8"
                        BorderThickness="0"
                        Cursor="Hand" />
            </StackPanel>
        </Grid>

        <!-- 2. Search & Filters Bar -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,0,0,16"
                BorderBrush="#E2E8F0"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Search box -->
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="16" />
                    <!-- Category filter -->
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="16" />
                    <!-- Brand filter -->
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="20" />
                    <!-- Low Stock Checkbox -->
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="20" />
                    <!-- Show Inactive Checkbox -->
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Search Box (Debounced 300ms) -->
                <TextBox Grid.Column="0"
                         Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,6"
                         FontSize="13"
                         VerticalAlignment="Center">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Resources>
                                <VisualBrush x:Key="CueBannerBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                    <VisualBrush.Visual>
                                        <TextBlock Text="🔍 Search SKU, barcode, name..." Foreground="#94A3B8" FontSize="12" Margin="6,0,0,0" />
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Style.Resources>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background" Value="{StaticResource CueBannerBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- Category Filter -->
                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding FilterCategories}"
                          SelectedValuePath="Id"
                          DisplayMemberPath="Name"
                          SelectedValue="{Binding FilterCategoryId}"
                          Padding="8,6"
                          FontSize="13"
                          VerticalAlignment="Center" />

                <!-- Brand Filter -->
                <ComboBox Grid.Column="4"
                          ItemsSource="{Binding FilterBrands}"
                          SelectedValuePath="Id"
                          DisplayMemberPath="Name"
                          SelectedValue="{Binding FilterBrandId}"
                          Padding="8,6"
                          FontSize="13"
                          VerticalAlignment="Center" />

                <!-- Low Stock Toggle -->
                <CheckBox Grid.Column="6"
                          Content="⚠️ Low stock only"
                          IsChecked="{Binding LowStockOnly}"
                          FontWeight="SemiBold"
                          Foreground="#D97706"
                          VerticalAlignment="Center" />

                <!-- Show Inactive Toggle -->
                <CheckBox Grid.Column="8"
                          Content="Show Inactive"
                          IsChecked="{Binding ShowInactive}"
                          FontWeight="Medium"
                          Foreground="#64748B"
                          VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 3. Main DataGrid -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="8"
                BorderBrush="#E2E8F0"
                BorderThickness="1">
            <Grid>
                <!-- Loading indicator overlay -->
                <Border Background="#80FFFFFF"
                        Panel.ZIndex="10"
                        Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Loading products..." FontSize="14" FontWeight="SemiBold" Foreground="#2563EB" />
                    </StackPanel>
                </Border>

                <!-- Empty state message -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Panel.ZIndex="5"
                            Visibility="{Binding Items.Count, Converter={StaticResource InverseBooleanConverter}}">
                    <TextBlock Text="📦 No products found" FontSize="16" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" />
                    <TextBlock Text="Try adjusting your filters or click '+ New Product' to add one." FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- DataGrid -->
                <DataGrid ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F5F9"
                          Background="White"
                          BorderThickness="0"
                          RowHeight="40"
                          MouseDoubleClick="DataGrid_MouseDoubleClick">

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Opacity" Value="{Binding IsActive, Converter={StaticResource InactiveOpacityConverter}}" />
                            <Setter Property="Background" Value="{Binding IsLowStock, Converter={StaticResource LowStockBackgroundConverter}}" />
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="100" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="130" />
                        <DataGridTextColumn Header="Product Name" Binding="{Binding Name}" Width="2*" FontWeight="Medium" />
                        <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="*" />
                        <DataGridTextColumn Header="Brand" Binding="{Binding BrandName}" Width="*" />
                        <DataGridTextColumn Header="Unit" Binding="{Binding UnitShortName}" Width="70" />
                        <DataGridTextColumn Header="Cost" Binding="{Binding CostPrice, StringFormat='{}{0:0.00}'}" Width="85" />
                        <DataGridTextColumn Header="Sale Price" Binding="{Binding SalePrice, StringFormat='{}{0:0.00}'}" Width="95" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="Tax %" Binding="{Binding TaxPercent, StringFormat='{}{0:0.0}%'}" Width="75" />

                        <!-- Current Stock with Low Stock Badge -->
                        <DataGridTemplateColumn Header="Current Stock" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type dto:ProductListItemDto}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                        <TextBlock Text="{Binding CurrentStock, StringFormat='{}{0:0.###}'}" FontWeight="Bold" />
                                        <TextBlock Text=" ⚠️" Visibility="{Binding IsLowStock, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="#D97706" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Status Column -->
                        <DataGridTemplateColumn Header="Status" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type dto:ProductListItemDto}">
                                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#DCFCE7" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Background" Value="#F1F5F9" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Active" />
                                                    <Setter Property="Foreground" Value="#16A34A" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Text" Value="Inactive" />
                                                            <Setter Property="Foreground" Value="#64748B" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 4. Paging Footer -->
        <Border Grid.Row="3" Margin="0,14,0,0">
            <Grid>
                <!-- Row count label & action instructions -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RowCountText}" FontWeight="SemiBold" Foreground="#334155" FontSize="13" />
                    <TextBlock Text="  •  Double-click or press Enter to edit  •  Del to delete/deactivate" FontSize="12" Foreground="#94A3B8" />
                </StackPanel>

                <!-- Page navigation buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="◀ Prev"
                            Command="{Binding PreviousPageCommand}"
                            Padding="12,6"
                            Background="White"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            Cursor="Hand" />

                    <TextBlock Text="{Binding CurrentPage, StringFormat='Page {0}'}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="#0F172A" />

                    <TextBlock Text="{Binding TotalPages, StringFormat='of {0}'}"
                               Foreground="#64748B"
                               VerticalAlignment="Center" />

                    <Button Content="Next ▶"
                            Command="{Binding NextPageCommand}"
                            Padding="12,6"
                            Background="White"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            Cursor="Hand" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
