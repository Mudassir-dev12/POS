<UserControl x:Class="ShopPOS.UI.Views.ShiftsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.Shifts"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ShiftsViewModel}"
             Background="#F8FAFC"
             FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TITLE BAR -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Cash Shifts &amp; Drawer Management" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
                <TextBlock Text="Track opening cash float, sales, drawer movements, cash drops, and X/Z reconciliation reports." FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
            </StackPanel>

            <Button Grid.Column="1" Content="Refresh (F5)" Command="{Binding LoadCurrentShiftAndHistoryCommand}"
                    Width="110" Height="34" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" />
        </Grid>

        <!-- CURRENT ACTIVE SHIFT CARD -->
        <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <Grid>
                <!-- When Shift IS Active -->
                <Grid Visibility="{Binding HasActiveShift, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentShiftSummary.ShiftNumber, StringFormat='Active Shift: {0}'}" FontSize="18" FontWeight="Bold" Foreground="#0F172A" />
                            <Border Background="#DCFCE7" CornerRadius="4" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="OPEN" Foreground="#16A34A" FontSize="11" FontWeight="Bold" />
                            </Border>
                            <TextBlock Text="{Binding CurrentShiftSummary.StartTime, StringFormat=' (Opened {0:g})'}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>

                        <!-- Shift Actions -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="💵 Cash In / Out" Command="{Binding OpenCashMovementDialogCommand}"
                                    Height="34" Padding="10,0" Margin="0,0,8,0" Background="#EFF6FF" Foreground="#2563EB" BorderBrush="#BFDBFE" FontWeight="SemiBold" />
                            <Button Content="📄 Print X Report" Command="{Binding PrintXReportCommand}"
                                    Height="34" Padding="10,0" Margin="0,0,8,0" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" />
                            <Button Content="🔒 Reconcile &amp; Close Shift" Command="{Binding CloseShiftDialogCommand}"
                                    Height="34" Padding="12,0" Background="#DC2626" Foreground="White" FontWeight="Bold" BorderThickness="0" />
                        </StackPanel>
                    </Grid>

                    <!-- Metrics Grid -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.3*" />
                        </Grid.ColumnDefinitions>

                        <!-- Opening Float -->
                        <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="Opening Cash" FontSize="11" Foreground="#64748B" />
                                <TextBlock Text="{Binding CurrentShiftSummary.OpeningCash, StringFormat='${0:N2}'}" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Cash Sales -->
                        <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="Cash Sales" FontSize="11" Foreground="#64748B" />
                                <TextBlock Text="{Binding CurrentShiftSummary.CashSales, StringFormat='${0:N2}'}" FontSize="16" FontWeight="Bold" Foreground="#16A34A" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Other Sales -->
                        <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="Card / Other Sales" FontSize="11" Foreground="#64748B" />
                                <TextBlock Text="{Binding CurrentShiftSummary.OtherSales, StringFormat='${0:N2}'}" FontSize="16" FontWeight="Bold" Foreground="#2563EB" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Net Cash In/Out -->
                        <Border Grid.Column="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="Net Movements" FontSize="11" Foreground="#64748B" />
                                <TextBlock Text="{Binding CurrentShiftSummary.CashIn, StringFormat='${0:N2}'}" FontSize="16" FontWeight="SemiBold" Foreground="#475569" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Expected Cash in Drawer -->
                        <Border Grid.Column="4" Background="#1E293B" CornerRadius="6" Padding="10">
                            <StackPanel>
                                <TextBlock Text="EXPECTED CASH IN DRAWER" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                                <TextBlock Text="{Binding CurrentShiftSummary.ExpectedCash, StringFormat='${0:N2}'}" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- When NO Shift is Active -->
                <Grid Visibility="{Binding HasActiveShift, Converter={StaticResource InverseBooleanToVisibilityConverter}}" Margin="10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="No Shift Currently Open" FontSize="16" FontWeight="Bold" Foreground="#0F172A" />
                        <TextBlock Text="Open a shift to start recording cashier drawer transactions and track float." FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="+ Open New Shift" Command="{Binding OpenShiftDialogCommand}"
                            Height="40" Padding="16,0" Background="#16A34A" Foreground="White" FontWeight="Bold" BorderThickness="0" />
                </Grid>
            </Grid>
        </Border>

        <!-- PAST SHIFTS HISTORY -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="14,12,14,8">
                    <TextBlock Text="Past Shifts History" FontSize="15" FontWeight="Bold" Foreground="#0F172A" />
                </Grid>

                <DataGrid Grid.Row="1" ItemsSource="{Binding PastShifts}" SelectedItem="{Binding SelectedPastShift, Mode=TwoWay}"
                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Shift #" Binding="{Binding ShiftNumber}" Width="130" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="Opened At" Binding="{Binding StartTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="140" />
                        <DataGridTextColumn Header="Closed At" Binding="{Binding EndTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="140" />
                        <DataGridTextColumn Header="Opening Cash" Binding="{Binding OpeningCash, StringFormat='${0:N2}'}" Width="110" />
                        <DataGridTextColumn Header="Cash Sales" Binding="{Binding CashSales, StringFormat='${0:N2}'}" Width="110" Foreground="#16A34A" />
                        <DataGridTextColumn Header="Counted Cash" Binding="{Binding CountedCash, StringFormat='${0:N2}'}" Width="110" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="Difference" Binding="{Binding Difference, StringFormat='${0:N2}'}" Width="110" Foreground="#EA580C" FontWeight="Bold" />
                        <DataGridTemplateColumn Header="Status" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Status, Converter={StaticResource ShiftStatusBadgeBackgroundConverter}}"
                                            CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Status}" Foreground="{Binding Status, Converter={StaticResource ShiftStatusBadgeColorConverter}}"
                                                   FontSize="11" FontWeight="Bold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

