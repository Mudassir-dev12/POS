<UserControl x:Class="ShopPOS.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.Settings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             Background="#F1F5F9"
             FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
             Loaded="UserControl_Loaded">

    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto" />
            <!-- Settings Form Cards -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= 1. HEADER ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Store, POS &amp; Inventory Settings" FontSize="22" FontWeight="Bold" Foreground="#0F172A" />
                <TextBlock Text="Configure store profile, POS cashier rules, shift enforcement, thermal receipt formatting, and valuation." FontSize="13" Foreground="#64748B" Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="💾 Save Settings (Ctrl+S)"
                        Command="{Binding SaveCommand}"
                        Background="#2563EB"
                        Foreground="White"
                        FontWeight="Bold"
                        Padding="16,8"
                        BorderThickness="0"
                        Cursor="Hand" />
            </StackPanel>
        </Grid>

        <!-- ================= 2. SETTINGS CARDS ================= -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                <!-- Notifications -->
                <Border Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" FontWeight="Bold" />
                </Border>

                <Border Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12"
                        Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Text="{Binding SuccessMessage}" Foreground="#15803D" FontWeight="Bold" />
                </Border>

                <!-- SECTION 1: Store Profile -->
                <Border Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Store Profile" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14" />

                        <!-- Store Name & Currency -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.5*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="STORE NAME *" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4" />
                                <TextBox Text="{Binding ShopName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="13" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="CURRENCY SYMBOL *" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4" />
                                <TextBox Text="{Binding CurrencySymbol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="13" />
                            </StackPanel>
                        </Grid>

                        <!-- Address -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="PHYSICAL STORE ADDRESS" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="13" />
                        </StackPanel>

                        <!-- Phone & Tax Number -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CONTACT PHONE" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="13" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="TAX / VAT REGISTRATION #" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4" />
                                <TextBox Text="{Binding TaxNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="13" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SECTION 2: POS & Sales Policy -->
                <Border Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="POS Checkout &amp; Sales Policies" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,4,4" />
                        <TextBlock Text="Controls cash register constraints, shift rules, discounts, and customer credit." FontSize="12" Foreground="#64748B" Margin="0,0,0,14" />

                        <!-- Toggles -->
                        <CheckBox Content="Require an active open shift before allowing sales" IsChecked="{Binding RequireOpenShiftForSales, Mode=TwoWay}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10" />
                        <CheckBox Content="Allow sales on credit (unpaid or partial balance)" IsChecked="{Binding AllowCreditSales, Mode=TwoWay}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10" />
                        <CheckBox Content="Allow selling below product minimum sale price" IsChecked="{Binding AllowSellingBelowMinPrice, Mode=TwoWay}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10" />
                        <CheckBox Content="Selling prices in product catalog already include tax / VAT" IsChecked="{Binding PricesIncludeTax, Mode=TwoWay}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10" />
                        <CheckBox Content="Allow customer returns without original invoice receipt" IsChecked="{Binding AllowReturnWithoutReceipt, Mode=TwoWay}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,14" />

                        <!-- Rounding & Return Window -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CASH ROUNDING STEP (0 = DISABLED)" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4" />
                                <TextBox Text="{Binding CashRoundingStep, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="13" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="RETURN WINDOW (DAYS, EMPTY = UNLIMITED)" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4" />
                                <TextBox Text="{Binding SaleReturnWindowDays, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="13" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SECTION 3: Inventory & Costing -->
                <Border Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Inventory Costing &amp; Control" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4" />
                        <TextBlock Text="These critical parameters dictate accounting valuation and stock validation across purchases and POS checkout."
                                   FontSize="12" Foreground="#64748B" Margin="0,0,0,16" />

                        <!-- Costing Method -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="INVENTORY COSTING METHOD" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding AvailableCostingMethods}"
                                      SelectedItem="{Binding CostingMethod, Mode=TwoWay}"
                                      IsEnabled="{Binding IsAdmin}"
                                      Padding="8,6"
                                      FontSize="13"
                                      Width="280"
                                      HorizontalAlignment="Left" />
                        </StackPanel>

                        <!-- Allow Negative Stock -->
                        <StackPanel Margin="0,0,0,8">
                            <CheckBox Content="Allow inventory levels to drop into negative quantities"
                                      IsChecked="{Binding AllowNegativeStock, Mode=TwoWay}"
                                      IsEnabled="{Binding IsAdmin}"
                                      FontWeight="Bold"
                                      FontSize="13"
                                      Foreground="#0F172A" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- SECTION 4: Receipt Printing & Hardware -->
                <Border Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Receipt Printing &amp; Cash Drawer" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14" />

                        <!-- Printing Mode -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="PRINTING MODE" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding AvailablePrinterModes}"
                                      SelectedItem="{Binding PrinterMode, Mode=TwoWay}"
                                      Padding="8,6" FontSize="13" Width="320" HorizontalAlignment="Left" />
                        </StackPanel>

                        <!-- Printer Queue Selection -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.5*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="RECEIPT PRINTER QUEUE" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding InstalledPrinters}"
                                          SelectedItem="{Binding ReceiptPrinterName, Mode=TwoWay}"
                                          IsEditable="True"
                                          Padding="8,6" FontSize="13" />
                            </StackPanel>

                            <Button Grid.Column="2" Content="Refresh"
                                    Command="{Binding RefreshPrintersCommand}"
                                    Padding="12,6" FontSize="12" VerticalAlignment="Bottom" Height="34" Background="#F1F5F9" />

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="RECEIPT COPIES" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4" />
                                <TextBox Text="{Binding ReceiptCopies, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="13" />
                            </StackPanel>
                        </Grid>

                        <!-- Paper Width -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="PAPER ROLL WIDTH" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4" />
                            <ComboBox SelectedValuePath="Tag"
                                      SelectedValue="{Binding ReceiptWidthMm, Mode=TwoWay}"
                                      Padding="8,6" FontSize="13" Width="240" HorizontalAlignment="Left">
                                <ComboBoxItem Content="80 mm (Standard Thermal)" Tag="80" />
                                <ComboBoxItem Content="58 mm (Compact Thermal)" Tag="58" />
                            </ComboBox>
                        </StackPanel>

                        <CheckBox Content="Automatically print receipt when sale completes" IsChecked="{Binding AutoPrintReceipt, Mode=TwoWay}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10" />
                        <CheckBox Content="Trigger cash drawer kick pulse on cash sales" IsChecked="{Binding OpenCashDrawerOnCashSale, Mode=TwoWay}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,14" />

                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="RECEIPT FOOTER MESSAGE" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4" />
                            <TextBox Text="{Binding ReceiptFooter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="13" />
                        </StackPanel>

                        <!-- Hardware Diagnostics -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel>
                                <TextBlock Text="HARDWARE DIAGNOSTICS" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Test Print Receipt" Command="{Binding TestPrintCommand}"
                                            Padding="14,8" FontWeight="SemiBold" Background="#E2E8F0" Margin="0,0,10,0" />
                                    <Button Content="Open Cash Drawer" Command="{Binding OpenCashDrawerCommand}"
                                            Padding="14,8" FontWeight="SemiBold" Background="#E2E8F0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
