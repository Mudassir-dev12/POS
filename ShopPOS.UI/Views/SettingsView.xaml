<UserControl x:Class="ShopPOS.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels.Settings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             Background="{DynamicResource PageBackgroundBrush}"
             FontFamily="{StaticResource AppFontFamily}"
             Loaded="UserControl_Loaded">

    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto" />
            <!-- Settings Form Cards -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= 1. HEADER ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Store, POS &amp; Inventory Settings" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Configure store profile, POS cashier rules, thermal receipt formatting, and valuation." Style="{StaticResource SubTitleStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Save Settings (Ctrl+S)"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- ================= 2. SETTINGS CARDS ================= -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                <!-- Notifications -->
                <Border Background="{DynamicResource DangerBackgroundBrush}"
                        BorderBrush="{DynamicResource DangerBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="0,0,0,12"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" />
                </Border>

                <Border Background="{DynamicResource SuccessBackgroundBrush}"
                        BorderBrush="{DynamicResource SuccessBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="0,0,0,12"
                        Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Text="{Binding SuccessMessage}" Foreground="{DynamicResource SuccessTextBrush}" FontWeight="Bold" />
                </Border>

                <!-- SECTION 1: Store Profile & Currency -->
                <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Store Profile &amp; Currency" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,14" />

                        <!-- Store Name & Currency -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="1.5*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="STORE NAME *" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding ShopName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="CURRENCY SYMBOL *" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding CurrencySymbol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="DECIMALS" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding AllowedDecimals}" SelectedItem="{Binding CurrencyDecimals, Mode=TwoWay}" Style="{StaticResource InputComboBoxStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Column="6">
                                <TextBlock Text="LIVE PREVIEW" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                                <Border Background="{DynamicResource SurfaceCardSubtleBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,6">
                                    <TextBlock Text="{Binding CurrencyPreview}" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" FontSize="13" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Address -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="PHYSICAL STORE ADDRESS" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                        </StackPanel>

                        <!-- Phone & Tax Number -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CONTACT PHONE" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="TAX / VAT REGISTRATION #" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding TaxNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SECTION 2: Appearance & Theme -->
                <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Appearance &amp; Theme" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,14" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="COLOR THEME" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding AvailableThemes}"
                                          SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                                          Style="{StaticResource InputComboBoxStyle}" />
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Content="Toggle Theme"
                                    Command="{Binding ToggleThemeCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    VerticalAlignment="Bottom" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SECTION 3: POS & Sales Policy -->
                <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="POS Checkout &amp; Sales Policies" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,4,4" />
                        <TextBlock Text="Controls cash register constraints, discounts, and pricing." Style="{StaticResource SubTitleStyle}" Margin="0,0,0,14" />

                        <!-- Toggles -->
                        <CheckBox Content="Allow selling below product minimum sale price" IsChecked="{Binding AllowSellingBelowMinPrice, Mode=TwoWay}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10" />
                        <CheckBox Content="Selling prices in product catalog already include tax / VAT" IsChecked="{Binding PricesIncludeTax, Mode=TwoWay}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10" />
                        <CheckBox Content="Allow customer returns without original invoice receipt" IsChecked="{Binding AllowReturnWithoutReceipt, Mode=TwoWay}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,14" />

                        <!-- Rounding & Return Window -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CASH ROUNDING STEP (0 = DISABLED)" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding CashRoundingStep, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="RETURN WINDOW (DAYS, EMPTY = UNLIMITED)" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding SaleReturnWindowDays, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SECTION 4: Inventory & Costing -->
                <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Inventory Costing &amp; Control" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,4" />
                        <TextBlock Text="These critical parameters dictate accounting valuation and stock validation across purchases and POS checkout."
                                   Style="{StaticResource SubTitleStyle}" Margin="0,0,0,16" />

                        <!-- Costing Method -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="INVENTORY COSTING METHOD" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding AvailableCostingMethods}"
                                      SelectedItem="{Binding CostingMethod, Mode=TwoWay}"
                                      IsEnabled="{Binding IsAdmin}"
                                      Style="{StaticResource InputComboBoxStyle}"
                                      Width="280"
                                      HorizontalAlignment="Left" />
                        </StackPanel>

                        <!-- Allow Negative Stock -->
                        <StackPanel Margin="0,0,0,8">
                            <CheckBox Content="Allow inventory levels to drop into negative quantities"
                                      IsChecked="{Binding AllowNegativeStock, Mode=TwoWay}"
                                      IsEnabled="{Binding IsAdmin}"
                                      FontWeight="Bold"
                                      FontSize="13" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- SECTION 5: Receipt Printing & Hardware -->
                <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Receipt Printing &amp; Cash Drawer" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,14" />

                        <!-- Printing Mode -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="PRINTING MODE" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding AvailablePrinterModes}"
                                      SelectedItem="{Binding PrinterMode, Mode=TwoWay}"
                                      Style="{StaticResource InputComboBoxStyle}"
                                      Width="320" HorizontalAlignment="Left" />
                        </StackPanel>

                        <!-- Printer Queue Selection -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.5*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="RECEIPT PRINTER QUEUE" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding InstalledPrinters}"
                                          SelectedItem="{Binding ReceiptPrinterName, Mode=TwoWay}"
                                          IsEditable="True"
                                          Style="{StaticResource InputComboBoxStyle}" />
                            </StackPanel>

                            <Button Grid.Column="2" Content="Refresh"
                                    Command="{Binding RefreshPrintersCommand}"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    VerticalAlignment="Bottom" Height="34" />

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="RECEIPT COPIES" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding ReceiptCopies, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                            </StackPanel>
                        </Grid>

                        <!-- Paper Width -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="PAPER ROLL WIDTH" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                            <ComboBox SelectedValuePath="Tag"
                                      SelectedValue="{Binding ReceiptWidthMm, Mode=TwoWay}"
                                      Style="{StaticResource InputComboBoxStyle}"
                                      Width="240" HorizontalAlignment="Left">
                                <ComboBoxItem Content="80 mm (Standard Thermal)" Tag="80" />
                                <ComboBoxItem Content="58 mm (Compact Thermal)" Tag="58" />
                            </ComboBox>
                        </StackPanel>

                        <CheckBox Content="Automatically print receipt when sale completes" IsChecked="{Binding AutoPrintReceipt, Mode=TwoWay}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10" />
                        <CheckBox Content="Trigger cash drawer kick pulse on cash sales" IsChecked="{Binding OpenCashDrawerOnCashSale, Mode=TwoWay}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,14" />

                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="RECEIPT FOOTER MESSAGE" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding ReceiptFooter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />
                        </StackPanel>

                        <!-- Hardware Diagnostics -->
                        <Border Background="{DynamicResource SurfaceCardSubtleBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel>
                                <TextBlock Text="HARDWARE DIAGNOSTICS" Style="{StaticResource MutedLabelStyle}" Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Test Print Receipt" Command="{Binding TestPrintCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" />
                                    <Button Content="Open Cash Drawer" Command="{Binding OpenCashDrawerCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
