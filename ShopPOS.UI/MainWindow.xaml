<Window x:Class="ShopPOS.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ShopPOS.UI.ViewModels"
        xmlns:vmProd="clr-namespace:ShopPOS.UI.ViewModels.Products"
        xmlns:vmCat="clr-namespace:ShopPOS.UI.ViewModels.Categories"
        xmlns:vmBrand="clr-namespace:ShopPOS.UI.ViewModels.Brands"
        xmlns:vmUnit="clr-namespace:ShopPOS.UI.ViewModels.Units"
        xmlns:vmSupp="clr-namespace:ShopPOS.UI.ViewModels.Suppliers"
        xmlns:vmPurch="clr-namespace:ShopPOS.UI.ViewModels.Purchases"
        xmlns:vmPay="clr-namespace:ShopPOS.UI.ViewModels.SupplierPayments"
        xmlns:vmRet="clr-namespace:ShopPOS.UI.ViewModels.PurchaseReturns"
        xmlns:vmLedger="clr-namespace:ShopPOS.UI.ViewModels.SupplierLedger"
        xmlns:vmSet="clr-namespace:ShopPOS.UI.ViewModels.Settings"
        xmlns:vmInv="clr-namespace:ShopPOS.UI.ViewModels.Inventory"
        xmlns:vmDash="clr-namespace:ShopPOS.UI.ViewModels.Dashboard"
        xmlns:vmSales="clr-namespace:ShopPOS.UI.ViewModels.Sales"
        xmlns:vmRep="clr-namespace:ShopPOS.UI.ViewModels.Reports"
        xmlns:views="clr-namespace:ShopPOS.UI.Views"
        xmlns:vmBackup="clr-namespace:ShopPOS.UI.ViewModels.BackupRestore"
        mc:Ignorable="d"
        Title="ShopPOS"
        Height="768"
        Width="1366"
        MinHeight="720"
        MinWidth="1280"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vmDash:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
            <views:PlaceholderView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProd:ProductsViewModel}">
            <views:ProductsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmCat:CategoriesViewModel}">
            <views:CategoriesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmBrand:BrandsViewModel}">
            <views:BrandsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmUnit:UnitsViewModel}">
            <views:UnitsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSupp:SuppliersViewModel}">
            <views:SuppliersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmPurch:PurchasesViewModel}">
            <views:PurchasesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmPay:SupplierPaymentsViewModel}">
            <views:SupplierPaymentsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmRet:PurchaseReturnsViewModel}">
            <views:PurchaseReturnsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmLedger:SupplierLedgerViewModel}">
            <views:SupplierLedgerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSet:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmInv:StockOverviewViewModel}">
            <views:StockOverviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmInv:StockMovementHistoryViewModel}">
            <views:StockMovementHistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmInv:StockAdjustmentsViewModel}">
            <views:StockAdjustmentsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmInv:ReorderListViewModel}">
            <views:ReorderListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmInv:StockValuationViewModel}">
            <views:StockValuationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSales:PosSaleViewModel}">
            <views:PosSaleView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSales:SalesViewModel}">
            <views:SalesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSales:SaleReturnsViewModel}">
            <views:SaleReturnsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmRep:ReportsViewModel}">
            <views:ReportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmBackup:BackupRestoreViewModel}">
            <views:BackupRestoreView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
                <!-- Left Navigation Sidebar -->
                <ColumnDefinition Width="230" />
                <!-- Content Area -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource SidebarBorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Top Brand / Shop Name -->
                        <RowDefinition Height="Auto" />
                        <!-- Grouped Nav Items (Scrollable) -->
                        <RowDefinition Height="*" />
                        <!-- WAL Status Footer -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top Brand Header -->
                    <Border Grid.Row="0"
                            Padding="16,14"
                            BorderBrush="{DynamicResource SidebarBorderBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="{Binding ShopName}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="POS TERMINAL"
                                       FontFamily="{StaticResource AppMonospaceFontFamily}"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SidebarHeaderBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Scrollable Sidebar Groups -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding NavigationGroups}" Margin="0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:NavigationGroup}">
                                    <StackPanel Margin="0,4,0,8">
                                        <!-- Group Header (Small Uppercase Letter-Spaced) -->
                                        <TextBlock Text="{Binding Header}"
                                                   FontFamily="{StaticResource AppMonospaceFontFamily}"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource SidebarHeaderBrush}"
                                                   Margin="16,6,16,4" />

                                        <!-- Group Items -->
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:NavigationItem}">
                                                    <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            HorizontalContentAlignment="Stretch"
                                                            Height="34"
                                                            Margin="8,1"
                                                            Cursor="Hand">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Setter Property="BorderThickness" Value="0" />
                                                                <Setter Property="Padding" Value="10,0" />
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="ItemBorder"
                                                                                    CornerRadius="4"
                                                                                    Background="{TemplateBinding Background}"
                                                                                    Padding="{TemplateBinding Padding}">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                    </Grid.ColumnDefinitions>

                                                                                    <!-- Nav Item Title -->
                                                                                    <TextBlock x:Name="TitleText"
                                                                                               Grid.Column="0"
                                                                                               Text="{Binding Title}"
                                                                                               FontSize="12"
                                                                                               FontWeight="Medium"
                                                                                               Foreground="{DynamicResource SidebarTextBrush}"
                                                                                               VerticalAlignment="Center" />

                                                                                    <!-- Right-Aligned Shortcut Badge (e.g. F2 on Sales POS) -->
                                                                                    <Border x:Name="ShortcutBadge"
                                                                                            Grid.Column="1"
                                                                                            Background="{DynamicResource SecondaryBackgroundBrush}"
                                                                                            BorderBrush="{DynamicResource SecondaryBorderBrush}"
                                                                                            BorderThickness="1"
                                                                                            CornerRadius="3"
                                                                                            Padding="4,1"
                                                                                            VerticalAlignment="Center"
                                                                                            Visibility="{Binding Shortcut, Converter={StaticResource StringToVisibilityConverter}}">
                                                                                        <TextBlock Text="{Binding Shortcut}"
                                                                                                   FontFamily="{StaticResource AppMonospaceFontFamily}"
                                                                                                   FontSize="9"
                                                                                                   FontWeight="Bold"
                                                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                                    </Border>
                                                                                </Grid>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                                                                                    <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource SidebarTextActiveBrush}" />
                                                                                </Trigger>
                                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SidebarActiveBrush}" />
                                                                                    <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource SidebarTextActiveBrush}" />
                                                                                    <Setter TargetName="TitleText" Property="FontWeight" Value="SemiBold" />
                                                                                </DataTrigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Bottom Status Footer -->
                    <Border Grid.Row="2"
                            Background="Transparent"
                            Padding="16,12"
                            BorderBrush="{DynamicResource SidebarBorderBrush}"
                            BorderThickness="0,1,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="SQLite WAL connected"
                                           FontFamily="{StaticResource AppMonospaceFontFamily}"
                                           FontSize="10"
                                           Foreground="{DynamicResource SidebarTextBrush}" />
                            </StackPanel>
                            <TextBlock Text="Local offline engine"
                                       FontSize="10"
                                       Foreground="{DynamicResource SidebarHeaderBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <ContentControl Grid.Column="1"
                            Content="{Binding CurrentView}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Margin="16" />
    </Grid>
</Window>